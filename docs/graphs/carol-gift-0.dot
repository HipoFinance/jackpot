digraph {
  graph [ rankdir=TB nodesep=0.5 ranksep=0.55 pad="0.3,0.1" bgcolor=transparent fontname="Arial" ]
  node [ shape=box style="rounded,filled" fontname="Arial" fontsize=13 margin="0.14,0.08" ]
  edge [ fontname="Arial" fontsize=11 arrowsize=0.7 ]
  "carol" [ label="Carol" class="n-person" ]
  "carolHgram" [ label="Carol's\nhGRAM wallet" class="n-hgram" ]
  "jackpotHgram" [ label="Jackpot's\nhGRAM wallet" class="n-hgram" ]
  "jackpot" [ label="Jackpot" class="n-jackpot" ]
  "daveJgram" [ label="Dave's\njGRAM wallet" class="n-jgram" ]
  "node4" [ label="node level 4" class="n-node" ]
  "node3" [ label="node level 3" class="n-node" ]
  "dave" [ label="Dave" class="n-person" ]
  "node2" [ label="node level 2" class="n-node" ]
  "node1" [ label="node level 1" class="n-node" ]
  "carol" -> "carolHgram" [ label="1\lop::send_tokens\ltokens: 30,000\lto: Jackpot\ldeposit_options\l" class="e-token" ]
  "carolHgram" -> "jackpotHgram" [ label="2\lop::receive_tokens\ltokens: 30,000\l" class="e-token" ]
  "jackpotHgram" -> "jackpot" [ label="3\lop::transfer_notification\ltokens: 30,000\lsender: Carol\ldeposit_options\l" class="e-token" ]
  "jackpotHgram" -> "carol" [ label="4\lop::gas_excess\l" class="e-gas" ]
  "jackpot" -> "daveJgram" [ label="5\lop::prepare_deposit\ltokens: 30,000\lfor: Dave\lmin_principal: 29,859.254\lwith StateInit: deploys the wallet\l" class="e-msg" ]
  "daveJgram" -> "jackpot" [ label="6\lop::deposit_ready\lposition: none yet\l" class="e-msg" ]
  "jackpot" -> "node4" [ label="7\lop::update\lposition 2: +30,000\ltag 0\l" class="e-msg" ]
  "jackpot" -> "daveJgram" [ label="8\lop::deposit_booked\ljGRAM: 30,000\lposition: 2\l" class="e-msg" ]
  "node4" -> "node3" [ label="9\lop::update\lposition 2: +30,000\ltag 0\l" class="e-msg" ]
  "daveJgram" -> "dave" [ label="10\lop::transfer_notification\ltokens: 30,000\lsender: Carol\lcomment 'A gift from Carol'\l" class="e-token" ]
  "daveJgram" -> "carol" [ label="11\lop::gas_excess\l" class="e-gas" ]
  "node3" -> "node2" [ label="12\lop::update\lposition 2: +30,000\ltag 0\l" class="e-msg" ]
  "node2" -> "node1" [ label="13\lop::update\lposition 2: +30,000\ltag 0\l" class="e-msg" ]
  "node1" -> "dave" [ label="14\lop::gas_excess\l" class="e-gas" ]
}