digraph {
  graph [ rankdir=TB nodesep=0.5 ranksep=0.55 pad="0.3,0.1" bgcolor=transparent fontname="Arial" ]
  node [ shape=box style="rounded,filled" fontname="Arial" fontsize=13 margin="0.14,0.08" ]
  edge [ fontname="Arial" fontsize=11 arrowsize=0.7 ]
  "bob" [ label="Bob" class="n-person" ]
  "bobHgram" [ label="Bob's\nhGRAM wallet" class="n-hgram" ]
  "jackpotHgram" [ label="Jackpot's\nhGRAM wallet" class="n-hgram" ]
  "jackpot" [ label="Jackpot" class="n-jackpot" ]
  "bobJgram" [ label="Bob's\njGRAM wallet" class="n-jgram" ]
  "node4" [ label="node level 4" class="n-node" ]
  "node3" [ label="node level 3" class="n-node" ]
  "node2" [ label="node level 2" class="n-node" ]
  "node1" [ label="node level 1" class="n-node" ]
  "bob" -> "bobHgram" [ label="1\lop::send_tokens\ltokens: 50,000\lto: Jackpot\l" class="e-token" ]
  "bobHgram" -> "jackpotHgram" [ label="2\lop::receive_tokens\ltokens: 50,000\l" class="e-token" ]
  "jackpotHgram" -> "jackpot" [ label="3\lop::transfer_notification\ltokens: 50,000\lsender: Bob\l" class="e-token" ]
  "jackpotHgram" -> "bob" [ label="4\lop::gas_excess\l" class="e-gas" ]
  "jackpot" -> "bobJgram" [ label="5\lop::prepare_deposit\ltokens: 50,000\lwith StateInit: deploys the wallet\l" class="e-msg" ]
  "bobJgram" -> "jackpot" [ label="6\lop::deposit_ready\lposition: none yet\l" class="e-msg" ]
  "jackpot" -> "node4" [ label="7\lop::update\lposition 1: +50,000\ltag 0\l" class="e-msg" ]
  "jackpot" -> "bobJgram" [ label="8\lop::deposit_booked\ljGRAM: 50,000\lposition: 1\l" class="e-msg" ]
  "node4" -> "node3" [ label="9\lop::update\lposition 1: +50,000\ltag 0\l" class="e-msg" ]
  "bobJgram" -> "bob" [ label="10\lop::gas_excess\l" class="e-gas" ]
  "node3" -> "node2" [ label="11\lop::update\lposition 1: +50,000\ltag 0\l" class="e-msg" ]
  "node2" -> "node1" [ label="12\lop::update\lposition 1: +50,000\ltag 0\l" class="e-msg" ]
  "node1" -> "bob" [ label="13\lop::gas_excess\l" class="e-gas" ]
}