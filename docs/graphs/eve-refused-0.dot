digraph {
  graph [ rankdir=TB nodesep=0.5 ranksep=0.55 pad="0.3,0.1" bgcolor=transparent fontname="Arial" ]
  node [ shape=box style="rounded,filled" fontname="Arial" fontsize=13 margin="0.14,0.08" ]
  edge [ fontname="Arial" fontsize=11 arrowsize=0.7 ]
  "eve" [ label="Eve" class="n-person" ]
  "eveHgram" [ label="Eve's\nhGRAM wallet" class="n-hgram" ]
  "jackpotHgram" [ label="Jackpot's\nhGRAM wallet" class="n-hgram" ]
  "jackpot" [ label="Jackpot" class="n-jackpot" ]
  "eveJgram" [ label="Eve's\njGRAM wallet" class="n-jgram" ]
  "eve" -> "eveHgram" [ label="1\lop::send_tokens\ltokens: 1,000\lto: Jackpot\ldeposit_options\l" class="e-token" ]
  "eveHgram" -> "jackpotHgram" [ label="2\lop::receive_tokens\ltokens: 1,000\l" class="e-token" ]
  "jackpotHgram" -> "jackpot" [ label="3\lop::transfer_notification\ltokens: 1,000\lsender: Eve\ldeposit_options\l" class="e-token" ]
  "jackpotHgram" -> "eve" [ label="4\lop::gas_excess\l" class="e-gas" ]
  "jackpot" -> "eveJgram" [ label="5\lop::prepare_deposit\ltokens: 1,000\lmin_principal: 999,999\lwith StateInit: deploys the wallet\l" class="e-msg" ]
  "eveJgram" -> "jackpot" [ label="6\lop::deposit_ready\lposition: none yet\l" class="e-msg" ]
  "jackpot" -> "eveJgram" [ label="7\lop::deposit_cancelled\lthe wallet deletes itself\l" class="e-msg" ]
  "jackpot" -> "jackpotHgram" [ label="8\lop::send_tokens\ltokens: 1,000\lto: Eve\ldeposit_refused, reason 5 (price)\l" class="e-token" ]
  "eveJgram" -> "eve" [ label="9\lop::gas_excess\l" class="e-gas" ]
  "jackpotHgram" -> "eveHgram" [ label="10\lop::receive_tokens\ltokens: 1,000\l" class="e-token" ]
  "eveHgram" -> "eve" [ label="11\lop::transfer_notification\ltokens: 1,000\lsender: Jackpot\ldeposit_refused, reason 5 (price)\l" class="e-token" ]
  "eveHgram" -> "eve" [ label="12\lop::gas_excess\l" class="e-gas" ]
}