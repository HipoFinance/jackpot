digraph {
  graph [ rankdir=TB nodesep=0.5 ranksep=0.55 pad="0.3,0.1" bgcolor=transparent fontname="Arial" ]
  node [ shape=box style="rounded,filled" fontname="Arial" fontsize=13 margin="0.14,0.08" ]
  edge [ fontname="Arial" fontsize=11 arrowsize=0.7 ]
  "governor" [ label="governor" class="n-person" ]
  "jackpot" [ label="Jackpot" class="n-jackpot" ]
  "jackpotHgram" [ label="Jackpot's\nhGRAM wallet" class="n-hgram" ]
  "burnerHgram" [ label="HPO burner's\nhGRAM wallet" class="n-hgram" ]
  "burner" [ label="HPO burner" class="n-hipo" ]
  "governor" -> "jackpot" [ label="1\lop::sweep\l" class="e-msg" ]
  "jackpot" -> "jackpotHgram" [ label="2\lop::send_tokens\ltokens: 14.866\lto: HPO burner\l" class="e-token" ]
  "jackpot" -> "governor" [ label="4\lop::gas_excess\l" class="e-gas" ]
  "jackpotHgram" -> "burnerHgram" [ label="5\lop::receive_tokens\ltokens: 14.866\l" class="e-token" ]
  "burnerHgram" -> "burner" [ label="8\lop::transfer_notification\ltokens: 14.866\lsender: Jackpot\l" class="e-token" ]
  "burnerHgram" -> "jackpot" [ label="9\lop::gas_excess\l" class="e-gas" ]
}