digraph {
  graph [ rankdir=TB nodesep=0.5 ranksep=0.55 pad="0.3,0.1" bgcolor=transparent fontname="Arial" ]
  node [ shape=box style="rounded,filled" fontname="Arial" fontsize=13 margin="0.14,0.08" ]
  edge [ fontname="Arial" fontsize=11 arrowsize=0.7 ]
  "alice" [ label="Alice" class="n-person" ]
  "jackpot" [ label="Jackpot" class="n-jackpot" ]
  "aliceJgram" [ label="Alice's\njGRAM wallet" class="n-jgram" ]
  "node4" [ label="node level 4" class="n-node" ]
  "jackpotHgram" [ label="Jackpot's\nhGRAM wallet" class="n-hgram" ]
  "node3" [ label="node level 3" class="n-node" ]
  "aliceHgram" [ label="Alice's\nhGRAM wallet" class="n-hgram" ]
  "node2" [ label="node level 2" class="n-node" ]
  "node1" [ label="node level 1" class="n-node" ]
  "alice" -> "jackpot" [ label="1\ltext comment\ltext: 'w'\l" class="e-msg" ]
  "jackpot" -> "aliceJgram" [ label="2\lop::burn\lamount: 0 = everything\lcomment 'Hipo Jackpot withdrawal'\l" class="e-msg" ]
  "aliceJgram" -> "jackpot" [ label="3\lop::burn_notification\lprincipal: 100,000\lposition 0, last: true\l" class="e-msg" ]
  "jackpot" -> "node4" [ label="4\lop::update\lposition 0: −100,000\ltag 1\l" class="e-msg" ]
  "jackpot" -> "aliceJgram" [ label="5\lop::close_wallet\lthe wallet deletes itself\l" class="e-msg" ]
  "jackpot" -> "jackpotHgram" [ label="6\lop::send_tokens\ltokens: 99,938.029\lto: Alice\lcomment 'Hipo Jackpot withdrawal'\l" class="e-token" ]
  "node4" -> "node3" [ label="7\lop::update\lposition 0: −100,000\ltag 1\l" class="e-msg" ]
  "aliceJgram" -> "alice" [ label="8\lop::gas_excess\l" class="e-gas" ]
  "jackpotHgram" -> "aliceHgram" [ label="9\lop::receive_tokens\ltokens: 99,938.029\l" class="e-token" ]
  "node3" -> "node2" [ label="10\lop::update\lposition 0: −100,000\ltag 1\l" class="e-msg" ]
  "aliceHgram" -> "alice" [ label="11\lop::transfer_notification\ltokens: 99,938.029\lsender: Jackpot\lcomment 'Hipo Jackpot withdrawal'\l" class="e-token" ]
  "aliceHgram" -> "alice" [ label="12\lop::gas_excess\l" class="e-gas" ]
  "node2" -> "node1" [ label="13\lop::update\lposition 0: −100,000\ltag 1\l" class="e-msg" ]
  "node1" -> "alice" [ label="14\lop::gas_excess\l" class="e-gas" ]
}