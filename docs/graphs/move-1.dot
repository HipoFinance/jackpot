digraph {
  graph [ rankdir=TB nodesep=0.5 ranksep=0.55 pad="0.3,0.1" bgcolor=transparent fontname="Arial" ]
  node [ shape=box style="rounded,filled" fontname="Arial" fontsize=13 margin="0.14,0.08" ]
  edge [ fontname="Arial" fontsize=11 arrowsize=0.7 ]
  "successor" [ label="new Jackpot\n(successor)" class="n-jackpot" ]
  "daveJgram2" [ label="Dave's jGRAM wallet\nin the new Jackpot" class="n-jgram" ]
  "snode4" [ label="new Jackpot\nnode level 4" class="n-node" ]
  "snode3" [ label="new Jackpot\nnode level 3" class="n-node" ]
  "dave" [ label="Dave" class="n-person" ]
  "snode2" [ label="new Jackpot\nnode level 2" class="n-node" ]
  "snode1" [ label="new Jackpot\nnode level 1" class="n-node" ]
  "successor" -> "daveJgram2" [ label="15\lop::prepare_deposit\ltokens: 29,972.117\lfor: Dave\lmin_principal: 29,700\lwith StateInit: deploys the wallet\l" class="e-msg" ]
  "daveJgram2" -> "successor" [ label="17\lop::deposit_ready\lposition: none yet\l" class="e-msg" ]
  "successor" -> "snode4" [ label="18\lop::update\lposition 0: +30,000\ltag 0\ldeploys the node\l" class="e-msg" ]
  "successor" -> "daveJgram2" [ label="19\lop::deposit_booked\ljGRAM: 30,000\lposition: 0\l" class="e-msg" ]
  "snode4" -> "snode3" [ label="20\lop::update\lposition 0: +30,000\ltag 0\ldeploys the node\l" class="e-msg" ]
  "daveJgram2" -> "dave" [ label="21\lop::transfer_notification\ltokens: 30,000\lsender: Jackpot\lcomment 'Hipo Jackpot: moved'\l" class="e-token" ]
  "daveJgram2" -> "dave" [ label="22\lop::gas_excess\l" class="e-gas" ]
  "snode3" -> "snode2" [ label="23\lop::update\lposition 0: +30,000\ltag 0\ldeploys the node\l" class="e-msg" ]
  "snode2" -> "snode1" [ label="24\lop::update\lposition 0: +30,000\ltag 0\ldeploys the node\l" class="e-msg" ]
  "snode1" -> "dave" [ label="25\lop::gas_excess\l" class="e-gas" ]
}