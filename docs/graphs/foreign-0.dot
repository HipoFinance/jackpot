digraph {
  graph [ rankdir=TB nodesep=0.5 ranksep=0.55 pad="0.3,0.1" bgcolor=transparent fontname="Arial" ]
  node [ shape=box style="rounded,filled" fontname="Arial" fontsize=13 margin="0.14,0.08" ]
  edge [ fontname="Arial" fontsize=11 arrowsize=0.7 ]
  "frank" [ label="Frank" class="n-person" ]
  "frankXyz" [ label="Frank's XYZ\njetton wallet" class="n-foreign" ]
  "jackpotXyz" [ label="Jackpot's XYZ\njetton wallet" class="n-foreign" ]
  "jackpot" [ label="Jackpot" class="n-jackpot" ]
  "frank" -> "frankXyz" [ label="1\lop::send_tokens\ltokens: 25\lto: Jackpot\l" class="e-token" ]
  "frankXyz" -> "jackpotXyz" [ label="2\lop::receive_tokens\ltokens: 25\l" class="e-token" ]
  "jackpotXyz" -> "jackpot" [ label="3\lop::transfer_notification\ltokens: 25\lsender: Frank\l" class="e-token" ]
  "jackpotXyz" -> "frank" [ label="4\lop::gas_excess\l" class="e-gas" ]
  "jackpot" -> "jackpotXyz" [ label="5\lop::send_tokens\ltokens: 25\lto: Frank\lcomment 'Hipo Jackpot: this token is not accepted'\l" class="e-token" ]
  "jackpotXyz" -> "frankXyz" [ label="6\lop::receive_tokens\ltokens: 25\l" class="e-token" ]
  "frankXyz" -> "frank" [ label="7\lop::transfer_notification\ltokens: 25\lsender: Jackpot\lcomment 'Hipo Jackpot: this token is not accepted'\l" class="e-token" ]
  "frankXyz" -> "frank" [ label="8\lop::gas_excess\l" class="e-gas" ]
}