digraph {
  graph [ rankdir=TB nodesep=0.5 ranksep=0.55 pad="0.3,0.1" bgcolor=transparent fontname="Arial" ]
  node [ shape=box style="rounded,filled" fontname="Arial" fontsize=13 margin="0.14,0.08" ]
  edge [ fontname="Arial" fontsize=11 arrowsize=0.7 ]
  "alice" [ label="Alice" class="n-person" ]
  "aliceHgram" [ label="Alice's\nhGRAM wallet" class="n-hgram" ]
  "jackpotHgram" [ label="Jackpot's\nhGRAM wallet" class="n-hgram" ]
  "jackpot" [ label="Jackpot" class="n-jackpot" ]
  "aliceJgram" [ label="Alice's\njGRAM wallet" class="n-jgram" ]
  "node4" [ label="node level 4" class="n-node" ]
  "node3" [ label="node level 3" class="n-node" ]
  "node2" [ label="node level 2" class="n-node" ]
  "node1" [ label="node level 1" class="n-node" ]
  "alice" -> "aliceHgram" [ label="1\lop::send_tokens\ltokens: 100,000\lto: Jackpot\l" class="e-token" ]
  "aliceHgram" -> "jackpotHgram" [ label="2\lop::receive_tokens\ltokens: 100,000\l" class="e-token" ]
  "jackpotHgram" -> "jackpot" [ label="3\lop::transfer_notification\ltokens: 100,000\lsender: Alice\l" class="e-token" ]
  "jackpotHgram" -> "alice" [ label="4\lop::gas_excess\l" class="e-gas" ]
  "jackpot" -> "aliceJgram" [ label="5\lop::prepare_deposit\ltokens: 100,000\lwith StateInit: deploys the wallet\l" class="e-msg" ]
  "aliceJgram" -> "jackpot" [ label="6\lop::deposit_ready\lposition: none yet\l" class="e-msg" ]
  "jackpot" -> "node4" [ label="7\lop::update\lposition 0: +100,000\ltag 0\ldeploys the node\l" class="e-msg" ]
  "jackpot" -> "aliceJgram" [ label="8\lop::deposit_booked\ljGRAM: 100,000\lposition: 0\l" class="e-msg" ]
  "node4" -> "node3" [ label="9\lop::update\lposition 0: +100,000\ltag 0\ldeploys the node\l" class="e-msg" ]
  "aliceJgram" -> "alice" [ label="10\lop::gas_excess\l" class="e-gas" ]
  "node3" -> "node2" [ label="11\lop::update\lposition 0: +100,000\ltag 0\ldeploys the node\l" class="e-msg" ]
  "node2" -> "node1" [ label="12\lop::update\lposition 0: +100,000\ltag 0\ldeploys the node\l" class="e-msg" ]
  "node1" -> "alice" [ label="13\lop::gas_excess\l" class="e-gas" ]
}