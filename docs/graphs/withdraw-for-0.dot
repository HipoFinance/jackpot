digraph {
  graph [ rankdir=TB nodesep=0.5 ranksep=0.55 pad="0.3,0.1" bgcolor=transparent fontname="Arial" ]
  node [ shape=box style="rounded,filled" fontname="Arial" fontsize=13 margin="0.14,0.08" ]
  edge [ fontname="Arial" fontsize=11 arrowsize=0.7 ]
  "governor" [ label="governor" class="n-person" ]
  "jackpot" [ label="Jackpot" class="n-jackpot" ]
  "bobJgram" [ label="Bob's\njGRAM wallet" class="n-jgram" ]
  "node4" [ label="node level 4" class="n-node" ]
  "jackpotHgram" [ label="Jackpot's\nhGRAM wallet" class="n-hgram" ]
  "node3" [ label="node level 3" class="n-node" ]
  "bob" [ label="Bob" class="n-person" ]
  "bobHgram" [ label="Bob's\nhGRAM wallet" class="n-hgram" ]
  "node2" [ label="node level 2" class="n-node" ]
  "node1" [ label="node level 1" class="n-node" ]
  "governor" -> "jackpot" [ label="1\lop::withdraw_for\lto_successor: false\l" class="e-msg" ]
  "jackpot" -> "bobJgram" [ label="2\lop::burn\lamount: 0 = everything\lcomment 'Hipo Jackpot withdrawal'\l" class="e-msg" ]
  "jackpot" -> "governor" [ label="3\lop::gas_excess\l" class="e-gas" ]
  "bobJgram" -> "jackpot" [ label="4\lop::burn_notification\lprincipal: 30,000\lposition 1, last: true\l" class="e-msg" ]
  "jackpot" -> "node4" [ label="5\lop::update\lposition 1: −30,000\ltag 1\l" class="e-msg" ]
  "jackpot" -> "bobJgram" [ label="6\lop::close_wallet\lthe wallet deletes itself\l" class="e-msg" ]
  "jackpot" -> "jackpotHgram" [ label="7\lop::send_tokens\ltokens: 29,972.117\lto: Bob\lcomment 'Hipo Jackpot withdrawal'\l" class="e-token" ]
  "node4" -> "node3" [ label="8\lop::update\lposition 1: −30,000\ltag 1\l" class="e-msg" ]
  "bobJgram" -> "bob" [ label="9\lop::gas_excess\l" class="e-gas" ]
  "jackpotHgram" -> "bobHgram" [ label="10\lop::receive_tokens\ltokens: 29,972.117\l" class="e-token" ]
  "node3" -> "node2" [ label="11\lop::update\lposition 1: −30,000\ltag 1\l" class="e-msg" ]
  "bobHgram" -> "bob" [ label="12\lop::transfer_notification\ltokens: 29,972.117\lsender: Jackpot\lcomment 'Hipo Jackpot withdrawal'\l" class="e-token" ]
  "bobHgram" -> "bob" [ label="13\lop::gas_excess\l" class="e-gas" ]
  "node2" -> "node1" [ label="14\lop::update\lposition 1: −30,000\ltag 1\l" class="e-msg" ]
  "node1" -> "bob" [ label="15\lop::gas_excess\l" class="e-gas" ]
}