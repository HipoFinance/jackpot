digraph {
  graph [ rankdir=TB nodesep=0.5 ranksep=0.55 pad="0.3,0.1" bgcolor=transparent fontname="Arial" ]
  node [ shape=box style="rounded,filled" fontname="Arial" fontsize=13 margin="0.14,0.08" ]
  edge [ fontname="Arial" fontsize=11 arrowsize=0.7 ]
  "governor" [ label="governor" class="n-person" ]
  "jackpot" [ label="Jackpot" class="n-jackpot" ]
  "daveJgram" [ label="Dave's\njGRAM wallet" class="n-jgram" ]
  "node4" [ label="node level 4" class="n-node" ]
  "jackpotHgram" [ label="Jackpot's\nhGRAM wallet" class="n-hgram" ]
  "node3" [ label="node level 3" class="n-node" ]
  "dave" [ label="Dave" class="n-person" ]
  "successorHgram" [ label="new Jackpot's\nhGRAM wallet" class="n-hgram" ]
  "node2" [ label="node level 2" class="n-node" ]
  "successor" [ label="new Jackpot\n(successor)" class="n-jackpot" ]
  "node1" [ label="node level 1" class="n-node" ]
  "governor" -> "jackpot" [ label="1\lop::withdraw_for\lto_successor: true\l" class="e-msg" ]
  "jackpot" -> "daveJgram" [ label="2\lop::burn\lamount: 0 = everything\lto_successor: true\lcomment 'Hipo Jackpot: moved'\l" class="e-msg" ]
  "jackpot" -> "governor" [ label="3\lop::gas_excess\l" class="e-gas" ]
  "daveJgram" -> "jackpot" [ label="4\lop::burn_notification\lprincipal: 30,000\lposition 2, last: true\l" class="e-msg" ]
  "jackpot" -> "node4" [ label="5\lop::update\lposition 2: −30,000\ltag 1\l" class="e-msg" ]
  "jackpot" -> "daveJgram" [ label="6\lop::close_wallet\lthe wallet deletes itself\l" class="e-msg" ]
  "jackpot" -> "jackpotHgram" [ label="7\lop::send_tokens\ltokens: 29,972.117\lto: new Jackpot (successor)\ldeposit_options\l" class="e-token" ]
  "node4" -> "node3" [ label="8\lop::update\lposition 2: −30,000\ltag 1\l" class="e-msg" ]
  "daveJgram" -> "dave" [ label="9\lop::gas_excess\l" class="e-gas" ]
  "jackpotHgram" -> "successorHgram" [ label="10\lop::receive_tokens\ltokens: 29,972.117\l" class="e-token" ]
  "node3" -> "node2" [ label="11\lop::update\lposition 2: −30,000\ltag 1\l" class="e-msg" ]
  "successorHgram" -> "successor" [ label="12\lop::transfer_notification\ltokens: 29,972.117\lsender: Jackpot\ldeposit_options\l" class="e-token" ]
  "successorHgram" -> "dave" [ label="13\lop::gas_excess\l" class="e-gas" ]
  "node2" -> "node1" [ label="14\lop::update\lposition 2: −30,000\ltag 1\l" class="e-msg" ]
  "node1" -> "dave" [ label="16\lop::gas_excess\l" class="e-gas" ]
}