digraph {
  graph [ rankdir=TB nodesep=0.5 ranksep=0.55 pad="0.3,0.1" bgcolor=transparent fontname="Arial" ]
  node [ shape=box style="rounded,filled" fontname="Arial" fontsize=13 margin="0.14,0.08" ]
  edge [ fontname="Arial" fontsize=11 arrowsize=0.7 ]
  "node1" [ label="node level 1" class="n-node" ]
  "jackpot" [ label="Jackpot" class="n-jackpot" ]
  "jackpotHgram" [ label="Jackpot's\nhGRAM wallet" class="n-hgram" ]
  "bobHgram" [ label="Bob's\nhGRAM wallet" class="n-hgram" ]
  "aliceHgram" [ label="Alice's\nhGRAM wallet" class="n-hgram" ]
  "burnerHgram" [ label="HPO burner's\nhGRAM wallet" class="n-hgram" ]
  "bob" [ label="Bob" class="n-person" ]
  "alice" [ label="Alice" class="n-person" ]
  "burner" [ label="HPO burner" class="n-hipo" ]
  "node1" -> "jackpot" [ label="15, 16, 17\lop::hit\lprize 1, try 1; position 1 (Bob)\lprize 2, try 1; position 0 (Alice)\lprize 3, try 1; position 1 (Bob)\l" class="e-msg" ]
  "jackpot" -> "jackpotHgram" [ label="18, 20\lop::send_tokens\ltokens: 46.824; to: Bob; comment 'Hipo Jackpot prize: draw 1, 1st'\ltokens: 18.729; to: Bob; comment 'Hipo Jackpot prize: draw 1, 3rd'\l" class="e-token" ]
  "jackpot" -> "jackpotHgram" [ label="19\lop::send_tokens\ltokens: 28.094\lto: Alice\lcomment 'Hipo Jackpot prize: draw 1, 2nd'\l" class="e-token" ]
  "jackpot" -> "jackpotHgram" [ label="21\lop::send_tokens\ltokens: 10.405\lto: HPO burner\l" class="e-token" ]
  "jackpotHgram" -> "bobHgram" [ label="22, 24\lop::receive_tokens\ltokens: 46.824\ltokens: 18.729\l" class="e-token" ]
  "jackpotHgram" -> "aliceHgram" [ label="23\lop::receive_tokens\ltokens: 28.094\l" class="e-token" ]
  "jackpotHgram" -> "burnerHgram" [ label="25\lop::receive_tokens\ltokens: 10.405\l" class="e-token" ]
  "bobHgram" -> "bob" [ label="26, 30\lop::transfer_notification\ltokens: 46.824; sender: Jackpot; comment 'Hipo Jackpot prize: draw 1, 1st'\ltokens: 18.729; sender: Jackpot; comment 'Hipo Jackpot prize: draw 1, 3rd'\l" class="e-token" ]
  "bobHgram" -> "jackpot" [ label="27, 31\lop::gas_excess\l" class="e-gas" ]
  "aliceHgram" -> "alice" [ label="28\lop::transfer_notification\ltokens: 28.094\lsender: Jackpot\lcomment 'Hipo Jackpot prize: draw 1, 2nd'\l" class="e-token" ]
  "aliceHgram" -> "jackpot" [ label="29\lop::gas_excess\l" class="e-gas" ]
  "burnerHgram" -> "burner" [ label="32\lop::transfer_notification\ltokens: 10.405\lsender: Jackpot\l" class="e-token" ]
  "burnerHgram" -> "jackpot" [ label="33\lop::gas_excess\l" class="e-gas" ]
}