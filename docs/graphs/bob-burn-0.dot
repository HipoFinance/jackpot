digraph {
  graph [ rankdir=TB nodesep=0.5 ranksep=0.55 pad="0.3,0.1" bgcolor=transparent fontname="Arial" ]
  node [ shape=box style="rounded,filled" fontname="Arial" fontsize=13 margin="0.14,0.08" ]
  edge [ fontname="Arial" fontsize=11 arrowsize=0.7 ]
  "bob" [ label="Bob" class="n-person" ]
  "bobJgram" [ label="Bob's\njGRAM wallet" class="n-jgram" ]
  "jackpot" [ label="Jackpot" class="n-jackpot" ]
  "node4" [ label="node level 4" class="n-node" ]
  "jackpotHgram" [ label="Jackpot's\nhGRAM wallet" class="n-hgram" ]
  "node3" [ label="node level 3" class="n-node" ]
  "bobHgram" [ label="Bob's\nhGRAM wallet" class="n-hgram" ]
  "node2" [ label="node level 2" class="n-node" ]
  "node1" [ label="node level 1" class="n-node" ]
  "bob" -> "bobJgram" [ label="1\lop::burn\lamount: 20,000\lcomment 'Savings app: order 17'\l" class="e-msg" ]
  "bobJgram" -> "jackpot" [ label="2\lop::burn_notification\lprincipal: 20,000\lposition 1, last: false\l" class="e-msg" ]
  "jackpot" -> "node4" [ label="3\lop::update\lposition 1: −20,000\ltag 1\l" class="e-msg" ]
  "jackpot" -> "jackpotHgram" [ label="4\lop::send_tokens\ltokens: 19,987.606\lto: Bob\lcomment 'Savings app: order 17'\l" class="e-token" ]
  "node4" -> "node3" [ label="5\lop::update\lposition 1: −20,000\ltag 1\l" class="e-msg" ]
  "jackpotHgram" -> "bobHgram" [ label="6\lop::receive_tokens\ltokens: 19,987.606\l" class="e-token" ]
  "node3" -> "node2" [ label="7\lop::update\lposition 1: −20,000\ltag 1\l" class="e-msg" ]
  "bobHgram" -> "bob" [ label="8\lop::transfer_notification\ltokens: 19,987.606\lsender: Jackpot\lcomment 'Savings app: order 17'\l" class="e-token" ]
  "bobHgram" -> "bob" [ label="9\lop::gas_excess\l" class="e-gas" ]
  "node2" -> "node1" [ label="10\lop::update\lposition 1: −20,000\ltag 1\l" class="e-msg" ]
  "node1" -> "bob" [ label="11\lop::gas_excess\l" class="e-gas" ]
}