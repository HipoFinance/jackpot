;; Draw states. No quoting state: the pot is fixed at the boundary.
const int draw::none = 0;
const int draw::waiting = 1;
const int draw::resolving = 2;

;; Why a deposit was refused.
const int reason::halted = 1;
const int reason::retired = 2;
const int reason::rate_falling = 3;
const int reason::below_min_deposit = 4;
const int reason::price = 5;
const int reason::wallet_busy = 6;
const int reason::tree_full = 7;
const int reason::bad_options = 8;
const int reason::low_value = 9;
const int reason::wallet_unavailable = 10;

;; The cause in an untracked log.
const int untracked::refund_unpaid = 1;

;; Outcome of a slot, in the slot log.
const int slot::hit = 0;
const int slot::miss = 1;
const int slot::rolled_over = 2;
const int slot::expired = 3; ;; rolled over at a boundary with the search still out
const int slot::returned = 4; ;; a hit while the rate has fallen: the prize went back into F
const int slot::lost = 5; ;; a node found no child covering the position: treated as a miss


;; Protocol constants from the spec. Changing any of them is a code upgrade.
const int attempts_per_slot = 16; ;; A
const int drand_delay = 60; ;; D, seconds from a boundary to the drand round it waits for
const int submit_cutoff = 1800; ;; S, seconds before the earliest next boundary after which no submit is taken
const int unstake_guard = 604800; ;; 7 days: after this a stale unstaking counter no longer blocks an unstake
const int basis_points = 10000;
const int max_burn_share = 2000;
const int min_rise_min = 1;
const int max_rise_min = 10000;
const int min_min_gap = 3600;
const int max_min_gap = 2592000;
const int ppm = 1000000;
const int max_payload_cells = 8;
const int max_withdraw_for = 100;
const int share::first = 5000;
const int share::second = 3000;
;; A partial withdrawal must take at least this much principal, so that the hGRAM paid for it is never 0.
const int min_partial_withdrawal = 1000000000; ;; 1 GRAM

;; The tree: 4 levels of 64-ary nodes, room for 64^4 positions.
const int tree::levels = 4;
const int tree::bits = 6; ;; log2 of the arity
const int tree::capacity = 16777216; ;; 64^4

;; The storage layout this code reads and writes. 0 is the deploy data, checked once on the first message.
const int storage_version = 1;


;; The float: the Jackpot's own GRAM, which pays draws and node openings.
const int float::low = 8000000000; ;; float_low
const int float::high = 15000000000; ;; float_high
;; Reward of a successful submit.
const int reward::submit = 20000000; ;; 0.02 GRAM
;; What the Jackpot keeps after the end.
const int float::after_end = 1000000000;


;; Fees. Every entry message must carry at least its fee, checked before anything changes, and the fee
;; covers every message the step causes, so nothing an outsider starts is paid from the Jackpot's own
;; GRAM. What a user chain does not spend goes back to the user.
;;
;; The figures are fixed rather than read from config, sized at 400 nano-GRAM per gas, the worst case
;; (mainnet config 21 reads 66.67 nano-GRAM per gas). The gas behind them is measured in tests/Gas.spec.ts.

;; The quote round trip of a poke: the treasury's gas and the reply's.
const int fee::quote = 30000000; ;; 0.03 GRAM

;; Attached to each outgoing hGRAM transfer: Hipo's send_tokens_fee() plus the recipient wallet's
;; storage and gas. The recipient wallet sends the rest back as gas_excess.
const int fee::payout = 50000000; ;; 0.05 GRAM

;; Carried to the burner with each burn transfer, as forward_ton_amount.
const int fee::burn_forward = 500000000; ;; 0.5 GRAM

;; A prize's forward_ton_amount: enough for a receiving contract to parse the notification.
const int fee::prize_notify = 10000000; ;; 0.01 GRAM

;; Gas of one Jackpot or wallet handler, with room: 50,000 gas at 400 nano-GRAM per gas.
const int fee::handler = 20000000; ;; 0.02 GRAM

;; Storage reserve a jGRAM wallet keeps.
const int fee::wallet_storage = 26000000; ;; 0.026 GRAM: the built wallet is 23 cells and 12,373 bits, 13.4+ years at today's prices and 2.2+ at the old ones

;; The forwarding fee of the wallet's StateInit, which every prepare_deposit carries.
const int fee::wallet_deploy_forward = 8000000; ;; 0.008 GRAM: the StateInit is 23 cells and 12,373 bits, 6.3M at 400 nano-GRAM per bit

;; The tree. Every node message carries the remaining value of the one before it (mode 64).
const int fee::node_hop = 35000000; ;; 0.035 GRAM: 87,500 gas

;; Storage reserve a new node keeps from its first update.
const int fee::node_storage = 150000000; ;; 0.15 GRAM

;; The forwarding fee of a new node's StateInit, paid from the update that deploys it.
const int fee::node_deploy_forward = 20000000; ;; 0.02 GRAM

;; What opening a node costs its opener: the reserve and the StateInit's forwarding.
const int fee::node_open = fee::node_storage + fee::node_deploy_forward;

;; An update of one position's tickets, down the 4 levels and on to the owner.
const int fee::update = tree::levels * fee::node_hop;

;; A new position's share of the nodes it may open.
const int fee::node_share = fee::node_open / 64 + fee::node_open / 4096 + fee::node_open / 262144 + 3;

;; One search of the draw, from the float.
const int fee::search = tree::levels * fee::node_hop + fee::handler;

;; A message to a wallet that needs only its gas: deposit_cancelled, close_wallet.
const int fee::release = 10000000; ;; 0.01 GRAM

;; Added to an entry fee when a payload is present: the forwarding of max_payload_cells over every hop it rides.
const int fee::payload = 20000000; ;; 0.02 GRAM: 8 cells of 1,023 bits cost about 3.6M a hop, over 4 hops

;; The value a deposit's prepare_deposit and deposit_booked each carry at least. The undo of a bounced deposit_booked
;; sends the tree update and the cancel before the refund, so the floor covers update + cancel + refund + two handlers
;; (the bounce's and the refund's) and the forwarding of all three.
const int fee::bounce_floor = fee::update + fee::release + fee::payout + 2 * fee::handler + 10000000;

;; deposit, as forward_ton_amount of the hGRAM transfer: the notification's gas, the prepare_deposit with the
;; wallet's StateInit, the wallet's gas, deposit_ready at the Jackpot, the tree update and the node share, and
;; deposit_booked with the wallet's reserve; and the bounce floor for the last of them. No quote.
const int fee::deposit = 4 * fee::handler + fee::wallet_deploy_forward + fee::update + fee::node_share
    + fee::wallet_storage + fee::bounce_floor + 5000000;

;; burn, sent to the wallet: its gas, burn_notification at the Jackpot, the update, the close, and the payout.
const int fee::withdraw = 3 * fee::handler + fee::update + fee::release + fee::payout;

;; A `w`, or one owner of withdraw_for: the burn with the wallet's StateInit and its comment.
const int fee::comment_withdraw = fee::withdraw + fee::wallet_deploy_forward + 3000000;

;; submit_randomness: the quicknet check, then the draw: no quote.
const int fee::submit = 60000000 + 3 * fee::handler;

;; A poke: its handler, the quote round trip and the reply without boundary work.
const int fee::poke = 2 * fee::handler + fee::quote;

;; Hipo's unstake_tokens fee, sent with the unstake from the float or from a refill.
const int fee::unstake = 100000000; ;; 0.1 GRAM

;; refill: the handler and the unstake it pays for. No quote.
const int fee::refill = 2 * fee::handler + fee::unstake;

;; provide_wallet_address: its gas and the reply.
const int fee::wallet_address = 2 * fee::handler;

;; In gas units: the most gas a boundary's own work may use, the gas limit the reply raises to. The float pays the
;; gas really used. Measured (tests/Gas.spec.ts), over a reply that is not a boundary: 11,244 gas for a boundary, 22,887 with
;; an unstake, 33,785 when it also rolls over three open slots; three times the worst.
const int fee::boundary_max = 100000;

;; Returning tokens that came with too little GRAM, when the return can be paid for.
const int fee::return = fee::handler + fee::payout;

;; Closing the tree is paid by sweep's sender, never by the float or a node's reserve. One node's term is its gas
;; bound priced at the current gas price, plus the forwarding of its close_node. The bounds are measured on the node
;; code (tests/Retire.spec.ts, "Gas bounds") and set with at least 1.5 times headroom; the margin is applied once, at
;; the top, and flows down the tree with the values (see imports/utils.fc, close_cost).
const int close::gas_1 = 20000; ;; a level-1 node: finish and delete itself (measured 11,388)
const int close::gas_inner = 450000; ;; a node above level 1, up to 64 children (measured 290,166)
const int close::margin_num = 3; ;; the margin, 3/2
const int close::margin_den = 2;

;; sweep: its gas, one payout and fee::burn_forward. It must also bring close_cost(next_position).
const int fee::sweep = 2 * fee::handler + fee::payout + fee::burn_forward + 10000000;

;; Sending a foreign jetton or NFT back: the handler, the log, the transfer and its forwarding.
const int foreign::gas = 30000; ;; gas of the foreign-token handler, to price its log

;; withdraw_for: the Jackpot's own gas for one owner, 12,000 gas at 400 nano-GRAM per gas, on top of what the owner's
;; wallet is sent (measured 8,326 gas an owner in tests/Retire.spec.ts).
const int fee::withdraw_for_gas = 4800000;

const int fee::foreign_return = 60000000; ;; 0.06 GRAM

;; The most one draw can spend from the float: the boundary's gas, 48 searches at their worst real cost, 3 prize
;; payouts with their notifications, one burn, the submit reward and an unstake, plus the value that three
;; searches carry in flight.
const int fee::search_worst = 70000000; ;; 0.07 GRAM: 175,000 gas at 400 nano-GRAM per gas
const int fee::draw_budget = 3 * attempts_per_slot * fee::search_worst + 4 * fee::payout + 3 * fee::prize_notify
    + fee::burn_forward + reward::submit + fee::unstake + 3 * fee::search + fee::boundary_max * 400;


const int send::regular = 0;
const int send::pay_gas_separately = 1;
const int send::ignore_errors = 2;
const int send::bounce_if_failed = 16;
const int send::destroy_if_zero = 32;
const int send::remaining_value = 64;
const int send::unreserved_balance = 128;


const int reserve::exact = 0;
const int reserve::all_but_amount = 1;
const int reserve::at_most = 2;
const int reserve::add_original_balance = 4;
const int reserve::negate = 8;
const int reserve::bounce_if_failed = 16;


const int chain::base = 0;
