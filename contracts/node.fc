;; A node of the tree. For each of its 64 children it holds three sums of tickets (nano-GRAM of principal):
;;
;;   committed  the snapshot: the tickets below that child as they stood at the last boundary this node has
;;              heard of. Draws search only this.
;;   added      tickets booked since then.
;;   removed    tickets withdrawn since then.
;;
;; committed + added - removed is the truth. A level-1 node's children are positions b = 64q .. 64q+63, and it
;; also stores each position's owner (the address hash), so it answers a search by itself: no wallet takes part.
;; A level-l node's children are the level-(l-1) nodes 64q .. 64q+63. There are 4 levels; the Jackpot is the
;; parent of the one level-4 node, the top node.
;;
;; The Jackpot sends every change of tickets down the tree as update(tag, b, delta, owner?) and every attempt
;; of a draw as descend(tag, i, j, k, offset); each node passes them on to the child that holds b, or that
;; covers the offset. Every update and every descent starts at the Jackpot and travels down the same
;; parent-to-child pairs, and TON delivers the messages of each pair in order, so a descent sees each node
;; exactly as the Jackpot saw the tree when it sent it.
;;
;; The tag counts snapshots. A node that sees a later tag than its own folds first:
;; committed[c] += added[c] - removed[c], both cleared. An update never touches `committed`, so a draw's
;; positions cannot move after its randomness is known.
;;
;; Every array has the same shape: 8 chunk sums, ^[4 chunks] ^[4 chunks]; a chunk holds the values of 8
;; children. So an update rewrites one chunk and its path, a descent reads at most 8 sums and 8 values, and
;; a fold rewrites at most every chunk once.
;;
;; Every message a node sends carries the remaining value of the one it received (mode 64), so whoever
;; overpays pushes a costly step through; a node's own balance is its storage reserve only. A level-1 node
;; ends an update by sending the remaining value to the position's owner.
;;
;; The address follows from (jackpot, level, index). The code is fixed: nodes cannot be upgraded, and are
;; kept in full, never as a library cell. A node accepts update and descend only from its parent, and never
;; throws on a genuine update: a throw there would lose the update, and the sums below would be wrong for good.

#include "imports/utils.fc";

global slice jackpot;
global int level;
global int index;
global int initialized?;
global int parent_hash;   ;; the parent node's address hash; unused by the top node, whose parent is the Jackpot
global int tag;           ;; the latest snapshot this node has folded
global cell committed;
global cell added;
global cell removed;
global cell owners;       ;; level 1 only: the owner hash of each of the 64 positions, 3 to a cell

cell preload_ref_at(slice s, int i) asm "PLDREFVAR";

int compute_parent_hash() inline {
    cell code = my_code();
    cell data = create_node_data(jackpot, level + 1, index >> tree::bits);
    return state_init_hash(code.cell_hash(), code.cell_depth(), data);
}

() load_data() impure inline {
    slice ds = get_data().begin_parse();
    jackpot = ds~load_msg_addr();
    level = ds~load_uint(8);
    index = ds~load_uint(32);
    ;; the init data, which fixes the address, ends here; the first message from the parent adds the rest
    initialized? = ds.slice_bits() > 0;
    owners = null();
    if initialized? {
        parent_hash = ds~load_uint(256);
        tag = ds~load_uint(32);
        committed = ds~load_ref();
        added = ds~load_ref();
        removed = ds~load_ref();
        if level == 1 {
            owners = ds~load_ref();
        }
    } else {
        parent_hash = level < tree::levels ? compute_parent_hash() : 0;
        tag = 0;
        committed = null();
        added = null();
        removed = null();
    }
    ds.end_parse();
}

() save_data() impure inline {
    builder data = begin_cell()
        .store_slice(jackpot)
        .store_uint(level, 8)
        .store_uint(index, 32)
        .store_uint(parent_hash, 256)
        .store_uint(tag, 32)
        .store_ref(committed)
        .store_ref(added)
        .store_ref(removed);
    if level == 1 {
        data = data.store_ref(owners);
    }
    data.end_cell().set_data();
}

;; All zero: eight zero sums per chunk, and the same chunk cell in all eight places, which storage counts once.
cell empty_array() inline {
    cell chunk = begin_cell().store_uint(0, 32).end_cell();
    cell half = begin_cell().store_ref(chunk).store_ref(chunk).store_ref(chunk).store_ref(chunk).end_cell();
    return begin_cell().store_uint(0, 32).store_ref(half).store_ref(half).end_cell();
}

;; Reads eight Coins from `s`, the one at `p` raised by `delta` but never below 0. Returns them stored in a
;; new builder, the rest of `s` (its refs), and the change actually made.
(builder, slice, int) add_at(slice s, int p, int delta) inline {
    builder b = begin_cell();
    repeat (p) {
        b = b.store_coins(s~load_coins());
    }
    int old = s~load_coins();
    int new = max(old + delta, 0);
    b = b.store_coins(new);
    repeat (7 - p) {
        b = b.store_coins(s~load_coins());
    }
    return (b, s, new - old);
}

;; array[c] += delta, never below 0. The Jackpot only ever adds positive amounts to `added` and `removed`,
;; and a node must not throw on an update.
cell array_add(cell array, int c, int delta) inline_ref {
    int g = c >> 3;
    slice top = array.begin_parse();
    slice half = top.preload_ref_at(g >> 2).begin_parse();
    ( builder chunk, _, int applied ) = add_at(half.preload_ref_at(g & 3).begin_parse(), c & 7, delta);

    builder new_half = begin_cell();
    int i = 0;
    repeat (4) {
        cell r = half~load_ref();
        new_half = new_half.store_ref(i == (g & 3) ? chunk.end_cell() : r);
        i += 1;
    }

    ( builder new_top, slice halves, _ ) = add_at(top, g, applied);
    cell h0 = halves~load_ref();
    cell h1 = halves~load_ref();
    if g < 4 {
        h0 = new_half.end_cell();
    } else {
        h1 = new_half.end_cell();
    }
    return new_top.store_ref(h0).store_ref(h1).end_cell();
}

;; The child whose committed sums cover position k, taking the children in order, and k's offset inside it.
;; -1 when the children add up to no more than k.
(int, int) child_at(int k) inline {
    slice top = committed.begin_parse();
    int g = 0;
    int found? = false;
    do {
        int v = top~load_coins();
        if k < v {
            found? = true;
        } else {
            k -= v;
            g += 1;
        }
    } until found? | (g == 8);
    ifnot found? {
        return (-1, k);
    }

    slice chunk = top.preload_ref_at(g >> 2).begin_parse().preload_ref_at(g & 3).begin_parse();
    int p = 0;
    found? = false;
    do {
        int v = chunk~load_coins();
        if k < v {
            found? = true;
        } else {
            k -= v;
            p += 1;
        }
    } until found? | (p == 8);
    ifnot found? {
        return (-1, k); ;; a chunk short of its sum: cannot happen
    }
    return (g * 8 + p, k);
}


;; Owner hashes, 3 to a leaf cell (768 bits), in a tree of four-ref cells: position c is in leaf c / 3, found
;; through the base-4 digits of the leaf number. An empty tree shares its cells.
cell empty_owners() inline {
    cell leaf = begin_cell().store_uint(0, 256).store_uint(0, 256).store_uint(0, 256).end_cell();
    cell low = begin_cell().store_ref(leaf).store_ref(leaf).store_ref(leaf).store_ref(leaf).end_cell();
    cell mid = begin_cell().store_ref(low).store_ref(low).store_ref(low).store_ref(low).end_cell();
    return begin_cell().store_ref(mid).store_ref(mid).store_ref(mid).store_ref(mid).end_cell();
}

int owners_get(int c) inline_ref {
    int leaf_no = c / 3;
    cell mid = owners.begin_parse().preload_ref_at((leaf_no >> 4) & 3);
    cell low = mid.begin_parse().preload_ref_at((leaf_no >> 2) & 3);
    slice leaf = low.begin_parse().preload_ref_at(leaf_no & 3).begin_parse();
    leaf~skip_bits(256 * (c % 3));
    return leaf.preload_uint(256);
}

cell with_ref(cell parent, int i, cell child) inline {
    slice ps = parent.begin_parse();
    builder b = begin_cell();
    int j = 0;
    repeat (4) {
        cell r = ps~load_ref();
        b = b.store_ref(j == i ? child : r);
        j += 1;
    }
    return b.end_cell();
}

() owners_set(int c, int hash) impure inline_ref {
    int leaf_no = c / 3;
    int d2 = (leaf_no >> 4) & 3;
    int d1 = (leaf_no >> 2) & 3;
    int d0 = leaf_no & 3;
    cell mid = owners.begin_parse().preload_ref_at(d2);
    cell low = mid.begin_parse().preload_ref_at(d1);
    slice leaf = low.begin_parse().preload_ref_at(d0).begin_parse();
    builder nb = begin_cell();
    int p = 0;
    repeat (3) {
        int old = leaf~load_uint(256);
        nb = nb.store_uint(p == c % 3 ? hash : old, 256);
        p += 1;
    }
    low = with_ref(low, d0, nb.end_cell());
    mid = with_ref(mid, d1, low);
    owners = with_ref(owners, d2, mid);
}

int array_get(cell array, int c) inline_ref {
    int g = c >> 3;
    slice chunk = array.begin_parse().preload_ref_at(g >> 2).begin_parse().preload_ref_at(g & 3).begin_parse();
    repeat (c & 7) {
        chunk~load_coins();
    }
    return chunk~load_coins();
}

;; On a message tagged with a later snapshot than the node's own, `added` and `removed` are folded into
;; `committed` first, chunk by chunk, skipping chunks with nothing to fold.
() fold(int new_tag) impure inline_ref {
    if new_tag <= tag {
        return ();
    }
    slice ct = committed.begin_parse();
    slice adds = added.begin_parse();
    slice rt = removed.begin_parse();
    builder top = begin_cell();
    tuple chunks = empty_tuple();
    int g = 0;
    repeat (8) {
        int sum = ct~load_coins();
        int added_sum = adds~load_coins();
        int removed_sum = rt~load_coins();
        cell chunk = ct.preload_ref_at(g >> 2).begin_parse().preload_ref_at(g & 3);
        if added_sum | removed_sum {
            slice cs = chunk.begin_parse();
            slice as = adds.preload_ref_at(g >> 2).begin_parse().preload_ref_at(g & 3).begin_parse();
            slice rs = rt.preload_ref_at(g >> 2).begin_parse().preload_ref_at(g & 3).begin_parse();
            builder b = begin_cell();
            sum = 0;
            repeat (8) {
                int v = max(cs~load_coins() + as~load_coins() - rs~load_coins(), 0);
                sum += v;
                b = b.store_coins(v);
            }
            chunk = b.end_cell();
        }
        top = top.store_coins(sum);
        chunks~tpush(chunk);
        g += 1;
    }
    cell h0 = begin_cell().store_ref(chunks.at(0)).store_ref(chunks.at(1))
        .store_ref(chunks.at(2)).store_ref(chunks.at(3)).end_cell();
    cell h1 = begin_cell().store_ref(chunks.at(4)).store_ref(chunks.at(5))
        .store_ref(chunks.at(6)).store_ref(chunks.at(7)).end_cell();
    committed = top.store_ref(h0).store_ref(h1).end_cell();
    added = empty_array();
    removed = empty_array();
    tag = new_tag;
}

int from_parent?(slice src) inline {
    if level == tree::levels {
        return equal_slice_bits(src, jackpot);
    }
    return is_base_addr?(src, parent_hash);
}

builder node_address(int child_level, int child_index) inline {
    cell code = my_code();
    cell data = create_node_data(jackpot, child_level, child_index);
    return create_address(chain::base, state_init_hash(code.cell_hash(), code.cell_depth(), data));
}

() update(slice src, slice s) impure inline {
    int query_id = s~load_uint(64);
    int new_tag = s~load_uint(32);
    int b = s~load_uint(32);
    int delta = s~load_int(128);
    int has_owner? = s~load_int(1);
    int owner_hash = 0;
    if has_owner? {
        owner_hash = s~load_uint(256);
    }
    s.end_parse();

    throw_unless(err::access_denied, from_parent?(src));

    ;; Sent on: the remaining value, or, on the update that opens this node, all but the storage reserve
    ;; it carried for it.
    int mode = send::remaining_value;
    ifnot initialized? {
        initialized? = true;
        committed = empty_array();
        added = empty_array();
        removed = empty_array();
        if level == 1 {
            owners = empty_owners();
        }
        raw_reserve(fee::node_storage, reserve::at_most);
        mode = send::unreserved_balance;
    }

    fold(new_tag);

    int shift = tree::bits * (level - 1);
    int c = (b >> shift) & 63;
    if delta > 0 {
        added = array_add(added, c, delta);
    } else {
        removed = array_add(removed, c, - delta);
    }

    if level == 1 {
        if has_owner? {
            owners_set(c, owner_hash);
        }
        ;; what is left of the value goes to the position's owner
        int hash = owners_get(c);
        if hash {
            builder excess = begin_cell().store_uint(op::gas_excess, 32).store_uint(query_id, 64);
            send_msg(false, create_address(chain::base, hash), null(), excess, 0, mode + send::ignore_errors);
        }
        return ();
    }

    ;; the child at level - 1 holding b is b >> shift; the first position below it deploys it
    int child = b >> shift;
    builder state_init = null();
    if (delta > 0) & has_owner? & ((b & ((1 << shift) - 1)) == 0) {
        cell data = create_node_data(jackpot, level - 1, child);
        state_init = create_state_init(my_code(), data);
    }

    builder body = begin_cell()
        .store_uint(op::update, 32)
        .store_uint(query_id, 64)
        .store_uint(new_tag, 32)
        .store_uint(b, 32)
        .store_int(delta, 128)
        .store_int(has_owner?, 1);
    if has_owner? {
        body = body.store_uint(owner_hash, 256);
    }
    send_msg(false, node_address(level - 1, child), state_init, body, 0, mode);
}

() descend(slice src, slice s) impure inline {
    int query_id = s~load_uint(64);
    int new_tag = s~load_uint(32);
    int slot = s~load_uint(8);
    int j = s~load_uint(8);
    int k = s~load_uint(128);
    int offset = s~load_uint(128);
    s.end_parse();

    throw_unless(err::access_denied, from_parent?(src));
    throw_unless(err::not_set_up, initialized?);

    fold(new_tag);

    ( int c, int inner ) = child_at(offset);

    if c < 0 {
        ;; cannot happen while the sums agree with the Jackpot's; the Jackpot counts it as a miss
        builder lost = begin_cell()
            .store_uint(op::lost, 32)
            .store_uint(query_id, 64)
            .store_uint(new_tag, 32)
            .store_uint(slot, 8)
            .store_uint(j, 8)
            .store_uint(k, 128)
            .store_uint(level, 8)
            .store_uint(index, 32);
        send_msg(false, jackpot.to_builder(), null(), lost, 0, send::remaining_value);
        return ();
    }

    int child = (index << tree::bits) + c;
    if level > 1 {
        builder body = begin_cell()
            .store_uint(op::descend, 32)
            .store_uint(query_id, 64)
            .store_uint(new_tag, 32)
            .store_uint(slot, 8)
            .store_uint(j, 8)
            .store_uint(k, 128)
            .store_uint(inner, 128);
        send_msg(false, node_address(level - 1, child), null(), body, 0, send::remaining_value);
        return ();
    }

    ;; the position's tickets are live from the first one up to what the snapshot held, less what has been
    ;; withdrawn since: the ticket at `inner` wins if it is among them
    int hash = owners_get(c);
    int hit? = (hash != 0) & (inner < array_get(committed, c) - array_get(removed, c));
    builder body = begin_cell()
        .store_uint(hit? ? op::hit : op::miss, 32)
        .store_uint(query_id, 64)
        .store_uint(new_tag, 32)
        .store_uint(slot, 8)
        .store_uint(j, 8)
        .store_uint(k, 128)
        .store_uint(child, 32);
    if hit? {
        body = body.store_builder(create_address(chain::base, hash));
    }
    send_msg(false, jackpot.to_builder(), null(), body, 0, send::remaining_value);
}

;; close_node(next_position): the end of the tree, from the top down. The sender comes first, on the message's own
;; value, and the node never calls accept_message: its gas is paid by the value alone, so no close_node, forged or not,
;; can spend its reserve. Only the parent (the Jackpot for the top node) or the Jackpot may close a node. Then every
;; child's sum must be 0.
;;
;; The value is the funding. A node keeps term - fwd (its gas and the forwarding of its own close_node, which its
;; parent's value already paid), and gives each existing child (positions are assigned in order, so a child exists
;; exactly when its first position is below next_position) its share of the rest in proportion to the child's
;; subtree_cost, mode 0, the forwarding inside the share. It closes only if the value covers keep and the unscaled
;; sum of its children's costs; short, it does nothing and keeps the value, for close_subtree. The sends to the
;; children do not ignore errors: if one cannot be paid, nothing is sent and the node stays. Last, it sends its whole
;; balance, reserve and leftovers included, to the Jackpot and deletes itself.
() close_node(slice src, int value, slice s) impure inline {
    s~load_uint(64);
    int next_position = s~load_uint(32);
    s.end_parse();

    ifnot from_parent?(src) | equal_slice_bits(src, jackpot) {
        return ();
    }
    ifnot initialized? {
        return ();
    }
    slice ct = committed.begin_parse();
    slice ad = added.begin_parse();
    slice rt = removed.begin_parse();
    int nonzero? = false;
    repeat (8) {
        nonzero? |= (ct~load_coins() + ad~load_coins() - rt~load_coins()) != 0;
    }
    if nonzero? {
        return ();
    }
    int fwd = close_forward_fee();
    int t1 = node_term(1);
    int ti = node_term(2);
    int keep = (level == 1 ? t1 : ti) - fwd;
    ;; the children that exist: the first m of the 64, all of them full subtrees but the last
    int m = 0;
    int full = 0;
    int last = 0;
    int sum = 0;
    if level > 1 {
        int below = tree::bits * (level - 1);
        int span = next_position - (index << (below + tree::bits));
        if span > 0 {
            m = min(64, (span + (1 << below) - 1) >> below);
            full = subtree_cost_with(level - 1, 0, next_position, t1, ti);
            last = subtree_cost_with(level - 1, (index << tree::bits) + m - 1, next_position, t1, ti);
            sum = (m - 1) * full + last;
        }
    }
    if value < keep + sum {
        return ();
    }
    int j = 0;
    while j < m {
        builder body = begin_cell().store_uint(op::close_node, 32).store_uint(0, 64).store_uint(next_position, 32);
        int share = muldiv(value - keep, j == m - 1 ? last : full, sum);
        send_msg(false, node_address(level - 1, (index << tree::bits) + j), null(), body, share, send::regular);
        j += 1;
    }
    builder done = begin_cell().store_uint(op::gas_excess, 32).store_uint(0, 64);
    send_msg(false, jackpot.to_builder(), null(), done, 0, send::unreserved_balance + send::destroy_if_zero);
}

() recv_internal(int msg_value, cell in_msg_full, slice s) impure {
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if flags & 1 {
        return (); ;; a node sends nothing bounceable
    }
    slice src = cs~load_msg_addr();

    if s.slice_bits() < 32 {
        return (); ;; plain GRAM: anyone may top up the storage reserve
    }
    int op = s~load_uint(32);
    if op == op::top_up {
        return ();
    }

    load_data();
    if op == op::update {
        update(src, s);
        return save_data();
    }
    if op == op::descend {
        descend(src, s);
        return save_data();
    }
    if op == op::close_node {
        close_node(src, msg_value, s);
        return save_data();
    }

    throw(err::invalid_op);
}

;;
;; get methods
;;

tuple array_values(cell array) inline {
    tuple values = empty_tuple();
    slice top = array.begin_parse();
    int g = 0;
    repeat (8) {
        slice chunk = top.preload_ref_at(g >> 2).begin_parse().preload_ref_at(g & 3).begin_parse();
        repeat (8) {
            values~tpush(chunk~load_coins());
        }
        g += 1;
    }
    return values;
}

;; ( jackpot, level, index, initialized, tag, committed[64], added[64], removed[64], owner hashes[64] ):
;; committed + added - removed is the truth. The owner hashes are empty for a node above level 1.
var get_node_data() method_id {
    load_data();
    tuple c = empty_tuple();
    tuple a = empty_tuple();
    tuple r = empty_tuple();
    tuple o = empty_tuple();
    if initialized? {
        c = array_values(committed);
        a = array_values(added);
        r = array_values(removed);
        if level == 1 {
            int i = 0;
            repeat (64) {
                o~tpush(owners_get(i));
                i += 1;
            }
        }
    }
    return ( jackpot, level, index, initialized?, tag, c, a, r, o );
}
