;; Hipo Jackpot: a no-loss prize draw on hGRAM. The design is in docs/specs/2026-10-31-jackpot-v2.md and its
;; amendment 1 (docs/specs/2026-11-03-jackpot-v2-amendment-1.md), which this file follows: no records, no clock,
;; full-body bounces, boundaries driven by Hipo's rate. The message layouts are in contracts/schema.tlb.
;;
;; Units: held_tokens, incoming_tokens, reserved_tokens, unstaking_tokens and every prize are nano-hGRAM;
;; principal, tickets, booked_principal, withdrawn_principal, snapshot_tickets and positions are nano-GRAM
;; (tickets). The stored rate (quote_coins, quote_tokens) converts between them, and every conversion rounds
;; toward the pool.
;;
;; The tickets of every position are counted in a tree of node contracts (contracts/node.fc), and a draw picks
;; a ticket of the snapshot and walks down the tree to it. The Jackpot is also the master of the jGRAM jetton:
;; one wallet per player (contracts/wallet.fc) holds the player's principal.

#include "imports/utils.fc";
#include "imports/fees.fc";
#include "imports/drand.fc";

;; FunC allows 31 globals, so what is read rarely -- the governor's parameters, the boundary, the draw's prizes,
;; the codes, the Hipo wallet details and the roles -- stays packed in cells and is unpacked where needed.

;; counters
global int held_tokens;       ;; hGRAM the Jackpot holds, by its own count
global int incoming_tokens;   ;; deposits received, not yet booked or returned
global int reserved_tokens;   ;; prizes of the open draw and burn owed
global int principal;         ;; GRAM owed to players
global int tickets;           ;; live tickets: always equal to principal
global int quote_coins;       ;; the stored rate, from the last poke's quote reply
global int quote_tokens;
global int query_counter;
global int halted?;
global int falling?;
global int burn_owed;         ;; part of reserved_tokens
global int carried;           ;; prizes gone back into free_tokens since the last draw that fixed a pot
global int unstaking_tokens;  ;; hGRAM sent to unstake and not yet reported back
global int next_position;
global int tag;               ;; the snapshot counter; it travels on every tree message

;; settings
global cell params;           ;; b_share (bp), min_pot, burn_batch, min_deposit
global cell boundary;         ;; last_boundary, the boundary rate, rise_min, min_gap, next_min_gap, last_unstake
global cell content;          ;; the jetton's TEP-64 metadata

;; the draw
global int draw_state;
global int snapshot_tickets;
global int seed;
global int slots;             ;; bit i set while slot i is open; attempt of slot i in bits 8 + 8i .. 15 + 8i
global cell draw_misc;        ;; p0, p1, p2
global int mc_hash;           ;; root hash of the newest masterchain block the last boundary saw

;; addresses
global slice wallet;          ;; the Jackpot's own hGRAM wallet
global cell addresses;        ;; treasury, wallet, ^wallet_code, ^node_code, ^hipo, ^roles
global cell retirement;       ;; retired, successor, successor_deposit_fee

;; the message being handled
global int bal0;              ;; the Jackpot's balance before the message, without its value: the float

() load_data() impure inline_ref {
    slice ds = get_data().begin_parse();
    int version = ds~load_uint(8);
    ;; 0 is the deploy data, which the first message checks and rewrites as the current layout
    throw_unless(err::unknown_version, (version == storage_version) | (version == 0));
    held_tokens = ds~load_coins();
    incoming_tokens = ds~load_coins();
    reserved_tokens = ds~load_coins();
    principal = ds~load_coins();
    tickets = ds~load_coins();
    quote_coins = ds~load_uint(128);
    quote_tokens = ds~load_uint(128);
    query_counter = ds~load_uint(32);
    halted? = ds~load_int(1);
    falling? = ds~load_int(1);

    slice extra = ds~load_ref().begin_parse();
    burn_owed = extra~load_coins();
    carried = extra~load_coins();
    unstaking_tokens = extra~load_coins();
    next_position = extra~load_uint(32);
    tag = extra~load_uint(32);
    params = extra~load_ref();
    boundary = extra~load_ref();
    content = extra~load_ref();
    extra.end_parse();

    slice draw = ds~load_ref().begin_parse();
    draw_state = draw~load_uint(2);
    snapshot_tickets = draw~load_coins();
    seed = draw~load_uint(256);
    slots = draw~load_uint(32);
    mc_hash = draw~load_uint(256);
    draw_misc = draw~load_ref();
    draw.end_parse();

    addresses = ds~load_ref();
    slice as = addresses.begin_parse();
    as~load_msg_addr(); ;; treasury
    wallet = as~load_msg_addr();
    if wallet.addr_none?() {
        ;; The Jackpot's own wallet address follows from its address, so it cannot be in the init data
        ;; that fixes that address. It is derived here, as Hipo's parent would, and saved with the first
        ;; message; the governor can still replace it with set_hipo_wallet after a wallet migration.
        as~load_ref();
        as~load_ref();
        slice hs = as~load_ref().begin_parse();
        slice parent = hs~load_msg_addr();
        ( builder own, _, _ ) = create_wallet_address(my_address().to_builder(), parent, hs~load_ref());
        wallet = own.end_cell().begin_parse();
    }
    retirement = ds~load_ref();

    ds.end_parse();
}

() save_data() impure inline_ref {
    cell extra = begin_cell()
        .store_coins(burn_owed)
        .store_coins(carried)
        .store_coins(unstaking_tokens)
        .store_uint(next_position, 32)
        .store_uint(tag, 32)
        .store_ref(params)
        .store_ref(boundary)
        .store_ref(content)
        .end_cell();

    cell draw = begin_cell()
        .store_uint(draw_state, 2)
        .store_coins(snapshot_tickets)
        .store_uint(seed, 256)
        .store_uint(slots, 32)
        .store_uint(mc_hash, 256)
        .store_ref(draw_misc)
        .end_cell();

    slice as = addresses.begin_parse();
    slice treasury = as~load_msg_addr();
    as~load_msg_addr();
    cell new_addresses = begin_cell()
        .store_slice(treasury)
        .store_slice(wallet)
        .store_slice(as) ;; the four refs
        .end_cell();

    begin_cell()
        .store_uint(storage_version, 8)
        .store_coins(held_tokens)
        .store_coins(incoming_tokens)
        .store_coins(reserved_tokens)
        .store_coins(principal)
        .store_coins(tickets)
        .store_uint(quote_coins, 128)
        .store_uint(quote_tokens, 128)
        .store_uint(query_counter, 32)
        .store_int(halted?, 1)
        .store_int(falling?, 1)
        .store_ref(extra)
        .store_ref(draw)
        .store_ref(new_addresses)
        .store_ref(retirement)
        .end_cell()
        .set_data();
}

;; ( b_share, min_pot, burn_batch, min_deposit )
(int, int, int, int) unpack_params() inline {
    slice cs = params.begin_parse();
    return ( cs~load_uint(16), cs~load_coins(), cs~load_coins(), cs~load_coins() );
}

() pack_params(int b_share, int min_pot, int burn_batch, int min_deposit) impure inline {
    params = begin_cell()
        .store_uint(b_share, 16)
        .store_coins(min_pot)
        .store_coins(burn_batch)
        .store_coins(min_deposit)
        .end_cell();
}

;; ( last_boundary, boundary_coins, boundary_tokens, rise_min, min_gap, next_min_gap, last_unstake )
(int, int, int, int, int, int, int) unpack_boundary() inline {
    slice cs = boundary.begin_parse();
    return ( cs~load_uint(32), cs~load_uint(128), cs~load_uint(128), cs~load_uint(32), cs~load_uint(32), cs~load_uint(32), cs~load_uint(32) );
}

() pack_boundary(int last_boundary, int boundary_coins, int boundary_tokens, int rise_min, int min_gap, int next_min_gap, int last_unstake) impure inline {
    boundary = begin_cell()
        .store_uint(last_boundary, 32)
        .store_uint(boundary_coins, 128)
        .store_uint(boundary_tokens, 128)
        .store_uint(rise_min, 32)
        .store_uint(min_gap, 32)
        .store_uint(next_min_gap, 32)
        .store_uint(last_unstake, 32)
        .end_cell();
}

;; ( retired, successor, successor_deposit_fee, swept )
(int, slice, int, int) unpack_retirement() inline {
    slice cs = retirement.begin_parse();
    return ( cs~load_int(1), cs~load_msg_addr(), cs~load_coins(), cs~load_int(1) );
}

() pack_retirement(int retired?, slice successor, int fee, int swept?) impure inline {
    retirement = begin_cell().store_int(retired?, 1).store_slice(successor).store_coins(fee).store_int(swept?, 1).end_cell();
}

int retired?() inline {
    return retirement.begin_parse().preload_int(1);
}

int swept?() inline {
    ( _, _, _, int done? ) = unpack_retirement();
    return done?;
}

;; ( p0, p1, p2 )
(int, int, int) unpack_misc() inline {
    slice cs = draw_misc.begin_parse();
    return ( cs~load_coins(), cs~load_coins(), cs~load_coins() );
}

() pack_misc(int p0, int p1, int p2) impure inline {
    draw_misc = begin_cell()
        .store_coins(p0)
        .store_coins(p1)
        .store_coins(p2)
        .end_cell();
}

slice treasury() inline {
    slice as = addresses.begin_parse();
    return as~load_msg_addr();
}

cell address_ref(int i) inline {
    slice as = addresses.begin_parse();
    as~load_msg_addr();
    as~load_msg_addr();
    repeat (i) {
        as~load_ref();
    }
    return as.preload_ref();
}

cell wallet_code() inline {
    return address_ref(0);
}

cell node_code() inline {
    return address_ref(1);
}

;; ( parent, hGRAM wallet_code )
(slice, cell) unpack_hipo() inline {
    slice cs = address_ref(2).begin_parse();
    return ( cs~load_msg_addr(), cs~load_ref() );
}

;; ( burner, governor, halter )
(slice, slice, slice) unpack_roles() inline {
    slice cs = address_ref(3).begin_parse();
    return ( cs~load_msg_addr(), cs~load_msg_addr(), cs~load_msg_addr() );
}

slice governor() inline {
    ( _, slice governor, _ ) = unpack_roles();
    return governor;
}

() set_address_ref(int i, cell value) impure inline {
    slice as = addresses.begin_parse();
    builder b = begin_cell().store_slice(as~load_msg_addr()).store_slice(as~load_msg_addr());
    int j = 0;
    repeat (4) {
        cell r = as~load_ref();
        b = b.store_ref(j == i ? value : r);
        j += 1;
    }
    addresses = b.end_cell();
}

;;
;; helpers
;;

;; A fresh query_id for a transfer the Jackpot starts itself (a prize, a burn): a counter in the high 32 bits.
int new_query_id() impure inline {
    query_counter += 1;
    return query_counter << 32;
}

slice addr_none() asm "b{00} PUSHSLICE";
int tlen(tuple t) asm "TLEN";
tuple prev_mc_blocks() asm "PREVMCBLOCKS";
() set_gas_limit(int g) impure asm "SETGASLIMIT";

int incoming_value() inline {
    return get_incoming_value().pair_first();
}

int free_tokens() inline {
    return held_tokens - incoming_tokens - reserved_tokens;
}

;; The newest masterchain block the transaction sees: the PREVMCBLOCKS entry with the highest seqno. Returns its
;; seqno and root hash (0, 0 when the instruction gives nothing).
(int, int) newest_mc_block() inline_ref {
    tuple t = prev_mc_blocks();
    int best = -1;
    int hash = 0;
    if ~ t.null?() {
        int i = 0;
        int n = tlen(t);
        while i < n {
            tuple b = t.at(i);
            int seqno = b.at(2);
            if seqno > best {
                best = seqno;
                hash = b.at(3);
            }
            i += 1;
        }
    }
    return ( max(best, 0), hash );
}

;; Every message the Jackpot sends goes through here, so that a handler marked with act_flag = 16 bounces its
;; message when any of its actions fails.
() out(int bounceable?, builder dst, builder state_init, builder body, int coins, int mode) impure inline {
    send_msg(bounceable?, dst, state_init, body, coins, mode + act_flag);
}

;; Sends everything the message brought, less its gas and less what the handler already sent, so that the
;; Jackpot's balance ends where it was before the message plus `float_delta`: what the handler kept for
;; the float, minus what it sent from the float with an explicit value.
() send_rest(int bounceable?, builder dst, builder state_init, builder body, int float_delta, int extra_mode)
    impure inline_ref {
    raw_reserve(max(bal0 + float_delta, 0), reserve::at_most + act_flag);
    out(bounceable?, dst, state_init, body, 0, send::unreserved_balance + extra_mode);
}

() send_excess(slice dst, int float_delta) impure inline {
    builder excess = begin_cell()
        .store_uint(op::gas_excess, 32)
        .store_uint(0, 64);
    send_rest(false, dst.to_builder(), null(), excess, float_delta, send::ignore_errors);
}

int owner_hash(slice owner) inline {
    ( _, int hash ) = parse_std_addr(owner);
    return hash;
}

cell node_data(int level, int index) inline {
    return create_node_data(my_address(), level, index);
}

int node_hash(int level, int index) inline {
    cell code = node_code();
    return state_init_hash(code.cell_hash(), code.cell_depth(), node_data(level, index));
}

int jwallet_hash(slice owner) inline {
    cell code = wallet_code();
    return state_init_hash(code.cell_hash(), code.cell_depth(), create_jwallet_data(my_address(), owner));
}

builder jwallet_address(slice owner) inline {
    return create_address(chain::base, jwallet_hash(owner));
}

int is_jwallet_of?(slice src, slice owner) inline {
    return is_base_addr?(src, jwallet_hash(owner));
}

int is_node?(slice src, int level, int index) inline {
    return is_base_addr?(src, node_hash(level, index));
}

int prize(int slot) inline {
    ( int p0, int p1, int p2 ) = unpack_misc();
    return slot == 0 ? p0 : (slot == 1 ? p1 : p2);
}

int attempt(int slot) inline {
    return (slots >> (8 + 8 * slot)) & 0xff;
}

int slot_open?(int slot) inline {
    return (slots >> slot) & 1;
}

;; k(i, j) = uint256(sha256(seed ‖ uint8 i ‖ uint8 j)) mod snapshot_tickets, hashing exactly 272 bits.
int position(int slot, int j) inline {
    builder data = begin_cell()
        .store_uint(seed, 256)
        .store_uint(slot, 8)
        .store_uint(j, 8);
    return data.sha256_builder() % snapshot_tickets;
}

;; hGRAM the Jackpot may unstake: 0 if it was done in the last 7 days while the counter is still above 0.
int unstake_allowed?() inline {
    ( _, _, _, _, _, _, int last_unstake ) = unpack_boundary();
    return (unstaking_tokens == 0) | (now() >= last_unstake + unstake_guard);
}

;; The pot: the free hGRAM above what covers all principal, and its value.
(int, int) pot_at(int tc, int tt) inline {
    int need = muldivc(principal, tt, tc);
    int pot = max(free_tokens() - need, 0);
    return ( pot, muldivc(pot, tc, tt) );
}

;; u = min(ceil((float_high - float)·TT/TC), floor(pot/5)), the hGRAM to unstake to bring the float back.
int unstake_amount(int pot, int tc, int tt) inline {
    return min(muldivc(max(float::high - bal0, 0), tt, tc), pot / 5);
}

;; The comments the Jackpot writes.
cell prize_comment(int slot) inline {
    builder b = begin_cell().store_uint(0, 32).store_slice("Hipo Jackpot prize: draw ");
    b = b.store_decimal(tag).store_slice(", ");
    b = b.store_slice(slot == 0 ? "1st" : (slot == 1 ? "2nd" : "3rd"));
    return b.end_cell();
}

slice reason_text(int reason) inline {
    if reason == reason::halted { return "paused"; }
    if reason == reason::retired { return "closed for deposits"; }
    if reason == reason::rate_falling { return "Hipo's rate fell"; }
    if reason == reason::below_min_deposit { return "below the minimum deposit"; }
    if reason == reason::price { return "entry price above your limit"; }
    if reason == reason::wallet_busy { return "your first deposit is still being booked"; }
    if reason == reason::tree_full { return "no room for new players"; }
    if reason == reason::bad_options { return "options could not be read"; }
    if reason == reason::low_value { return "too little GRAM attached"; }
    return "your Jackpot wallet could not take it";
}

;;
;; payouts
;;

builder transfer_body(int query_id, int amount, slice recipient, slice return_excess, int forward_ton_amount, cell payload) inline {
    builder b = begin_cell()
        .store_uint(op::send_tokens, 32)
        .store_uint(query_id, 64)
        .store_coins(amount)
        .store_slice(recipient)
        .store_slice(return_excess)
        .store_uint(0, 1) ;; no custom_payload
        .store_coins(forward_ton_amount);
    ;; a non-empty forward_payload always goes in a ref
    return payload.null?() ? b.store_uint(0, 1) : b.store_uint(1, 1).store_ref(payload);
}

;; An hGRAM transfer out, paid from the float and not confirmed: a prize or a burn. It leaves held_tokens at once.
() pay_float(slice recipient, int amount, int forward_ton_amount, cell payload) impure inline_ref {
    held_tokens -= amount;
    out(false, wallet.to_builder(), null(),
        transfer_body(new_query_id(), amount, recipient, my_address(), forward_ton_amount, payload),
        fee::payout + forward_ton_amount, send::regular);
}

;; What a handler can still pass on (fee::payout must also cover Hipo's send_tokens_fee, the transfer's inbound
;; forwarding, and the extra forwarding of a cap-size payload above the 3 x GETFORWARDFEE(2, 1023) estimate), `sent` being what it already sent from the message's value (the tree update, the
;; close of a wallet): the incoming value less that, less the gas it has used and will use, less the forwarding of its
;; messages and logs. Judged here, not on incoming_value(), so that a transfer chosen with its forward fields can pay
;; for them at Hipo's wallet.
int value_left(int sent) inline {
    return incoming_value() - sent - get_gas_fee(gas_consumed() + 15000, 0) - 3 * get_forward_fee(2, 1023, 0);
}

;; An hGRAM transfer out, paid by the message being handled: it carries everything the message brought and is not
;; confirmed. When the value left is short for its forward fields, they are dropped, so that Hipo's wallet never
;; throws on it. The last send of its handler. extra_mode 2 makes a failed send leave the handler standing.
() pay_rest(int query_id, slice recipient, slice return_excess, int amount, int forward_ton_amount, cell payload,
    int float_delta, int sent, int extra_mode, int keep?) impure inline_ref {
    int fwd = forward_ton_amount;
    cell body_payload = payload;
    ;; keep? is a move already decided on the value left: its forward fields stay, whatever the handler spent since
    if (~ keep?) & (value_left(sent) < payout_fee() + fwd) {
        fwd = 0;
        body_payload = null();
    }
    held_tokens -= amount;
    send_rest(false, wallet.to_builder(), null(),
        transfer_body(query_id, amount, recipient, return_excess, fwd, body_payload), float_delta, extra_mode);
}

;; The refund of tokens the handler counts (counted? true: they are in held_tokens) or does not count yet. When the
;; value cannot pay a transfer at all (fee::return), counted tokens leave the count unpaid, with an untracked log, and
;; uncounted ones simply stay in the wallet. `sent` is what the handler already sent from the message's value; with soft?
;; (the undo of a booking) the refund's send ignores errors: a refund lost leaves hGRAM untracked, which return_tokens
;; recovers, and the undo itself stands.
() refund(int query_id, slice to, int amount, int reason, int has_options?, int fwd, cell payload, int counted?, int sent,
    int soft?) impure inline_ref {
    if value_left(sent) < payout_fee() {
        if counted? {
            held_tokens -= amount;
            emit_log(log::untracked, begin_cell().store_uint(untracked::refund_unpaid, 8).store_coins(amount));
        }
        return ();
    }
    if ~ counted? {
        held_tokens += amount;
    }
    int refund_fwd = 1;
    cell refund_payload = comment_cell(begin_cell().store_slice("Hipo Jackpot: deposit returned (").store_slice(reason_text(reason)).store_slice(")").end_cell().begin_parse());
    if has_options? {
        ;; options that could not be read carry no forward amount: 1 nano-GRAM still brings the reason to the depositor
        refund_fwd = (fwd == 0) & (reason == reason::bad_options) ? 1 : fwd;
        refund_payload = begin_cell()
            .store_uint(op::deposit_refused, 32)
            .store_uint(reason, 8)
            .store_maybe_ref(reason == reason::bad_options ? null() : payload)
            .end_cell();
    }
    pay_rest(query_id, to, to, amount, refund_fwd, refund_payload, 0, sent, soft? ? send::ignore_errors : 0, false);
}

;; Sends a change of the tickets of position b down the tree. A new position's update carries its owner, the
;; deploy of the top node when b = 0, and the reserve of every node b opens. Returns the part of the value that came
;; from the float.
int send_update(int query_id, int b, int delta, int owner_hash, int coins) impure inline_ref {
    int opens = 0;
    builder state_init = null();
    int has_owner? = owner_hash >= 0;
    if has_owner? & (delta > 0) {
        int shift = tree::bits;
        repeat (tree::levels) {
            if (b & ((1 << shift) - 1)) == 0 {
                opens += fee::node_open;
            }
            shift += tree::bits;
        }
        if b == 0 {
            state_init = create_state_init(node_code(), node_data(tree::levels, 0));
        }
    }
    builder body = begin_cell()
        .store_uint(op::update, 32)
        .store_uint(query_id, 64)
        .store_uint(tag, 32)
        .store_uint(b, 32)
        .store_int(delta, 128)
        .store_int(has_owner?, 1);
    if has_owner? {
        body = body.store_uint(owner_hash, 256);
    }
    builder top = create_address(chain::base, node_hash(tree::levels, 0));
    out(false, top, state_init, body, coins + opens, send::pay_gas_separately);
    return opens;
}

() log_slot(int slot, int j, int result, int k, int b, int amount, slice owner) impure inline {
    builder log = begin_cell()
        .store_uint(tag, 32)
        .store_uint(slot, 8)
        .store_uint(j, 8)
        .store_uint(result, 8)
        .store_uint(k, 128)
        .store_uint(b, 32)
        .store_coins(amount)
        .store_slice(owner);
    emit_log(log::slot, log);
}

;; Closes a slot. When it was the last one, the draw is over, and the burn owed goes out once it reaches the batch
;; size, its gas from the float.
() close_slot(int slot) impure inline {
    slots &= ~ (1 << slot);
    if slots & 7 {
        return ();
    }

    draw_state = draw::none;
    ;; the burn owed is held while the rate has fallen
    ( _, _, int burn_batch, _ ) = unpack_params();
    if (burn_owed > 0) & (burn_owed >= burn_batch) & (~ falling?) {
        int amount = burn_owed;
        burn_owed = 0;
        reserved_tokens -= amount;
        ( slice burner, _, _ ) = unpack_roles();
        pay_float(burner, amount, fee::burn_forward, null());
    }
}

;; A prize that found no winner goes back into free_tokens, and is counted in `carried` so that the next pot does
;; not burn it a second time.
() roll_back(int slot) impure inline {
    int amount = prize(slot);
    reserved_tokens -= amount;
    carried += amount;
}

;;
;; deposits
;;

;; The deposit context: built here, carried by prepare_deposit and deposit_ready, never stored.
cell make_context(int query_id, int tokens, int has_options?, int min_principal, int fwd, cell payload,
    slice owner, slice sender, slice response) inline_ref {
    cell parties = begin_cell().store_slice(owner).store_slice(sender).store_slice(response).end_cell();
    builder b = begin_cell().store_uint(query_id, 64).store_coins(tokens).store_int(has_options?, 1);
    if has_options? {
        b = b.store_coins(min_principal);
    }
    return b.store_coins(fwd).store_maybe_ref(payload).store_ref(parties).end_cell();
}

;; ( query_id, tokens, has_options?, min_principal, forward_ton_amount, payload, owner, sender, response )
(int, int, int, int, int, cell, slice, slice, slice) unpack_context(cell c) inline_ref {
    slice cs = c.begin_parse();
    int query_id = cs~load_uint(64);
    int tokens = cs~load_coins();
    int has_options? = cs~load_int(1);
    int min_principal = 0;
    if has_options? {
        min_principal = cs~load_coins();
    }
    int fwd = cs~load_coins();
    cell payload = cs~load_maybe_ref();
    slice parties = cs~load_ref().begin_parse();
    return ( query_id, tokens, has_options?, min_principal, fwd, payload,
        parties~load_msg_addr(), parties~load_msg_addr(), parties~load_msg_addr() );
}

builder nft_transfer_body(int query_id, slice new_owner, slice response, int forward_ton_amount, cell payload) inline {
    builder b = begin_cell()
        .store_uint(op::nft_transfer, 32)
        .store_uint(query_id, 64)
        .store_slice(new_owner)
        .store_slice(response)
        .store_uint(0, 1) ;; no custom_payload
        .store_coins(forward_ton_amount);
    return payload.null?() ? b.store_uint(0, 1) : b.store_uint(1, 1).store_ref(payload);
}

;; A foreign jetton or NFT, or a fake: it is sent back to its sender when the value of its notification covers the
;; return, otherwise held for the governor's rescue. The return pays with the message's value only: the balance the
;; Jackpot had before the message is reserved and the transfer carries everything above it (as send_rest does), so the
;; gas, the log and the transfer all come out of the incoming value, and the float and every counter end where they
;; were. The log is written only when the value covers its fee. A return that bounces changes nothing: the token is
;; held. `item` is the token wallet or the NFT item that sent the notification.
() foreign_token(slice item, slice back_to, int query_id, int amount, int nft?) impure inline_ref {
    int value = incoming_value();
    int back? = (value >= fee::foreign_return) & base_addr?(back_to) & (~ equal_slice_bits(back_to, my_address()));
    builder log = begin_cell().store_slice(item).store_slice(back_to).store_coins(amount);
    if back? {
        emit_log(log::foreign_return, log.store_uint(1, 1));
        cell note = comment_cell("Hipo Jackpot: this token is not accepted");
        builder body = nft?
            ? nft_transfer_body(query_id, back_to, back_to, 1, note)
            : transfer_body(query_id, amount, back_to, back_to, 1, note);
        send_rest(true, item.to_builder(), null(), body, 0, 0);
        return ();
    }
    if value >= get_gas_fee(foreign::gas, 0) + get_forward_fee(2, 1023, 0) {
        emit_log(log::foreign_return, log.store_uint(0, 1));
    }
}

() ownership_assigned(slice src, slice s) impure inline {
    int query_id = s~load_uint(64);
    slice prev_owner = s~load_msg_addr();
    foreign_token(src, prev_owner, query_id, 0, true);
}

;; Both kinds of arrival come as transfer_notification from the Jackpot's own wallet. A mint names the Jackpot
;; itself as the sender; a player's transfer names the player. The deposit's options are read here and never
;; throw: options that cannot be read are a refusal.
() transfer_notification(slice src, slice s) impure inline {
    int query_id = s~load_uint(64);
    int amount = s~load_coins();
    slice sender = s~load_msg_addr();

    ifnot equal_slice_bits(src, wallet) {
        ;; not ours: nothing is credited from a notification we cannot trust; it goes back or waits for the governor
        return foreign_token(src, sender, query_id, amount, false);
    }

    ;; A mint, or nothing: the tokens stay in the wallet outside held_tokens, for the governor.
    if equal_slice_bits(sender, my_address()) | (amount == 0) | (~ base_addr?(sender)) {
        return ();
    }

    ;; the forward payload, inline or in a ref
    slice p = begin_cell().end_cell().begin_parse();
    if s.slice_bits() >= 1 {
        if s~load_uint(1) {
            if s.slice_refs() > 0 {
                p = s~load_ref().begin_parse();
            }
        } else {
            p = s;
        }
    }

    int has_options? = false;
    int ok? = true;
    int min_principal = 0;
    slice beneficiary = sender;
    slice response = sender;
    int fwd = 0;
    cell inner = null();
    int pcells = 0;
    int pbits = 0;
    if p.slice_bits() >= 32 {
        if p.preload_uint(32) == op::deposit_options {
            has_options? = true;
            p~skip_bits(32);
            try {
                int mp = p~load_coins();
                slice ben = p~load_msg_addr();
                slice res = p~load_msg_addr();
                int f = p~load_coins();
                cell in = p~load_maybe_ref();
                p.end_parse();
                min_principal = mp;
                beneficiary = ben;
                response = res;
                fwd = f;
                inner = in;
            } catch (_, _) {
                ok? = false;
            }
            if ok? {
                ;; addr_none means the depositor; anything else must be a basechain address and not the Jackpot
                if beneficiary.addr_none?() {
                    beneficiary = sender;
                }
                if response.addr_none?() {
                    response = sender;
                }
                ok? = base_addr?(beneficiary) & base_addr?(response) & (~ equal_slice_bits(beneficiary, my_address()))
                    & (~ equal_slice_bits(response, my_address()));
                if ok? & (~ inner.null?()) {
                    ok? = payload_fits?(inner);
                    if ok? {
                        ( pcells, pbits ) = payload_size(inner, max_payload_cells);
                    }
                }
            }
        }
    }

    int reason = 0;
    if ~ ok? {
        reason = reason::bad_options;
    } elseif halted? {
        reason = reason::halted;
    } elseif retired?() {
        reason = reason::retired;
    } elseif incoming_value() < deposit_fee(fwd, pcells, pbits) {
        reason = reason::low_value;
    }
    if reason {
        ;; a refusal for bad options goes to the depositor, never to an address the options named
        refund(query_id, ok? ? response : sender, amount, reason, has_options?, ok? ? fwd : 0, inner, false, 0, false);
        return ();
    }

    held_tokens += amount;
    incoming_tokens += amount;

    cell context = make_context(query_id, amount, has_options?, min_principal, fwd, inner, beneficiary, sender, response);
    builder prepare = begin_cell().store_uint(op::prepare_deposit, 32).store_uint(query_id, 64).store_ref(context);
    builder init = create_state_init(wallet_code(), create_jwallet_data(my_address(), beneficiary));
    send_rest(true, jwallet_address(beneficiary), init, prepare, 0, 0);
}

;; From the jGRAM wallet of the context's owner. The deposit is booked, or refused, here. Every action carries +16,
;; so a failure bounces the message to the wallet, which lowers its pending count.
() deposit_ready(slice src, slice s) impure inline {
    act_flag = send::bounce_if_failed;
    int query_id = s~load_uint(64);
    int busy? = s~load_int(1);
    int has_position? = s~load_int(1);
    int b = 0;
    if has_position? {
        b = s~load_uint(32);
    }
    cell ctx = s~load_ref();
    ( _, int t, int has_options?, int min_principal, int fwd, cell payload, slice owner, slice sender, slice response ) = unpack_context(ctx);
    ifnot is_jwallet_of?(src, owner) {
        return ();
    }
    int pcells = 0;
    int pbits = 0;
    ifnot payload.null?() {
        ( pcells, pbits ) = payload_size(payload, max_payload_cells);
    }

    if busy? {
        incoming_tokens -= t;
        refund(query_id, response, t, reason::wallet_busy, has_options?, fwd, payload, true, 0, false);
        return ();
    }

    ;; the price is read with t still incoming, so a deposit never pays for its own tokens
    int v = muldiv(t, quote_coins, quote_tokens);
    ( _, int pot_v ) = pot_at(quote_coins, quote_tokens);
    int c = v;
    if principal > 0 {
        c = muldiv(v, principal, principal + pot_v);
    }
    incoming_tokens -= t;
    ( _, _, _, int min_deposit ) = unpack_params();
    ifnot has_options? {
        min_principal = v - v / 100;
    }

    int reason = 0;
    if halted? {
        reason = reason::halted;
    } elseif retired?() {
        reason = reason::retired;
    } elseif falling? {
        reason = reason::rate_falling;
    } elseif v < min_deposit {
        reason = reason::below_min_deposit;
    } elseif (c == 0) | (c < min_principal) {
        reason = reason::price;
    } elseif (~ has_position?) & (next_position >= tree::capacity) {
        reason = reason::tree_full;
    } elseif value_left(0) < update_min() + booked_min(pcells, pbits) {
        ;; the update and deposit_booked could not be paid for at the current price
        reason = reason::low_value;
    }
    if reason {
        emit_log(log::refused, begin_cell().store_slice(owner).store_coins(t).store_coins(v).store_coins(c).store_uint(reason, 8));
        builder cancel = begin_cell().store_uint(op::deposit_cancelled, 32).store_uint(query_id, 64);
        out(true, jwallet_address(owner), null(), cancel, release(), send::regular);
        refund(query_id, response, t, reason, has_options?, fwd, payload, true, release(), false);
        return ();
    }

    principal += c;
    tickets += c;
    int float_delta = 0;
    ;; the update gets the full headroom when the value allows, else what is left after deposit_booked's minimum
    int uv = min(update_value(), value_left(0) - booked_min(pcells, pbits));
    if has_position? {
        send_update(query_id, b, c, -1, uv);
    } else {
        b = next_position;
        next_position += 1;
        int opens = send_update(query_id, b, c, owner_hash(owner), uv);
        float_delta = fee::node_share - opens;
        ;; the forwarding of the top node's StateInit is paid from the balance (pay_gas_separately), so it is taken out of
        ;; the reserve: the float pays it, not the booked value, which a price step could leave short for its handler
        if b == 0 {
            float_delta -= fwd_node_deploy();
        }
    }
    emit_log(log::booking, begin_cell().store_slice(owner).store_slice(sender).store_uint(b, 32).store_coins(c).store_coins(t));

    ;; the owner goes last, where the wallet does not read: a bounce of deposit_booked is checked against it
    cell reply = begin_cell().store_slice(sender).store_slice(response).store_coins(fwd).store_maybe_ref(payload)
        .store_slice(owner).end_cell();
    builder booked = begin_cell()
        .store_uint(op::deposit_booked, 32)
        .store_uint(query_id, 64)
        .store_coins(c)
        .store_uint(b, 32)
        .store_ref(reply);
    send_rest(true, jwallet_address(owner), null(), booked, float_delta, 0);
}

;; w = min(floor(x·TT/TC), floor(F·x/P)): the min shares the loss pro-rata when the rate has fallen; otherwise the
;; first term is the smaller.
int tokens_for(int x, int tc, int tt) inline {
    if principal <= 0 {
        return 0;
    }
    int w = min(muldiv(x, tt, tc), muldiv(max(free_tokens(), 0), x, principal));
    return max(w, 0);
}

;;
;; withdrawals
;;

;; From the jGRAM wallet of `sender`, which has taken x from its balance. The withdrawal is paid here, at the stored
;; rate. The fee is checked first, before any state changes, and a short burn throws, so the burn bounces and the wallet
;; restores x. After that it never throws: not while halted, retired or falling, not in a draw. Every action carries
;; +16, so a failed action phase bounces the message and the wallet restores x.
() burn_notification(slice src, slice s) impure inline {
    act_flag = send::bounce_if_failed;
    int query_id = s~load_uint(64);
    int x = s~load_coins();
    slice owner = s~load_msg_addr();
    slice response = s~load_msg_addr();
    int last? = s~load_int(1);
    int b = s~load_uint(32);
    cell options = s~load_maybe_ref();
    ifnot base_addr?(owner) {
        return ();
    }
    ifnot is_jwallet_of?(src, owner) {
        return ();
    }

    int to_successor? = false;
    int fwd = 0;
    cell payload = null();
    if ~ options.null?() {
        slice os = options.begin_parse();
        os~skip_bits(32);
        to_successor? = os~load_int(1);
        fwd = os~load_coins();
        payload = os~load_maybe_ref();
    }
    if response.addr_none?() {
        response = owner;
    }

    ;; the fee check comes first, within bound::pre gas, before any state changes: a short burn throws and bounces, and
    ;; the wallet restores the balance. A rule for every future Jackpot: the wallet's frozen minimum pays no more.
    int pcells = 0;
    int pbits = 0;
    ifnot payload.null?() {
        ( pcells, pbits ) = payload_size(payload, max_payload_cells);
    }
    throw_unless(err::insufficient_fee, incoming_value() >= burn_arrives(fwd, pcells, pbits));

    tickets -= x;
    send_update(query_id, b, - x, -1, update_value());
    int spent = update_value() + (last? ? release() : 0);
    if last? {
        builder close = begin_cell().store_uint(op::close_wallet, 32).store_uint(query_id, 64);
        out(true, jwallet_address(owner), null(), close, release(), send::regular);
    }
    int w = tokens_for(x, quote_coins, quote_tokens);
    principal -= x;

    ( _, slice successor, int successor_fee, _ ) = unpack_retirement();
    int move? = to_successor? & (~ successor.addr_none?()) & (value_left(spent) >= successor_fee + fwd + payout_fee());
    emit_log(log::withdrawal, begin_cell().store_slice(owner).store_uint(b, 32).store_coins(x).store_coins(w)
        .store_int(last?, 1).store_int(move?, 1).store_uint(quote_coins, 128).store_uint(quote_tokens, 128));

    if w == 0 {
        send_excess(response, 0);
        return ();
    }
    if move? {
        ;; the successor books it for the owner; the options are built here, never named by the governor or a caller
        cell move_options = begin_cell()
            .store_uint(op::deposit_options, 32)
            .store_coins(max(x - x / 100 - 2, 1))
            .store_slice(owner)
            .store_slice(owner)
            .store_coins(fwd)
            .store_maybe_ref(payload)
            .end_cell();
        pay_rest(query_id, successor, response, w, successor_fee + fwd, move_options, 0, spent, 0, true);
        return ();
    }
    pay_rest(query_id, owner, response, w, fwd, payload, 0, spent, 0, false);
}

;;
;; boundaries
;;

;; Anyone may poke. The poke asks the treasury for a quote and carries its context in the quote's custom_payload.
() poke(slice src, slice s) impure inline {
    int query_id = s~load_uint(64);
    throw_unless(err::insufficient_fee, incoming_value() >= poke_fee());
    cell ctx = begin_cell().store_uint(3, 4).store_uint(now(), 32).store_slice(src).end_cell();
    builder body = begin_cell()
        .store_uint(op::provide_current_quote, 32)
        .store_uint(query_id, 64)
        .store_uint(1, 1)
        .store_ref(ctx);
    ;; the rest of the message rides on: the treasury replies with its remaining value
    out(true, treasury().to_builder(), null(), body, 0, send::remaining_value);
}

;; A refill's or a boundary's unstake: u leaves held_tokens at once, and unstaking_tokens counts it until Hipo
;; reports it back.
() send_unstake(int u) impure inline_ref {
    held_tokens -= u;
    unstaking_tokens += u;
    ( int last, int bc, int bt, int rise_min, int min_gap, int next_min_gap, _ ) = unpack_boundary();
    pack_boundary(last, bc, bt, rise_min, min_gap, next_min_gap, now());

    builder body = begin_cell()
        .store_uint(op::unstake_tokens, 32)
        .store_uint(new_query_id(), 64)
        .store_coins(u)
        .store_uint(0, 2) ;; return_excess: addr_none, which Hipo reads as the owner
        .store_uint(0, 1); ;; no custom_payload: mode auto
    out(true, wallet.to_builder(), null(), body, unstake_run(), send::regular);
    emit_log(log::unstake, begin_cell().store_coins(u).store_coins(unstaking_tokens).store_coins(bal0));
}

;; The boundary's own work, in the transaction of the reply: it ends a resolving draw, or skips a waiting one, or
;; takes a snapshot and sets a pot aside. Returns what the float pays for it: the gas it used, priced, and the
;; unstake's fee.
int boundary_work(int tc, int tt) impure inline_ref {
    int g0 = gas_consumed();
    set_gas_limit(min(g0 + fee::boundary_max + 30000, 1000000));

    ( int seqno, int hash ) = newest_mc_block();
    int round = quicknet_round_at(now() + drand_delay);
    int unstake_paid = 0;
    ( int last, int bc, int bt, int rise_min, int min_gap, int next_min_gap, _ ) = unpack_boundary();
    int time = now();
    mc_hash = hash;

    if draw_state == draw::waiting {
        ;; a skip: the draw keeps its snapshot, its tag and its pot, and waits for the new boundary's round
        emit_log(log::skip, begin_cell().store_uint(tag, 32).store_uint(time, 32).store_uint(tc, 128).store_uint(tt, 128)
            .store_coins(reserved_tokens).store_uint(round, 64).store_uint(seqno, 32).store_uint(hash, 256));
    } else {
        if draw_state == draw::resolving {
            ;; every open slot rolls over, and the draw ends
            int slot = 0;
            repeat (3) {
                if slot_open?(slot) {
                    log_slot(slot, attempt(slot), slot::expired, 0, 0, prize(slot), addr_none());
                    roll_back(slot);
                }
                slot += 1;
            }
            draw_state = draw::none;
            slots = 0;
        }
        tag += 1;
        snapshot_tickets = tickets;
        seed = 0;
        slots = 0;
        ( int b_share, int min_pot, _, _ ) = unpack_params();
        ( int pot, _ ) = pot_at(tc, tt);
        int carried_before = carried;
        int burn = 0;
        int u = 0;
        builder draw_ref = null();
        if (snapshot_tickets > 0) & (pot >= min_pot) {
            if (bal0 >= unstake_run()) & (bal0 < float::low) & unstake_allowed?() {
                u = unstake_amount(pot, tc, tt);
            }
            int pot2 = pot - u;
            burn = muldiv(max(pot2 - carried, 0), b_share, basis_points);
            int rest = pot2 - burn;
            int p0 = muldiv(rest, share::first, basis_points);
            int p1 = muldiv(rest, share::second, basis_points);
            int p2 = rest - p0 - p1;
            if u > 0 {
                send_unstake(u);
                unstake_paid = unstake_run();
            }
            reserved_tokens += pot2;
            burn_owed += burn;
            carried = 0;
            pack_misc(p0, p1, p2);
            draw_state = draw::waiting;
            draw_ref = begin_cell().store_coins(p0).store_coins(p1).store_coins(p2).store_uint(round, 64)
                .store_uint(seqno, 32).store_uint(hash, 256);
        }
        builder log = begin_cell()
            .store_uint(tag, 32)
            .store_uint(time, 32)
            .store_uint(tc, 128)
            .store_uint(tt, 128)
            .store_coins(snapshot_tickets)
            .store_coins(pot)
            .store_coins(burn)
            .store_coins(carried_before)
            .store_coins(u);
        if draw_ref.null?() {
            log = log.store_uint(0, 1);
        } else {
            log = log.store_uint(1, 1).store_ref(draw_ref.end_cell());
        }
        emit_log(log::boundary, log);
    }

    ;; in every case: the boundary's time and rate, the settings, the unstake time kept by send_unstake
    ( _, _, _, _, _, _, int last_unstake ) = unpack_boundary();
    pack_boundary(time, tc, tt, rise_min, next_min_gap != 0 ? next_min_gap : min_gap, 0, last_unstake);

    int g1 = gas_consumed();
    return get_gas_fee(g1 - g0, 0) + unstake_paid;
}

;; The treasury's reply to a poke. It never throws: it is not bounceable, so a throw would lose it. It stores the rate
;; and, when the rate rose enough since the last boundary and enough time has passed, makes a boundary.
() take_current_quote(slice src, slice s) impure inline {
    ifnot equal_slice_bits(src, treasury()) {
        return ();
    }

    s~load_uint(64);
    int tc = s~load_uint(128);
    int tt = s~load_uint(128);
    ifnot s~load_uint(1) {
        return ();
    }
    if s.slice_refs() == 0 {
        return ();
    }
    slice ctx = s~load_ref().begin_parse();
    if ctx~load_uint(4) != 3 {
        return ();
    }
    ctx~skip_bits(32);
    slice poker = ctx~load_msg_addr();

    if (tc == 0) | (tt == 0) {
        send_excess(poker, 0); ;; not a rate; the stored one is kept
        return ();
    }

    ;; a lower rate is the truth, and is stored; the flag holds back what the old rate promised
    if (quote_tokens > 0) & (tc * quote_tokens < quote_coins * tt) {
        falling? = true;
    }
    quote_coins = tc;
    quote_tokens = tt;

    ( int last, int bc, int bt, int rise_min, int min_gap, _, _ ) = unpack_boundary();
    int boundary? = (tc * bt >= muldivc(bc * tt, ppm + rise_min, ppm)) & (now() >= last + min_gap) & (~ falling?) & (~ halted?);
    int float_delta = 0;
    if boundary? {
        float_delta = - boundary_work(tc, tt);
    }
    send_excess(poker, float_delta);
}

;;
;; the draw
;;

() send_descend(int slot, int j) impure inline_ref {
    int k = position(slot, j);
    builder body = begin_cell()
        .store_uint(op::descend, 32)
        .store_uint(0, 64)
        .store_uint(tag, 32)
        .store_uint(slot, 8)
        .store_uint(j, 8)
        .store_uint(k, 128)
        .store_uint(k, 128); ;; the offset inside the top node
    builder top = create_address(chain::base, node_hash(tree::levels, 0));
    out(false, top, null(), body, fee::search, send::regular);
}

;; Anyone may submit the drand round the waiting draw is for. Cheapest checks first.
() submit_randomness(slice src, slice s) impure inline {
    s~load_uint(64);
    slice signature = s~load_ref().begin_parse();
    slice witness = s~load_ref().begin_parse();
    s.end_parse();

    ( int last, _, _, _, int min_gap, _, _ ) = unpack_boundary();
    throw_unless(err::insufficient_fee, incoming_value() >= submit_fee());
    throw_unless(err::not_waiting_for_randomness, draw_state == draw::waiting);
    throw_unless(err::too_late, now() < last + min_gap - submit_cutoff);
    throw_if(err::halted, halted?);
    throw_if(err::rate_falling, falling?);
    throw_unless(err::float_too_low, bal0 >= fee::draw_budget);

    ;; throws unless drand quicknet signed R, so a bad submission is paid by its sender
    int round = quicknet_round_at(last + drand_delay);
    quicknet_verify(round, signature, witness);
    ;; the seed mixes in the block hash fixed at the boundary
    seed = begin_cell().store_slice(signature).store_uint(mc_hash, 256).sha256_builder();
    draw_state = draw::resolving;
    slots = 7; ;; all open, every attempt 0

    emit_log(log::randomness, begin_cell().store_uint(tag, 32).store_uint(round, 64).store_uint(seed, 256));

    send_descend(0, 0);
    send_descend(1, 0);
    send_descend(2, 0);
    ;; the submitter gets the rest of its value and the reward, once per draw; the float pays the reward and the searches
    send_excess(src, - reward::submit - 3 * fee::search);
}

;; Anyone may restore a float that has fallen below what a draw needs. Only in a quiet state. It asks for no quote:
;; u is computed at the stored rate.
() refill(slice src, slice s) impure inline {
    s~load_uint(64);
    throw_unless(err::insufficient_fee, incoming_value() >= refill_fee());
    throw_unless(err::refill_not_needed, bal0 < fee::draw_budget);
    throw_unless(err::refill_not_needed, (draw_state == draw::none) | (draw_state == draw::waiting));
    throw_unless(err::refill_not_needed, unstake_allowed?());

    ( int pot, _ ) = pot_at(quote_coins, quote_tokens);
    int u = 0;
    if ~ falling? {
        u = unstake_amount(pot, quote_coins, quote_tokens);
    }
    if u > 0 {
        send_unstake(u);
    }
    send_excess(src, 0);
}

;; Shared by hit, miss and lost: the reply answers the current attempt of an open slot of this snapshot, about the
;; position the Jackpot itself chose.
int current_reply?(int reply_tag, int slot, int j, int k) inline {
    if (draw_state != draw::resolving) | (reply_tag != tag) | (slot >= 3) {
        return false;
    }
    ifnot slot_open?(slot) {
        return false;
    }
    return (j == attempt(slot)) & (k == position(slot, j));
}

() send_next_search(int slot, int j) impure inline {
    send_descend(slot, j);
}

;; A miss or a lost descent: the slot moves to its next attempt, and after A of them its prize rolls over.
() next_attempt(int slot, int j, int k, int b, int result) impure inline {
    slots += 1 << (8 + 8 * slot);
    log_slot(slot, j, result, k, b, 0, addr_none());
    if j + 1 < attempts_per_slot {
        send_next_search(slot, j + 1);
        return ();
    }
    log_slot(slot, j, slot::rolled_over, k, b, prize(slot), addr_none());
    roll_back(slot);
    close_slot(slot);
}

;; Never throws.
() hit(slice src, slice s) impure inline {
    s~load_uint(64);
    int reply_tag = s~load_uint(32);
    int slot = s~load_uint(8);
    int j = s~load_uint(8);
    int k = s~load_uint(128);
    int b = s~load_uint(32);
    slice owner = s~load_msg_addr();

    ifnot current_reply?(reply_tag, slot, j, k) {
        return ();
    }
    ifnot is_node?(src, 1, b >> tree::bits) {
        return ();
    }

    int amount = prize(slot);
    if falling? {
        ;; the prize was priced at a rate that no longer holds: it goes back into free_tokens
        log_slot(slot, j, slot::returned, k, b, amount, owner);
        roll_back(slot);
    } else {
        reserved_tokens -= amount;
        pay_float(owner, amount, fee::prize_notify, prize_comment(slot));
        log_slot(slot, j, slot::hit, k, b, amount, owner);
    }
    close_slot(slot);
}

;; Never throws.
() miss(slice src, slice s) impure inline {
    s~load_uint(64);
    int reply_tag = s~load_uint(32);
    int slot = s~load_uint(8);
    int j = s~load_uint(8);
    int k = s~load_uint(128);
    int b = s~load_uint(32);

    ifnot current_reply?(reply_tag, slot, j, k) {
        return ();
    }
    ifnot is_node?(src, 1, b >> tree::bits) {
        return ();
    }
    next_attempt(slot, j, k, b, slot::miss);
}

;; Never throws. A node found no child covering the position, which cannot happen while the sums agree.
() lost(slice src, slice s) impure inline {
    s~load_uint(64);
    int reply_tag = s~load_uint(32);
    int slot = s~load_uint(8);
    int j = s~load_uint(8);
    int k = s~load_uint(128);
    int level = s~load_uint(8);
    int index = s~load_uint(32);

    ifnot current_reply?(reply_tag, slot, j, k) {
        return ();
    }
    if (level < 1) | (level > tree::levels) {
        return ();
    }
    ifnot is_node?(src, level, index) {
        return ();
    }
    next_attempt(slot, j, k, index, slot::lost); ;; the log names the node's index
}

;; Never throws. From the Jackpot's hGRAM wallet only: Hipo burned what was unstaked, now or rounds later. It is
;; matched by sender and never by query_id, because a bill's burn carries someone else's. The GRAM stays in the float.
() withdrawal_notification(slice src, slice s) impure inline {
    ifnot equal_slice_bits(src, wallet) {
        return ();
    }
    s~load_uint(64);
    int amount = s~load_coins();
    unstaking_tokens = max(unstaking_tokens - amount, 0);
}

;; Never throws. A bounce is recognised by the bounced flag, which only the network sets, and read in its new,
;; full-body format; an old-format bounce answers nothing the Jackpot sends and is ignored.
() on_bounce(slice src, slice s) impure inline {
    if (s.slice_bits() < 32) | (s~load_uint(32) != bounce::new) {
        return ();
    }
    slice o = s~load_ref().begin_parse();
    int op = o~load_uint(32);
    int query_id = o~load_uint(64);

    if (op == op::provide_current_quote) & equal_slice_bits(src, treasury()) {
        ;; a poke whose quote request bounced: the rest goes back to the poker
        if o~load_uint(1) {
            slice ctx = o~load_ref().begin_parse();
            ctx~skip_bits(4 + 32);
            send_excess(ctx~load_msg_addr(), 0);
        }
        return ();
    }

    if op == op::unstake_tokens {
        ifnot equal_slice_bits(src, wallet) {
            return ();
        }
        ;; the wallet refused it: the tokens never left, so they are the Jackpot's again
        int u = o~load_coins();
        held_tokens += u;
        unstaking_tokens = max(unstaking_tokens - u, 0);
        return ();
    }

    if op == op::prepare_deposit {
        ;; the wallet is frozen, or could not answer: the tokens go back to the response destination
        ( _, int t, int has_options?, _, int fwd, cell payload, slice owner, _, slice response ) = unpack_context(o~load_ref());
        ifnot is_jwallet_of?(src, owner) {
            return ();
        }
        incoming_tokens -= t;
        refund(query_id, response, t, reason::wallet_unavailable, has_options?, fwd, payload, true, 0, false);
        return ();
    }

    if op == op::deposit_booked {
        ;; Cannot happen for a wallet that just answered. If it does, the booking is undone: the principal leaves
        ;; and the tokens it was worth at the stored rate go back to the response destination; the entry price stays.
        int c = o~load_coins();
        int b = o~load_uint(32);
        slice reply = o~load_ref().begin_parse();
        reply~load_msg_addr(); ;; the depositor
        slice response = reply~load_msg_addr();
        int fwd = reply~load_coins();
        cell payload = reply~load_maybe_ref();
        slice booked_owner = reply~load_msg_addr();
        ;; only a bounce from the owner's own jGRAM wallet is an undo
        ifnot is_jwallet_of?(src, booked_owner) {
            return ();
        }
        if (c > principal) | (c > tickets) | (b >= next_position) {
            return ();
        }
        ;; the undo always commits, even on a bounce that carries little: it raises its own gas limit to a fixed bound, paid
        ;; by the float, and sends its update and the cancel with explicit values out of the balance
        set_gas_limit(bound::jackpot);
        int w = tokens_for(c, quote_coins, quote_tokens);
        principal -= c;
        tickets -= c;
        send_update(query_id, b, - c, -1, update_value());
        emit_log(log::booking_undone, begin_cell().store_uint(b, 32).store_coins(c).store_coins(w));
        builder cancel = begin_cell().store_uint(op::deposit_cancelled, 32).store_uint(query_id, 64);
        out(true, src.to_builder(), null(), cancel, release(), send::regular);
        refund(query_id, response, w, reason::wallet_unavailable, (fwd > 0) | (~ payload.null?()), fwd, payload, true, update_value() + release(), true);
        return ();
    }

    ;; anything else is only GRAM coming back
}

;;
;; comments, TEP-89, retirement
;;

cell withdrawal_comment() inline {
    return comment_cell("Hipo Jackpot withdrawal");
}

;; The burn the Jackpot sends a wallet for a `w` or a withdraw_for: all of it, paid by the Jackpot's own pay step.
builder all_burn_body(int query_id, int to_successor?, int move?) inline_ref {
    ;; move? (computed once by the caller): the governor's move says so only when there is a successor to move to
    cell options = begin_cell()
        .store_uint(op::withdraw_options, 32)
        .store_int(to_successor?, 1)
        .store_coins(1)
        .store_maybe_ref(move? ? comment_cell("Hipo Jackpot: moved") : withdrawal_comment())
        .end_cell();
    return begin_cell()
        .store_uint(op::burn, 32)
        .store_uint(query_id, 64)
        .store_coins(0)
        .store_uint(0, 2)
        .store_maybe_ref(options);
}

;; The wallet's StateInit goes with it, so that a `w` from someone with no wallet deploys one that returns the value.
() send_all_burn(slice owner, int query_id, int to_successor?, int move?, int coins, int mode) impure inline_ref {
    builder init = create_state_init(wallet_code(), create_jwallet_data(my_address(), owner));
    out(true, jwallet_address(owner), init, all_burn_body(query_id, to_successor?, move?), coins, mode);
}

;; A plain message with a text body: only `w` is a command.
() comment_message(slice src, slice s) impure inline {
    ;; the sender has been checked by the caller to be a basechain address
    int len = s.slice_bits();
    if len == 0 {
        return (); ;; an empty comment is a top-up
    }
    throw_unless(err::bad_comment, (len == 8) & ((s.preload_uint(8) == 119) | (s.preload_uint(8) == 87)) & (s.slice_refs() == 0));
    act_flag = send::bounce_if_failed;
    throw_unless(err::insufficient_fee, incoming_value() >= w_fee());
    throw_unless(err::invalid_parameters, base_addr?(src));
    send_all_burn(src, 0, false, false, 0, send::remaining_value);
}

;; The jetton master's TEP-89 reply. It changes no state.
() provide_wallet_address(slice src, slice s) impure inline {
    int query_id = s~load_uint(64);
    slice owner = s~load_msg_addr();
    int include? = s~load_int(1);
    throw_unless(err::insufficient_fee, incoming_value() >= tep89_fee());
    builder body = begin_cell().store_uint(op::take_wallet_address, 32).store_uint(query_id, 64);
    if base_addr?(owner) {
        body = body.store_slice(jwallet_address(owner).end_cell().begin_parse());
    } else {
        body = body.store_uint(0, 2);
    }
    if include? {
        body = body.store_uint(1, 1).store_ref(begin_cell().store_slice(owner).end_cell());
    } else {
        body = body.store_uint(0, 1);
    }
    out(true, src.to_builder(), null(), body, 0, send::remaining_value);
}

() require_governor(slice src) impure inline {
    throw_unless(err::access_denied, equal_slice_bits(src, governor()));
}

() retire(slice src, slice s) impure inline {
    s~load_uint(64);
    s.end_parse();
    require_governor(src);
    ( _, slice successor, int fee, int done? ) = unpack_retirement();
    pack_retirement(true, successor, fee, done?);
    emit_log(log::retired, begin_cell());
}

() set_successor(slice src, slice s) impure inline {
    s~load_uint(64);
    slice successor = s~load_msg_addr();
    int fee = s~load_coins();
    s.end_parse();
    require_governor(src);
    throw_unless(err::not_retired, retired?());
    throw_unless(err::invalid_parameters, successor.addr_none?() | (base_addr?(successor) & (~ equal_slice_bits(successor, my_address()))));
    pack_retirement(true, successor, fee, swept?());
    emit_log(log::successor, begin_cell().store_slice(successor).store_coins(fee));
}

;; Sends the `w` burn to each owner listed, up to max_withdraw_for. The governor pays; what each does not spend goes
;; to the owner, and what is above the total comes back to the governor.
() withdraw_for(slice src, slice s) impure inline {
    act_flag = send::bounce_if_failed;
    int query_id = s~load_uint(64);
    int to_successor? = s~load_int(1);
    cell owners = s~load_ref();
    int value_per_owner = s~load_coins();
    s.end_parse();
    require_governor(src);
    throw_unless(err::not_retired, retired?());
    ( _, slice successor, int successor_fee, _ ) = unpack_retirement();
    int move? = to_successor? & (~ successor.addr_none?());
    ;; what each owner's wallet is sent, computed once; the Jackpot's own gas is priced on what it has used
    int per = value_per_owner;
    throw_unless(err::insufficient_fee, per >= w_value() + (to_successor? ? successor_fee : 0));

    int n = 0;
    cell c = owners;
    while ~ c.null?() {
        slice cs = c.begin_parse();
        while cs.slice_bits() >= 256 {
            int h = cs~load_uint(256);
            n += 1;
            throw_unless(err::too_many_owners, n <= max_withdraw_for);
            slice owner = create_address(chain::base, h).end_cell().begin_parse();
            send_all_burn(owner, query_id, to_successor?, move?, per, send::regular);
        }
        c = cs.slice_refs() ? cs~load_ref() : null();
    }
    throw_unless(err::insufficient_fee, (n > 0) & (incoming_value() >= n * per + gas_fee(gas_consumed() + 10000)));
    send_excess(src, 0);
}

() send_close_node(builder dst, int query_id, int coins, int mode) impure inline_ref {
    builder body = begin_cell().store_uint(op::close_node, 32).store_uint(query_id, 64).store_uint(next_position, 32);
    out(false, dst, null(), body, coins, mode);
}

;; Ends a retired Jackpot: the draw if it still waits, the rest to the burner, the tree from the top down.
() sweep(slice src, slice s) impure inline {
    act_flag = send::bounce_if_failed;
    int query_id = s~load_uint(64);
    ;; the sender pays for the whole cascade; the float changes by 0 for it
    int cost = close_cost(next_position);
    throw_unless(err::insufficient_fee, incoming_value() >= fee::sweep + cost);
    throw_unless(err::cannot_sweep, retired?() & (~ swept?()) & (principal == 0) & (incoming_tokens == 0)
        & (unstaking_tokens == 0) & (draw_state != draw::resolving));
    ;; a waiting draw has no ticket left in its snapshot: its prizes go back and it ends
    if draw_state == draw::waiting {
        int slot = 0;
        repeat (3) {
            roll_back(slot);
            slot += 1;
        }
        draw_state = draw::none;
        slots = 0;
    }
    int amount = held_tokens;
    if amount > 0 {
        ( slice burner, _, _ ) = unpack_roles();
        held_tokens = 0;
        out(false, wallet.to_builder(), null(),
            transfer_body(new_query_id(), amount, burner, my_address(), fee::burn_forward, null()),
            fee::payout + fee::burn_forward, send::regular);
    }
    reserved_tokens = 0;
    burn_owed = 0;
    carried = 0;
    ( _, slice successor, int fee, _ ) = unpack_retirement();
    pack_retirement(true, successor, fee, true);
    emit_log(log::swept, begin_cell().store_coins(amount).store_uint(next_position, 32));
    ;; with no position ever assigned the top node was never deployed: nothing to close
    if next_position > 0 {
        send_close_node(create_address(chain::base, node_hash(tree::levels, 0)), query_id, cost, send::regular);
    }
    send_excess(src, 0);
}

;; After the sweep only: restarts the close at one node the cascade left behind, on the sender's value (the subtree's
;; cost times the margin). The governor closes only the highest nodes still standing.
() close_subtree(slice src, slice s) impure inline {
    int query_id = s~load_uint(64);
    int level = s~load_uint(8);
    int index = s~load_uint(32);
    s.end_parse();
    require_governor(src);
    throw_unless(err::not_swept, swept?());
    throw_unless(err::invalid_parameters, (level >= 1) & (level <= tree::levels));
    ;; a node whose first position is at or past next_position was never deployed
    throw_unless(err::invalid_parameters, (index << (tree::bits * level)) < next_position);
    int cost = close_cost_at(level, index, next_position);
    throw_unless(err::insufficient_fee, incoming_value() >= cost + fee::handler);
    send_close_node(create_address(chain::base, node_hash(level, index)), query_id, cost, send::regular);
    send_excess(src, 0);
}

() migrate(int old_tag, int old_draw_state) impure method_id {
    load_data();
    throw_unless(err::draw_changed, (tag >= old_tag) & (draw_state == old_draw_state));
    save_data();
    throw(0);
}

() upgrade_code(slice src, slice s) impure inline {
    s~load_uint(64);
    cell new_code = s~load_ref();
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));

    ;; The stored data is saved first: migrate reads it, and must find the tag and the draw state it is told to keep.
    save_data();
    set_code(new_code);
    set_c3(new_code.begin_parse().bless());
    migrate(tag, draw_state);
}

;; Follows a Hipo wallet migration: the parent, the wallet code and the Jackpot's own wallet change
;; together.
() set_hipo_wallet(slice src, slice s) impure inline {
    s~load_uint(64);
    slice new_parent = s~load_msg_addr();
    slice new_wallet = s~load_msg_addr();
    cell new_wallet_code = s~load_ref();
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));
    ;; only for a change that keeps one token worth the same, with the Jackpot halted; basechain addr_std, no anycast
    throw_unless(err::invalid_parameters, halted? & base_addr?(new_parent) & base_addr?(new_wallet));

    set_address_ref(2, begin_cell().store_slice(new_parent).store_ref(new_wallet_code).end_cell());
    wallet = new_wallet;
    emit_log(log::hipo_wallet, begin_cell().store_slice(new_parent).store_slice(new_wallet));
}

() set_treasury(slice src, slice s) impure inline {
    s~load_uint(64);
    slice new_treasury = s~load_msg_addr();
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));
    throw_unless(err::invalid_parameters, halted? & base_addr?(new_treasury));

    slice as = addresses.begin_parse();
    as~load_msg_addr();
    addresses = begin_cell().store_slice(new_treasury).store_slice(as).end_cell();
    emit_log(log::treasury, begin_cell().store_slice(new_treasury));
}

;; A TEP-74 transfer from a jetton wallet the Jackpot owns, on the governor's value. The hGRAM wallet is refused,
;; matched by parsed workchain and hash: hGRAM inside the count goes back only through return_tokens. An old hGRAM
;; wallet can be named.
() rescue_jetton(slice src, slice s) impure inline {
    int query_id = s~load_uint(64);
    slice jetton_wallet = s~load_msg_addr();
    int amount = s~load_coins();
    slice destination = s~load_msg_addr();
    s.end_parse();

    require_governor(src);
    throw_unless(err::invalid_parameters, base_addr?(jetton_wallet) & base_addr?(destination));
    ( int wc, int hash ) = parse_std_addr(jetton_wallet);
    ( int hwc, int hhash ) = parse_std_addr(wallet);
    throw_if(err::invalid_parameters, (wc == hwc) & (hash == hhash));
    throw_unless(err::insufficient_fee, incoming_value() >= fee::foreign_return);
    send_rest(true, jetton_wallet.to_builder(), null(), transfer_body(query_id, amount, destination, src, 0, null()), 0, 0);
}

;; A TEP-62 transfer of an NFT item the Jackpot owns, on the governor's value.
() rescue_nft(slice src, slice s) impure inline {
    int query_id = s~load_uint(64);
    slice nft = s~load_msg_addr();
    slice destination = s~load_msg_addr();
    s.end_parse();

    require_governor(src);
    throw_unless(err::invalid_parameters, base_addr?(nft) & base_addr?(destination));
    throw_unless(err::insufficient_fee, incoming_value() >= fee::foreign_return);
    send_rest(true, nft.to_builder(), null(), nft_transfer_body(query_id, destination, src, 0, null()), 0, 0);
}

;; Returns hGRAM that reached the wallet without a notification, or was held there. The tokens are
;; outside T, so they enter T and leave it as a recorded payout.
;; Returns hGRAM that reached the wallet without a notification, or was held there. With in_flight false the tokens
;; enter the count here; with it true they are still counted as incoming, and leave that count.
() return_tokens(slice src, slice s) impure inline {
    s~load_uint(64);
    slice owner = s~load_msg_addr();
    int amount = s~load_coins();
    int in_flight? = s~load_int(1);
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));
    throw_unless(err::insufficient_fee, incoming_value() >= fee::return);
    throw_unless(err::invalid_parameters, amount > 0);

    if in_flight? {
        throw_unless(err::invalid_parameters, amount <= incoming_tokens);
        incoming_tokens -= amount;
    } else {
        held_tokens += amount;
    }
    pay_rest(0, owner, owner, amount, 0, null(), 0, 0, 0, false);
}

;; After a rollback at Hipo, whose only signal is a gas_excess anyone can forge: the governor checks the
;; wallet and says how much came back. With credit it returns to held_tokens and leaves unstaking_tokens; without, it
;; only leaves unstaking_tokens, for an unstake whose GRAM arrived but whose notification was missed.
() settle_unstake(slice src, slice s) impure inline {
    s~load_uint(64);
    int amount = s~load_coins();
    int credit? = s~load_int(1);
    s.end_parse();

    require_governor(src);
    throw_unless(err::invalid_parameters, (amount > 0) & (amount <= unstaking_tokens));

    unstaking_tokens -= amount;
    if credit? {
        held_tokens += amount;
    }
}

() set_rise_min(slice src, slice s) impure inline {
    s~load_uint(64);
    int new_rise_min = s~load_uint(32);
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));
    throw_unless(err::invalid_parameters, (new_rise_min >= min_rise_min) & (new_rise_min <= max_rise_min));

    ( int last, int bc, int bt, _, int min_gap, int next_min_gap, int last_unstake ) = unpack_boundary();
    pack_boundary(last, bc, bt, new_rise_min, min_gap, next_min_gap, last_unstake);
    emit_log(log::settings, begin_cell().store_uint(new_rise_min, 32).store_uint(min_gap, 32).store_uint(next_min_gap, 32));
}

;; Takes effect at the next boundary, which checks its own rule with the old value.
() set_min_gap(slice src, slice s) impure inline {
    s~load_uint(64);
    int new_min_gap = s~load_uint(32);
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));
    throw_unless(err::invalid_parameters, (new_min_gap >= min_min_gap) & (new_min_gap <= max_min_gap));

    ( int last, int bc, int bt, int rise_min, int min_gap, _, int last_unstake ) = unpack_boundary();
    pack_boundary(last, bc, bt, rise_min, min_gap, new_min_gap, last_unstake);
    emit_log(log::settings, begin_cell().store_uint(rise_min, 32).store_uint(min_gap, 32).store_uint(new_min_gap, 32));
}

;; Also resets the boundary rate, so a cleared fall does not hold boundaries back until the rate passes its old level.
() clear_falling(slice src, slice s) impure inline {
    s~load_uint(64);
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));

    falling? = false;
    ( int last, _, _, int rise_min, int min_gap, int next_min_gap, int last_unstake ) = unpack_boundary();
    pack_boundary(last, quote_coins, quote_tokens, rise_min, min_gap, next_min_gap, last_unstake);
}

() set_burn_share(slice src, slice s) impure inline {
    s~load_uint(64);
    int new_b_share = s~load_uint(16);
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));
    throw_unless(err::invalid_parameters, new_b_share <= max_burn_share);

    ( _, int min_pot, int burn_batch, int min_deposit ) = unpack_params();
    pack_params(new_b_share, min_pot, burn_batch, min_deposit);
}

() set_min_pot(slice src, slice s) impure inline {
    s~load_uint(64);
    int new_min_pot = s~load_coins();
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));

    ( int b_share, _, int burn_batch, int min_deposit ) = unpack_params();
    pack_params(b_share, new_min_pot, burn_batch, min_deposit);
}

() set_burn_batch(slice src, slice s) impure inline {
    s~load_uint(64);
    int new_burn_batch = s~load_coins();
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));

    ( int b_share, int min_pot, _, int min_deposit ) = unpack_params();
    pack_params(b_share, min_pot, new_burn_batch, min_deposit);
}

() set_min_deposit(slice src, slice s) impure inline {
    s~load_uint(64);
    int new_min_deposit = s~load_coins();
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));
    ;; at least 1, so that no booking ever opens an empty position
    throw_unless(err::invalid_parameters, new_min_deposit >= 1);

    ( int b_share, int min_pot, int burn_batch, _ ) = unpack_params();
    pack_params(b_share, min_pot, burn_batch, new_min_deposit);
}

;; The jetton's TEP-64 metadata: the governor replaces it whole.
() set_content(slice src, slice s) impure inline {
    s~load_uint(64);
    cell new_content = s~load_ref();
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));

    content = new_content;
}

() set_halter(slice src, slice s) impure inline {
    s~load_uint(64);
    slice new_halter = s~load_msg_addr();
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));

    ( slice burner, slice governor, _ ) = unpack_roles();
    set_address_ref(3, begin_cell().store_slice(burner).store_slice(governor).store_slice(new_halter).end_cell());
}

;; The halter can only stop; resuming is the governor's.
() set_halted(slice src, slice s) impure inline {
    s~load_uint(64);
    int new_halted? = s~load_int(1);
    s.end_parse();

    ( _, slice governor, slice halter ) = unpack_roles();
    int governor? = equal_slice_bits(src, governor);
    int halter? = equal_slice_bits(src, halter);
    throw_unless(err::access_denied, governor? | (halter? & new_halted?));

    halted? = new_halted?;
}

;; The node float: each new position's node share, less the nodes it has opened so far. It follows from n
;; alone: positions 0 .. n-1 have opened ceil(n / 64^ℓ) nodes at each level ℓ. The first node of each
;; level was paid from the deploy float, so only max(ceil(n / 64^ℓ) − 1, 0) nodes are counted per level.
int node_float() inline {
    int float = next_position * fee::node_share;
    int shift = tree::bits;
    repeat (tree::levels) {
        float -= max(((next_position + (1 << shift) - 1) >> shift) - 1, 0) * fee::node_open;
        shift += tree::bits;
    }
    return float;
}

;; Everything above the float's target G_hi and the node float. GRAM some chain in flight still needs then
;; comes out of the target, which is sized for it.
() withdraw_surplus(slice src, slice s) impure inline {
    int query_id = s~load_uint(64);
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));

    raw_reserve(swept?() ? float::after_end : float::high + max(node_float(), 0), reserve::at_most);
    builder excess = begin_cell()
        .store_uint(op::gas_excess, 32)
        .store_uint(query_id, 64);
    send_msg(false, governor().to_builder(), null(), excess, 0, send::unreserved_balance + send::ignore_errors);
}

;;
;; routing
;;

() route_internal_message(int flags, slice src, slice s) impure inline {
    if flags & 1 {
        return on_bounce(src, s);
    }

    if s.slice_bits() < 32 {
        return (); ;; plain GRAM: a top-up
    }

    int op = s~load_uint(32);

    if op == 0 {
        return comment_message(src, s);
    }
    if op == op::transfer_notification {
        return transfer_notification(src, s);
    }
    if op == op::ownership_assigned {
        return ownership_assigned(src, s);
    }
    if op == op::take_current_quote {
        return take_current_quote(src, s);
    }
    if op == op::gas_excess {
        return (); ;; ignored: payouts are unconfirmed
    }
    if op == op::withdrawal_notification {
        return withdrawal_notification(src, s);
    }
    if op == op::poke {
        return poke(src, s);
    }
    if op == op::deposit_ready {
        return deposit_ready(src, s);
    }
    if op == op::burn_notification {
        return burn_notification(src, s);
    }
    if op == op::hit {
        return hit(src, s);
    }
    if op == op::miss {
        return miss(src, s);
    }
    if op == op::lost {
        return lost(src, s);
    }
    if op == op::submit_randomness {
        return submit_randomness(src, s);
    }
    if op == op::refill {
        return refill(src, s);
    }
    if op == op::provide_wallet_address {
        return provide_wallet_address(src, s);
    }
    if op == op::sweep {
        return sweep(src, s);
    }
    if op == op::top_up {
        return ();
    }
    if op == op::upgrade_code {
        return upgrade_code(src, s);
    }
    if op == op::set_hipo_wallet {
        return set_hipo_wallet(src, s);
    }
    if op == op::set_treasury {
        return set_treasury(src, s);
    }
    if op == op::rescue_jetton {
        return rescue_jetton(src, s);
    }
    if op == op::rescue_nft {
        return rescue_nft(src, s);
    }
    if op == op::return_tokens {
        return return_tokens(src, s);
    }
    if op == op::settle_unstake {
        return settle_unstake(src, s);
    }
    if op == op::set_burn_share {
        return set_burn_share(src, s);
    }
    if op == op::set_min_pot {
        return set_min_pot(src, s);
    }
    if op == op::set_burn_batch {
        return set_burn_batch(src, s);
    }
    if op == op::set_min_deposit {
        return set_min_deposit(src, s);
    }
    if op == op::set_rise_min {
        return set_rise_min(src, s);
    }
    if op == op::set_min_gap {
        return set_min_gap(src, s);
    }
    if op == op::set_content {
        return set_content(src, s);
    }
    if op == op::set_halter {
        return set_halter(src, s);
    }
    if op == op::set_halted {
        return set_halted(src, s);
    }
    if op == op::clear_falling {
        return clear_falling(src, s);
    }
    if op == op::withdraw_surplus {
        return withdraw_surplus(src, s);
    }
    if op == op::retire {
        return retire(src, s);
    }
    if op == op::set_successor {
        return set_successor(src, s);
    }
    if op == op::withdraw_for {
        return withdraw_for(src, s);
    }
    if op == op::close_subtree {
        return close_subtree(src, s);
    }

    throw(err::invalid_op);
}

;; The deploy data (version 0) is checked once, on the first message: the same bounds as the setters.
() deploy() impure inline {
    ( int b_share, _, _, int min_deposit ) = unpack_params();
    ( _, int bc, int bt, int rise_min, int min_gap, _, _ ) = unpack_boundary();
    throw_unless(err::invalid_parameters, (b_share <= max_burn_share) & (min_deposit >= 1));
    throw_unless(err::invalid_parameters, (rise_min >= min_rise_min) & (rise_min <= max_rise_min)
        & (min_gap >= min_min_gap) & (min_gap <= max_min_gap));
    throw_unless(err::invalid_parameters, (quote_coins > 0) & (quote_tokens > 0) & (bc > 0) & (bt > 0));
}

() recv_internal(cell in_msg_full, slice s) impure {
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    slice src = cs~load_msg_addr();

    int version = get_data().begin_parse().preload_uint(8);
    ;; a plain top-up touches nothing
    if (version == storage_version) & ((flags & 1) == 0) {
        if s.slice_bits() < 32 {
            return ();
        }
        int first = s.preload_uint(32);
        if (first == op::top_up) | (first == op::gas_excess) {
            return (); ;; a top-up, or a gas_excess (a node's return): nothing to read or write
        }
    }

    load_data();
    bal0 = get_balance().pair_first() - incoming_value();
    act_flag = 0;
    if version == 0 {
        deploy();
    }
    route_internal_message(flags, src, s);
    save_data();
}

;;
;; get methods
;;

;; What a sweep must bring on top of fee::sweep to close the tree: 0 with no position ever assigned.
int get_close_cost() method_id {
    load_data();
    return close_cost(next_position);
}

;; The same for one node closed by close_subtree.
int get_subtree_close_cost(int level, int index) method_id {
    load_data();
    return close_cost_at(level, index, next_position);
}

int get_storage_version() method_id {
    return get_data().begin_parse().preload_uint(8);
}

var get_jackpot_state() method_id {
    load_data();
    ( int b_share, int min_pot, int burn_batch, int min_deposit ) = unpack_params();
    return
        ( held_tokens
        , incoming_tokens
        , reserved_tokens
        , principal
        , tickets
        , next_position
        , tag
        , unstaking_tokens
        , carried
        , quote_coins
        , quote_tokens
        , halted?
        , falling?
        , b_share
        , min_pot
        , burn_batch
        , burn_owed
        , min_deposit
        , node_float()
        );
}

;; ( last_boundary, boundary_coins, boundary_tokens, rise_min, min_gap, next_min_gap, earliest_next_boundary, drand_round )
var get_boundary() method_id {
    load_data();
    ( int last, int bc, int bt, int rise_min, int min_gap, int next_min_gap, _ ) = unpack_boundary();
    return ( last, bc, bt, rise_min, min_gap, next_min_gap, last + min_gap, quicknet_round_at(last + drand_delay) );
}

var get_retirement() method_id {
    load_data();
    ( int retired?, slice successor, int fee, _ ) = unpack_retirement();
    return ( retired?, successor, fee );
}

var get_draw_state() method_id {
    load_data();
    ( int p0, int p1, int p2 ) = unpack_misc();
    ( int last, _, _, _, _, _, _ ) = unpack_boundary();
    return
        ( draw_state
        , tag
        , snapshot_tickets
        , quicknet_round_at(last + drand_delay)
        , seed
        , p0
        , p1
        , p2
        , slots & 7
        , attempt(0)
        , attempt(1)
        , attempt(2)
        , mc_hash
        );
}

;; The position the open slot `slot` tries next, or -1 when there is none.
int get_position(int slot) method_id {
    load_data();
    if (draw_state != draw::resolving) | (slot >= 3) {
        return -1;
    }
    ifnot slot_open?(slot) {
        return -1;
    }
    return position(slot, attempt(slot));
}

(int, int) get_quote() method_id {
    load_data();
    return ( quote_coins, quote_tokens );
}

;; TEP-74: the jGRAM wallet of `owner`
slice get_wallet_address(slice owner) method_id {
    load_data();
    return jwallet_address(owner).end_cell().begin_parse();
}

;; TEP-74: ( total supply, mintable, admin, content, wallet code )
var get_jetton_data() method_id {
    load_data();
    return ( tickets, ~ retired?(), governor(), content, wallet_code() );
}

slice get_node_address(int level, int index) method_id {
    load_data();
    return create_address(chain::base, node_hash(level, index)).end_cell().begin_parse();
}

var get_addresses() method_id {
    load_data();
    ( slice parent, cell hipo_wallet_code ) = unpack_hipo();
    ( slice burner, slice governor, slice halter ) = unpack_roles();
    return ( treasury(), parent, wallet, burner, governor, halter, hipo_wallet_code, wallet_code(), node_code() );
}

var get_jackpot_fees() method_id {
    return
        ( deposit_fee(0, 0, 0)
        , burn_fee(0, 0, 0)
        , w_fee()
        , submit_fee()
        , poke_fee()
        , refill_fee()
        , unstake_run()
        , fee::sweep
        , fee::return
        , payload_fee_cap()
        , fee::draw_budget
        , float::low
        , float::high
        , wallet_storage()
        , fee::node_storage
        , payout_fee()
        , tep89_fee()
        );
}

;; The burn fee for a forward amount and a payload of the given size, at the current price.
var get_burn_fee(int forward_amount, int payload_cells, int payload_bits) method_id {
    return burn_fee(forward_amount, payload_cells, payload_bits);
}

;; The parts the fees are built from, at the current price: for tests and monitoring.
var get_fee_parts() method_id {
    return
        ( hop()
        , update_min()
        , update_value()
        , release()
        , hipo_send()
        , hipo_unstake()
        , booked_min(0, 0)
        , fee::node_share
        , w_value()
        , burn_arrives(0, 0, 0)
        );
}
