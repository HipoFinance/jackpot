;; Hipo Jackpot: a no-loss prize draw on hGRAM. The design, and the reason for every rule below, is in
;; docs/specs/2026-10-27-jackpot-v1.md; the message layouts are in contracts/schema.tlb.
;;
;; Units: T, I, O, F and every prize are nano-hGRAM; P, c, x, L_lo, L_hi, draw_L and positions are
;; nano-GRAM (tickets). The latest quote (TC, TT) converts between them, and every conversion rounds
;; toward the pool.
;;
;; The live tickets of every booking are counted in a tree of node contracts (contracts/node.fc) over the
;; range contracts (contracts/range.fc): a draw picks a position among the eligible live tickets and walks
;; down the tree to it.

#include "imports/utils.fc";
#include "imports/drand.fc";

;; FunC allows 31 globals, so what is read rarely -- the governor's parameters, the last draw start, the
;; draw's details, the codes, the Hipo wallet details and the roles -- stays packed in cells and is
;; unpacked where needed.

;; counters
global int total_tokens;  ;; T: hGRAM the Jackpot holds, by its own count
global int in_flight;     ;; I: received but not yet booked
global int set_aside;     ;; O: running draw's prizes, burn owed, claimable
global int principal;     ;; P: GRAM owed to players, withdrawals not yet paid included
global int quote_coins;   ;; TC of the latest quote received, 0 before the first
global int quote_tokens;  ;; TT
global int query_counter;
global int halted?;
global int falling?;
global int burn_owed;     ;; part of O
global int carried;       ;; prizes gone back into F since the last start that paid out a pot

;; the tree's counters
global int next_booking;  ;; n
global int k_next;        ;; the next draw's cutoff: n at the last start that paid out a pot
global int l_lo;          ;; live tickets of ranges with b < k_next
global int l_hi;          ;; live tickets of ranges with b >= k_next

;; settings
global cell params;       ;; b_share (bp), min_pot m, burn_batch, min_deposit
global cell last_start;   ;; config 34 utime_since and the rate, at the last start that moved the period

;; the draw
global int draw_state;
global int draw_id;       ;; the tag of every tree message; grows by one at each start that pays out
global int draw_e;        ;; E: only ranges with b < E can win the running draw
global int draw_l;        ;; draw_L: the running draw's eligible tickets, fixed for the whole draw
global int seed;
global int slots;         ;; bit i set while slot i is open; attempt of slot i in bits 8 + 8i .. 15 + 8i
global cell draw_misc;    ;; query_id, drand round R, randomness time, p0, p1, p2

;; addresses
global slice wallet;      ;; the Jackpot's own hGRAM wallet
global cell addresses;    ;; treasury, wallet, ^range_code, ^node_code, ^hipo, ^roles

;; books
global cell pending;      ;; query_id -> owner, coins, cap, created_at: GRAM deposits not yet minted
global cell quotes;       ;; query_id -> created_at, kind, data: quote requests waiting for their reply
global cell payouts;      ;; query_id -> kind, recipient, amount: hGRAM transfers not yet confirmed
global cell claimable;    ;; hash(owner) -> owner, prize, other: failed payouts, part of O

;; Design decision: everything that ties the Jackpot to one deployment of Hipo -- the treasury, the
;; parent, Hipo's wallet code, the Jackpot's own hGRAM wallet, the burner, the governor and the halter --
;; is data, not a constant (the own wallet starts as addr_none, see load_data). The tests then run against
;; the sandbox Hipo, and the governor can follow a wallet migration (set_hipo_wallet) without a code
;; upgrade. The range and node codes are in the data too, so that the Jackpot can deploy them and compute
;; their addresses; nothing ever changes them, because ranges and nodes cannot be upgraded.

() load_data() impure inline_ref {
    slice ds = get_data().begin_parse();
    int version = ds~load_uint(8);
    ;; 0 is the deploy data, which the first message checks and rewrites as the current layout
    throw_unless(err::unknown_version, (version == storage_version) | (version == 0));
    total_tokens = ds~load_coins();
    in_flight = ds~load_coins();
    set_aside = ds~load_coins();
    principal = ds~load_coins();
    quote_coins = ds~load_uint(128);
    quote_tokens = ds~load_uint(128);
    query_counter = ds~load_uint(32);
    halted? = ds~load_int(1);
    falling? = ds~load_int(1);

    slice extra = ds~load_ref().begin_parse();
    burn_owed = extra~load_coins();
    carried = extra~load_coins();
    params = extra~load_ref();
    last_start = extra~load_ref();
    slice tree = extra~load_ref().begin_parse();
    next_booking = tree~load_uint(32);
    k_next = tree~load_uint(32);
    l_lo = tree~load_coins();
    l_hi = tree~load_coins();
    tree.end_parse();
    extra.end_parse();

    slice draw = ds~load_ref().begin_parse();
    draw_state = draw~load_uint(2);
    draw_id = draw~load_uint(32);
    draw_e = draw~load_uint(32);
    draw_l = draw~load_coins();
    seed = draw~load_uint(256);
    slots = draw~load_uint(32);
    draw_misc = draw~load_ref();
    draw.end_parse();

    addresses = ds~load_ref();
    slice as = addresses.begin_parse();
    as~load_msg_addr(); ;; treasury
    wallet = as~load_msg_addr();
    if wallet.addr_none?() {
        ;; The Jackpot's own wallet address follows from its address, so it cannot be in the init data
        ;; that fixes that address. It is derived here, as Hipo's parent would, and saved with the first
        ;; message; the governor can still replace it with set_hipo_wallet after a wallet migration.
        as~load_ref();
        as~load_ref();
        slice hs = as~load_ref().begin_parse();
        slice parent = hs~load_msg_addr();
        ( builder own, _, _ ) = create_wallet_address(my_address().to_builder(), parent, hs~load_ref());
        wallet = own.end_cell().begin_parse();
    }

    slice books = ds~load_ref().begin_parse();
    pending = books~load_dict();
    quotes = books~load_dict();
    payouts = books~load_dict();
    claimable = books~load_dict();
    books.end_parse();

    ds.end_parse();
}

() save_data() impure inline_ref {
    cell tree = begin_cell()
        .store_uint(next_booking, 32)
        .store_uint(k_next, 32)
        .store_coins(l_lo)
        .store_coins(l_hi)
        .end_cell();

    cell extra = begin_cell()
        .store_coins(burn_owed)
        .store_coins(carried)
        .store_ref(params)
        .store_ref(last_start)
        .store_ref(tree)
        .end_cell();

    cell draw = begin_cell()
        .store_uint(draw_state, 2)
        .store_uint(draw_id, 32)
        .store_uint(draw_e, 32)
        .store_coins(draw_l)
        .store_uint(seed, 256)
        .store_uint(slots, 32)
        .store_ref(draw_misc)
        .end_cell();

    slice as = addresses.begin_parse();
    slice treasury = as~load_msg_addr();
    as~load_msg_addr();
    cell new_addresses = begin_cell()
        .store_slice(treasury)
        .store_slice(wallet)
        .store_slice(as) ;; the four refs
        .end_cell();

    cell books = begin_cell()
        .store_dict(pending)
        .store_dict(quotes)
        .store_dict(payouts)
        .store_dict(claimable)
        .end_cell();

    begin_cell()
        .store_uint(storage_version, 8)
        .store_coins(total_tokens)
        .store_coins(in_flight)
        .store_coins(set_aside)
        .store_coins(principal)
        .store_uint(quote_coins, 128)
        .store_uint(quote_tokens, 128)
        .store_uint(query_counter, 32)
        .store_int(halted?, 1)
        .store_int(falling?, 1)
        .store_ref(extra)
        .store_ref(draw)
        .store_ref(new_addresses)
        .store_ref(books)
        .end_cell()
        .set_data();
}

;; ( b_share, min_pot, burn_batch, min_deposit )
(int, int, int, int) unpack_params() inline {
    slice cs = params.begin_parse();
    return ( cs~load_uint(16), cs~load_coins(), cs~load_coins(), cs~load_coins() );
}

() pack_params(int b_share, int min_pot, int burn_batch, int min_deposit) impure inline {
    params = begin_cell()
        .store_uint(b_share, 16)
        .store_coins(min_pot)
        .store_coins(burn_batch)
        .store_coins(min_deposit)
        .end_cell();
}

;; ( round_since, rate_coins, rate_tokens )
(int, int, int) unpack_last_start() inline {
    slice cs = last_start.begin_parse();
    return ( cs~load_uint(32), cs~load_uint(128), cs~load_uint(128) );
}

() pack_last_start(int round_since, int rate_coins, int rate_tokens) impure inline {
    last_start = begin_cell()
        .store_uint(round_since, 32)
        .store_uint(rate_coins, 128)
        .store_uint(rate_tokens, 128)
        .end_cell();
}

;; ( query_id, drand_round, randomness_time, p0, p1, p2 )
(int, int, int, int, int, int) unpack_misc() inline {
    slice cs = draw_misc.begin_parse();
    return ( cs~load_uint(64), cs~load_uint(64), cs~load_uint(32), cs~load_coins(), cs~load_coins(), cs~load_coins() );
}

() pack_misc(int query_id, int drand_round, int randomness_time, int p0, int p1, int p2) impure inline {
    draw_misc = begin_cell()
        .store_uint(query_id, 64)
        .store_uint(drand_round, 64)
        .store_uint(randomness_time, 32)
        .store_coins(p0)
        .store_coins(p1)
        .store_coins(p2)
        .end_cell();
}

int draw_query_id() inline {
    return draw_misc.begin_parse().preload_uint(64);
}

() set_draw_query_id(int query_id) impure inline {
    ( _, int drand_round, int randomness_time, int p0, int p1, int p2 ) = unpack_misc();
    pack_misc(query_id, drand_round, randomness_time, p0, p1, p2);
}

slice treasury() inline {
    slice as = addresses.begin_parse();
    return as~load_msg_addr();
}

cell address_ref(int i) inline {
    slice as = addresses.begin_parse();
    repeat (i) {
        as~load_ref();
    }
    return as.preload_ref();
}

cell range_code() inline {
    return address_ref(0);
}

cell node_code() inline {
    return address_ref(1);
}

;; ( parent, wallet_code )
(slice, cell) unpack_hipo() inline {
    slice cs = address_ref(2).begin_parse();
    return ( cs~load_msg_addr(), cs~load_ref() );
}

;; ( burner, governor, halter )
(slice, slice, slice) unpack_roles() inline {
    slice cs = address_ref(3).begin_parse();
    return ( cs~load_msg_addr(), cs~load_msg_addr(), cs~load_msg_addr() );
}

slice governor() inline {
    ( _, slice governor, _ ) = unpack_roles();
    return governor;
}

() set_address_ref(int i, cell value) impure inline {
    slice as = addresses.begin_parse();
    builder b = begin_cell().store_slice(as~load_msg_addr()).store_slice(as~load_msg_addr());
    int j = 0;
    repeat (4) {
        cell r = as~load_ref();
        b = b.store_ref(j == i ? value : r);
        j += 1;
    }
    addresses = b.end_cell();
}

;;
;; helpers
;;

;; A fresh query_id: a counter in the high 32 bits keeps it unique, and 32 random bits in the low half
;; keep it unpredictable, so that nobody can mint dust to the Jackpot under a deposit's query_id before
;; the Jackpot has sent it.
int new_query_id() impure inline {
    query_counter += 1;
    randomize_lt();
    return (query_counter << 32) | (random() & 0xffffffff);
}

slice addr_none() asm "b{00} PUSHSLICE";

int incoming_value() inline {
    return get_incoming_value().pair_first();
}

int free_tokens() inline {
    return total_tokens - in_flight - set_aside;
}

int range_hash(int b) inline {
    cell code = range_code();
    return state_init_hash(code.cell_hash(), code.cell_depth(), create_range_data(my_address(), b));
}

int is_range?(slice src, int b) inline {
    return is_base_addr?(src, range_hash(b));
}

cell node_data(int level, int index) inline {
    cell code = range_code();
    return create_node_data(my_address(), level, index, code.cell_hash(), code.cell_depth());
}

int node_hash(int level, int index) inline {
    cell code = node_code();
    return state_init_hash(code.cell_hash(), code.cell_depth(), node_data(level, index));
}

int is_wallet_of?(slice src, slice owner) inline {
    ( slice parent, cell wallet_code ) = unpack_hipo();
    ( _, _, int addr ) = create_wallet_address(owner.to_builder(), parent, wallet_code);
    return is_base_addr?(src, addr);
}

int prize(int slot) inline {
    ( _, _, _, int p0, int p1, int p2 ) = unpack_misc();
    return slot == 0 ? p0 : (slot == 1 ? p1 : p2);
}

int attempt(int slot) inline {
    return (slots >> (8 + 8 * slot)) & 0xff;
}

int slot_open?(int slot) inline {
    return (slots >> slot) & 1;
}

;; From the moment a draw waits for drand until it is idle again.
int in_window?() inline {
    return (draw_state == draw::waiting) | (draw_state == draw::resolving);
}

;; k(i, j) = uint256(sha256(seed ‖ uint8 i ‖ uint8 j)) mod draw_L, hashing exactly 272 bits.
int position(int slot, int j) inline {
    builder data = begin_cell()
        .store_uint(seed, 256)
        .store_uint(slot, 8)
        .store_uint(j, 8);
    return data.sha256_builder() % draw_l;
}

;; s = ceil(3·(A−1)·fee::locate·x / draw_L): what a withdrawal held back in the running draw owes for the
;; retries its empty positions may cause.
int surcharge(int x) inline {
    return muldivc(3 * (attempts_per_slot - 1) * fee::locate, x, draw_l);
}

() request_quote(int query_id, builder record) impure inline_ref {
    quotes~udict_set_builder(64, query_id, record);

    builder body = begin_cell()
        .store_uint(op::provide_current_quote, 32)
        .store_uint(query_id, 64)
        .store_uint(0, 1); ;; no custom_payload: the reply is matched by query_id alone
    send_msg(true, treasury().to_builder(), null(), body, fee::quote, send::regular);
}

;; Every hGRAM transfer out goes through here. It leaves T at once and stays recorded until the
;; recipient's wallet confirms it with gas_excess, or the Jackpot's wallet bounces it.
() pay(slice recipient, int amount, int kind, int forward_ton_amount) impure inline_ref {
    int query_id = new_query_id();
    payouts~udict_set_builder(64, query_id, begin_cell()
        .store_uint(kind, 2)
        .store_slice(recipient)
        .store_coins(amount));
    total_tokens -= amount;

    builder body = begin_cell()
        .store_uint(op::send_tokens, 32)
        .store_uint(query_id, 64)
        .store_coins(amount)
        .store_slice(recipient)
        .store_slice(my_address()) ;; return_excess: the recipient's wallet confirms to us
        .store_uint(0, 1) ;; no custom_payload
        .store_coins(forward_ton_amount)
        .store_uint(0, 1); ;; forward_payload, inline and empty
    send_msg(true, wallet.to_builder(), null(), body, fee::payout + forward_ton_amount, send::regular);
}

;; Adds to an owner's claimable amount, of one kind. The caller has already put the amount into O.
() credit_claimable(slice owner, int amount, int prize?) impure inline {
    int key = slice_hash(owner);
    int prize_amount = 0;
    int other_amount = 0;
    ( slice v, int found? ) = claimable.udict_get?(256, key);
    if found? {
        v~load_msg_addr();
        prize_amount = v~load_coins();
        other_amount = v~load_coins();
    }
    if prize? {
        prize_amount += amount;
    } else {
        other_amount += amount;
    }
    claimable~udict_set_builder(256, key, begin_cell()
        .store_slice(owner)
        .store_coins(prize_amount)
        .store_coins(other_amount));
}

;; Takes back a payout whose tokens never left the Jackpot's wallet: they return to T and O, and become
;; claimable, or burn owed again.
() restore_payout(slice record) impure inline {
    int kind = record~load_uint(2);
    slice recipient = record~load_msg_addr();
    int amount = record~load_coins();

    total_tokens += amount;
    set_aside += amount;
    if kind == payout::burn {
        burn_owed += amount;
    } else {
        credit_claimable(recipient, amount, kind == payout::prize);
    }
}

;; Tokens that are now the Jackpot's, from a mint or a player's transfer, and still to be booked.
() tokens_arrived(slice owner, int tokens) impure inline {
    total_tokens += tokens;
    in_flight += tokens;

    int query_id = new_query_id();
    request_quote(query_id, begin_cell()
        .store_uint(now(), 32)
        .store_uint(quote::booking, 2)
        .store_slice(owner)
        .store_coins(tokens));
}

;; Sends a change of the live tickets of range b down the tree. A booking's update carries the deploy of
;; the top node when b = 0, and the reserve of every node b opens: node(ℓ, b / 64^ℓ) when b is its first
;; child. The nodes' own share of each booking's fee is kept in the Jackpot's float, which pays this.
() send_update(int b, int delta, int deferred?) impure inline_ref {
    int value = fee::update;
    builder state_init = null();
    if delta > 0 {
        int shift = tree::bits;
        repeat (tree::levels) {
            if (b & ((1 << shift) - 1)) == 0 {
                value += fee::node_open;
            }
            shift += tree::bits;
        }
        if b == 0 {
            state_init = create_state_init(node_code(), node_data(tree::levels, 0));
        }
    }
    builder body = begin_cell()
        .store_uint(op::update, 32)
        .store_uint(0, 64)
        .store_uint(draw_id, 32)
        .store_int(deferred?, 1)
        .store_uint(b, 32)
        .store_int(delta, 128);
    builder top = create_address(chain::base, node_hash(tree::levels, 0));
    send_msg(false, top, state_init, body, value, send::pay_gas_separately);
}

;; The live tickets of range b changed by delta, outside the running draw's positions or held back from
;; them: the counters follow at once.
() count_live(int b, int delta) impure inline {
    if b < k_next {
        l_lo += delta;
    } else {
        l_hi += delta;
    }
}

() log_slot(int slot, int j, int result, int k, int b, int amount, slice owner) impure inline {
    builder log = begin_cell()
        .store_uint(draw_id, 32)
        .store_uint(slot, 8)
        .store_uint(j, 8)
        .store_uint(result, 8)
        .store_uint(k, 128)
        .store_uint(b, 32)
        .store_coins(amount)
        .store_slice(owner);
    emit_log(log::slot, log);
}

;; Closes a slot. When it was the last one, the draw is over, and the burn owed goes out once it reaches
;; the batch size. Its GRAM was prepaid by start_draw, so a keeper's locate or expire never pays it.
() close_slot(int slot) impure inline {
    slots &= ~ (1 << slot);
    if slots & 7 {
        return ();
    }

    draw_state = draw::idle;
    ;; the burn owed is held while the rate has fallen
    ( _, _, int burn_batch, _ ) = unpack_params();
    if (burn_owed > 0) & (burn_owed >= burn_batch) & (~ falling?) {
        int amount = burn_owed;
        burn_owed = 0;
        set_aside -= amount;
        ( slice burner, _, _ ) = unpack_roles();
        pay(burner, amount, payout::burn, fee::burn_forward);
    }
}

;; A prize that found no winner goes back into F, and is counted in `carried` so that the next pot does
;; not burn it a second time.
() roll_back(int slot) impure inline {
    int amount = prize(slot);
    set_aside -= amount;
    carried += amount;
}

;;
;; deposits
;;

() deposit(slice src, slice s) impure inline {
    int query_id = s~load_uint(64);
    s.end_parse();

    int value = incoming_value();
    int coins = value - fee::deposit;
    ( int src_wc, _ ) = parse_std_addr(src);

    throw_unless(err::insufficient_fee, value >= fee::deposit);
    ( _, _, _, int min_deposit ) = unpack_params();
    throw_unless(err::deposit_too_small, coins >= min_deposit);
    throw_if(err::halted, halted?);
    ;; the cap below needs a rate; the deploy asks the treasury for the first one
    throw_unless(err::no_quote, quote_tokens > 0);

    ;; Hipo's wallet pays only to basechain, so a depositor anywhere else could never be paid back
    if src_wc != chain::base {
        builder refund = begin_cell()
            .store_uint(op::gas_excess, 32)
            .store_uint(query_id, 64);
        send_msg(false, src.to_builder(), null(), refund, 0, send::remaining_value);
        return ();
    }

    ;; the most a mint may book for this deposit: what `coins` mints at the stored rate, which only rises
    int cap = muldiv(coins, quote_tokens, quote_coins);
    int deposit_id = new_query_id();
    pending~udict_set_builder(64, deposit_id, begin_cell()
        .store_slice(src)
        .store_coins(coins)
        .store_coins(cap)
        .store_uint(now(), 32));

    ;; An explicit `coins` makes the rest of the message ride on to the mint notification, which pays the
    ;; booking: the burner's pattern.
    builder body = begin_cell()
        .store_uint(op::deposit_coins, 32)
        .store_uint(deposit_id, 64)
        .store_uint(0, 2) ;; owner: addr_none, which Hipo reads as the sender, us
        .store_coins(coins)
        .store_coins(0) ;; ownership_assigned_amount
        .store_uint(0, 2); ;; referrer: addr_none
    send_msg(true, treasury().to_builder(), null(), body, coins + fee::deposit_forward, send::regular);
}

;; Both kinds of arrival come as transfer_notification from the Jackpot's own wallet. A mint names the
;; Jackpot itself as the sender (wallet.fc tokens_minted); a player's transfer names the player.
() transfer_notification(slice src, slice s) impure inline {
    ifnot equal_slice_bits(src, wallet) {
        return (); ;; not ours: nothing here is credited from a notification we cannot trust
    }

    int query_id = s~load_uint(64);
    int amount = s~load_coins();
    slice sender = s~load_msg_addr();

    if equal_slice_bits(sender, my_address()) {
        ;; A mint. Anyone can mint to the Jackpot under any query_id, and with instant_mint off a bill
        ;; mints under the query_id that released Hipo's round, so a mint books at most the record's cap,
        ;; and one below 99% of the cap leaves the record for its real mint. Whatever is not booked stays
        ;; in the wallet outside T, for the governor.
        ( slice v, int found? ) = pending.udict_get?(64, query_id);
        ifnot found? {
            return ();
        }
        slice owner = v~load_msg_addr();
        v~load_coins(); ;; coins
        int cap = v~load_coins();
        if amount >= cap - cap / 100 {
            pending~udict_delete?(64, query_id);
            tokens_arrived(owner, min(amount, cap));
        }
        return ();
    }

    ifnot amount {
        return ();
    }

    ( int sender_wc, _ ) = parse_std_addr(sender);
    int value = incoming_value();
    if (sender_wc != chain::base) {
        return (); ;; cannot be paid back: held outside T for the governor
    }

    if (~ halted?) & (value >= fee::hgram_deposit) {
        tokens_arrived(sender, amount);
        return ();
    }

    ;; too little GRAM, or halted: back to the player when the return can be paid for
    if value >= fee::handler + fee::payout {
        total_tokens += amount;
        pay(sender, amount, payout::other, 0);
    }
}

;;
;; quote replies
;;

() book(slice record, int tc, int tt) impure inline {
    slice owner = record~load_msg_addr();
    int tokens = record~load_coins();

    int c = muldiv(tokens, tc, tt);
    in_flight -= tokens;

    ;; Returning rather than booking keeps the next booking index for a real booking. The 1% margin
    ;; lets a deposit of exactly the minimum book after the mint's rounding and a rate rise.
    ( _, _, _, int min_deposit ) = unpack_params();
    if (c < min_deposit - min_deposit / 100) | halted? | falling? | (next_booking >= tree::capacity) {
        pay(owner, tokens, payout::other, 0);
        return ();
    }

    int b = next_booking;
    next_booking += 1;
    principal += c;
    l_hi += c;

    cell code = range_code();
    cell data = create_range_data(my_address(), b);
    builder range = create_address(chain::base, state_init_hash(code.cell_hash(), code.cell_depth(), data));
    ;; Bounceable, b in the query_id and the length first: a setup that fails comes back with what it
    ;; takes to undo the booking (on_bounce).
    builder setup = begin_cell()
        .store_uint(op::range_setup, 32)
        .store_uint(b, 64)
        .store_coins(c)
        .store_slice(owner)
        .store_uint(node_hash(1, b >> tree::bits), 256);
    send_msg(true, range, create_state_init(code, data), setup, fee::range_setup, send::regular);

    send_update(b, c, false);

    builder log = begin_cell()
        .store_slice(owner)
        .store_uint(b, 32)
        .store_coins(c)
        .store_coins(tokens);
    emit_log(log::booking, log);
}

;; w = min(floor(x·TT/TC), floor(F·x/P)): the min shares the loss pro-rata when the rate has fallen;
;; otherwise the first term is the smaller.
int tokens_for(int x, int tc, int tt) inline {
    int w = min(muldiv(x, tt, tc), muldiv(max(free_tokens(), 0), x, principal));
    return max(w, 0);
}

() pay_withdrawal(slice record, int tc, int tt) impure inline {
    slice owner = record~load_msg_addr();
    int b = record~load_uint(32);
    int x = record~load_coins();

    int w = tokens_for(x, tc, tt);
    principal -= x;
    if w {
        pay(owner, w, payout::other, 0);
    }

    builder log = begin_cell()
        .store_slice(owner)
        .store_uint(b, 32)
        .store_coins(x)
        .store_coins(w);
    emit_log(log::withdrawal, log);
}

() begin_draw(int query_id, int tc, int tt) impure inline {
    if (draw_state != draw::quoting) | (draw_query_id() != query_id) {
        return ();
    }
    draw_state = draw::idle;
    set_draw_query_id(0);

    ;; the validation round current when the reply arrives, not when it was asked for
    ( int round_since, _ ) = get_vset_times(config::current_validators);
    ( int last_round_since, int last_coins, int last_tokens ) = unpack_last_start();
    ( int b_share, int min_pot, _, _ ) = unpack_params();

    int rate_up? = (last_tokens == 0) | (tc * last_tokens > last_coins * tt);
    int pot = free_tokens() - muldivc(principal, tt, tc);
    if (round_since <= last_round_since) | (~ rate_up?) | (pot < min_pot) | falling? | halted? {
        return (); ;; the keeper tries again once Hipo books the round's reward
    }

    pack_last_start(round_since, tc, tt);
    int eligible? = (k_next > 0) & (l_lo > 0);
    int burn = 0;
    int p0 = 0;
    int p1 = 0;
    int p2 = 0;
    int drand_round = 0;
    int cutoff = 0;
    int eligible = 0;

    if eligible? {
        burn = muldiv(max(pot - carried, 0), b_share, basis_points);
        int rest = pot - burn;
        p0 = muldiv(rest, share::first, basis_points);
        p1 = muldiv(rest, share::second, basis_points);
        p2 = rest - p0 - p1;
        set_aside += pot;
        burn_owed += burn;

        draw_id += 1;
        drand_round = quicknet_round_at(now() + drand_delay);
        draw_e = k_next;
        draw_l = l_lo;
        cutoff = draw_e;
        eligible = draw_l;
        seed = 0;
        slots = 7; ;; all open, every attempt 0
        draw_state = draw::waiting;
        pack_misc(0, drand_round, 0, p0, p1, p2);
    }

    ;; the next period: the bookings so far take part in the next draw
    int carried_before = carried;
    if eligible? {
        carried = 0;
    }
    k_next = next_booking;
    l_lo += l_hi;
    l_hi = 0;

    builder log = begin_cell()
        .store_uint(draw_id, 32)
        .store_uint(round_since, 32)
        .store_uint(cutoff, 32)
        .store_coins(eligible)
        .store_uint(k_next, 32)
        .store_coins(eligible? ? pot : 0)
        .store_coins(burn)
        .store_coins(carried_before)
        .store_ref(begin_cell()
            .store_coins(p0)
            .store_coins(p1)
            .store_coins(p2)
            .store_uint(drand_round, 64)
            .end_cell());
    emit_log(log::draw_start, log);
}

;; Never throws: the treasury's reply is not bounceable, so a throw would lose it.
() take_current_quote(slice src, slice s) impure inline {
    ifnot equal_slice_bits(src, treasury()) {
        return ();
    }

    int query_id = s~load_uint(64);
    int tc = s~load_uint(128);
    int tt = s~load_uint(128);

    if (tc == 0) | (tt == 0) {
        return (); ;; not a rate; the record stays for requote
    }

    ;; a record is used once
    ( slice record, int found? ) = quotes~udict_delete_get?(64, query_id);
    ifnot found? {
        return ();
    }

    ;; a lower rate is the truth, and is stored; the flag holds back what the old rate promised
    if (quote_tokens > 0) & (tc * quote_tokens < quote_coins * tt) {
        falling? = true;
    }
    quote_coins = tc;
    quote_tokens = tt;

    record~skip_bits(32); ;; created_at
    int kind = record~load_uint(2);

    if kind == quote::booking {
        return book(record, tc, tt);
    }
    if kind == quote::withdrawal {
        return pay_withdrawal(record, tc, tt);
    }
    if kind == quote::draw {
        return begin_draw(query_id, tc, tt);
    }
}

;; Anyone may resend a quote request that has had no reply for 10 minutes. The record moves to a fresh
;; query_id, so a late reply to the old one finds nothing.
() requote(slice src, slice s) impure inline {
    s~load_uint(64);
    int target = s~load_uint(64);
    s.end_parse();

    throw_unless(err::insufficient_fee, incoming_value() >= fee::requote);

    ( slice record, int found? ) = quotes.udict_get?(64, target);
    throw_unless(err::unknown_query, found?);
    int created_at = record~load_uint(32);
    throw_unless(err::too_soon, now() >= created_at + requote_after);

    quotes~udict_delete?(64, target);
    int query_id = new_query_id();
    if (record.preload_uint(2) == quote::draw) {
        set_draw_query_id(query_id);
    }
    request_quote(query_id, begin_cell().store_uint(now(), 32).store_slice(record));
}

;;
;; withdrawal
;;

() withdrawn(slice src, slice s) impure inline {
    int query_id = s~load_uint(64);
    int x = s~load_coins();
    int b = s~load_uint(32);
    slice owner = s~load_msg_addr();
    int sent = s~load_coins(); ;; what the owner sent the range, which the range vouches for
    s.end_parse();

    ;; a throw bounces this back to the range, which restores its live part and returns the GRAM
    throw_unless(err::access_denied, is_range?(src, b));
    throw_unless(err::invalid_parameters, x > 0);

    ;; In the window, a range the running draw can pick keeps its positions: the update is held back in
    ;; the nodes, and the withdrawal pays for the retries its empty positions may cause.
    int deferred? = in_window?() & (b < draw_e);
    int s_fee = deferred? ? surcharge(x) : 0;
    throw_unless(err::insufficient_fee, sent >= fee::withdraw + s_fee);

    count_live(b, - x);
    send_update(b, - x, deferred?);

    builder log = begin_cell()
        .store_slice(owner)
        .store_uint(b, 32)
        .store_coins(x)
        .store_int(deferred?, 1);
    emit_log(log::withdrawn, log);

    ;; x stays in P until the reply pays it, so a draw in between cannot pay out tokens that are owed
    int id = new_query_id();
    request_quote(id, begin_cell()
        .store_uint(now(), 32)
        .store_uint(quote::withdrawal, 2)
        .store_slice(owner)
        .store_uint(b, 32)
        .store_coins(x));

    ;; what came above the chain's cost and the surcharge goes back to the owner
    int refund = sent - fee::withdraw - s_fee;
    if refund > fee::min_refund {
        builder excess = begin_cell()
            .store_uint(op::gas_excess, 32)
            .store_uint(query_id, 64);
        send_msg(false, owner.to_builder(), null(), excess, refund, send::ignore_errors);
    }
}

;;
;; the draw
;;

() start_draw(slice src, slice s) impure inline {
    s~load_uint(64);
    s.end_parse();

    ( int round_since, _ ) = get_vset_times(config::current_validators);

    throw_unless(err::insufficient_fee, incoming_value() >= fee::start_draw);
    throw_unless(err::not_idle, draw_state == draw::idle);
    throw_if(err::halted, halted?);
    throw_if(err::rate_falling, falling?);
    ( int last_round_since, _, _ ) = unpack_last_start();
    throw_unless(err::round_not_changed, round_since > last_round_since);

    int query_id = new_query_id();
    draw_state = draw::quoting;
    set_draw_query_id(query_id);
    request_quote(query_id, begin_cell()
        .store_uint(now(), 32)
        .store_uint(quote::draw, 2));
}

() submit_randomness(slice src, slice s) impure inline {
    s~load_uint(64);
    slice signature = s~load_ref().begin_parse();
    slice witness = s~load_ref().begin_parse();
    s.end_parse();

    throw_unless(err::insufficient_fee, incoming_value() >= fee::submit_randomness);
    throw_unless(err::not_waiting_for_randomness, draw_state == draw::waiting);

    ;; throws unless drand quicknet signed R, so a bad submission is paid by its sender
    ( int query_id, int drand_round, _, int p0, int p1, int p2 ) = unpack_misc();
    seed = quicknet_verify(drand_round, signature, witness);
    pack_misc(query_id, drand_round, now(), p0, p1, p2);
    draw_state = draw::resolving;

    builder log = begin_cell()
        .store_uint(draw_id, 32)
        .store_uint(drand_round, 64)
        .store_uint(seed, 256);
    emit_log(log::randomness, log);
}

;; The keeper names only the slot. The Jackpot computes the position itself and starts the descent, so
;; nobody can make a range answer about a position of their choosing. What the message carries above the
;; Jackpot's own part rides down the tree, so an overpaid locate pushes any costly step through.
() locate(slice src, slice s) impure inline {
    int query_id = s~load_uint(64);
    int slot = s~load_uint(8);
    s.end_parse();

    int value = incoming_value();
    throw_unless(err::insufficient_fee, value >= fee::locate);
    throw_unless(err::not_resolving, draw_state == draw::resolving);
    throw_unless(err::invalid_parameters, slot < 3);
    throw_unless(err::slot_closed, slot_open?(slot));

    int j = attempt(slot);
    int k = position(slot, j);
    builder body = begin_cell()
        .store_uint(op::descend, 32)
        .store_uint(query_id, 64)
        .store_uint(draw_id, 32)
        .store_uint(slot, 8)
        .store_uint(j, 8)
        .store_uint(k, 128)
        .store_uint(k, 128); ;; the offset inside the top node
    builder top = create_address(chain::base, node_hash(tree::levels, 0));
    send_msg(false, top, null(), body, value - fee::handler - fee::payout, send::pay_gas_separately);
}

;; Shared by hit, miss and lost: the reply answers the current attempt of an open slot of this draw,
;; about the position the Jackpot itself chose.
int current_reply?(int draw, int slot, int j, int k) inline {
    if (draw_state != draw::resolving) | (draw != draw_id) | (slot >= 3) {
        return false;
    }
    ifnot slot_open?(slot) {
        return false;
    }
    return (j == attempt(slot)) & (k == position(slot, j));
}

;; A miss or a lost descent: the slot moves to its next attempt, and after A of them its prize rolls over.
() next_attempt(int slot, int j, int k, int b, int result) impure inline {
    slots += 1 << (8 + 8 * slot);
    if result == slot::lost {
        log_slot(slot, j, slot::lost, k, b, 0, addr_none());
    }
    if j + 1 < attempts_per_slot {
        if result == slot::miss {
            log_slot(slot, j, slot::miss, k, b, 0, addr_none());
        }
        return ();
    }
    log_slot(slot, j, slot::rolled_over, k, b, prize(slot), addr_none());
    roll_back(slot);
    close_slot(slot);
}

;; Never throws.
() hit(slice src, slice s) impure inline {
    s~load_uint(64);
    int draw = s~load_uint(32);
    int slot = s~load_uint(8);
    int j = s~load_uint(8);
    int k = s~load_uint(128);
    int b = s~load_uint(32);
    slice owner = s~load_msg_addr();

    ifnot current_reply?(draw, slot, j, k) {
        return ();
    }
    if b >= draw_e {
        return ();
    }
    ifnot is_range?(src, b) {
        return ();
    }

    int amount = prize(slot);
    if falling? {
        ;; the prize was priced at a rate that no longer holds: it goes back into F
        log_slot(slot, j, slot::returned, k, b, amount, owner);
        roll_back(slot);
    } else {
        set_aside -= amount;
        pay(owner, amount, payout::prize, 0);
        log_slot(slot, j, slot::hit, k, b, amount, owner);
    }
    close_slot(slot);
}

;; Never throws.
() miss(slice src, slice s) impure inline {
    s~load_uint(64);
    int draw = s~load_uint(32);
    int slot = s~load_uint(8);
    int j = s~load_uint(8);
    int k = s~load_uint(128);
    int b = s~load_uint(32);

    ifnot current_reply?(draw, slot, j, k) {
        return ();
    }
    if b >= draw_e {
        return ();
    }
    ifnot is_range?(src, b) {
        return ();
    }
    next_attempt(slot, j, k, b, slot::miss);
}

;; Never throws. A node found no child covering the position, which cannot happen while the sums agree.
() lost(slice src, slice s) impure inline {
    s~load_uint(64);
    int draw = s~load_uint(32);
    int slot = s~load_uint(8);
    int j = s~load_uint(8);
    int k = s~load_uint(128);
    int level = s~load_uint(8);
    int index = s~load_uint(32);

    ifnot current_reply?(draw, slot, j, k) {
        return ();
    }
    if (level < 1) | (level > tree::levels) {
        return ();
    }
    ifnot is_base_addr?(src, node_hash(level, index)) {
        return ();
    }
    next_attempt(slot, j, k, index, slot::lost); ;; the log names the node's index
}

;; A slot nobody settled within one validation round of the randomness rolls over. This covers a range
;; or a node that ran out of storage; it never fires while the keeper is locating.
() expire(slice src, slice s) impure inline {
    s~load_uint(64);
    int slot = s~load_uint(8);
    s.end_parse();

    ( int validators_elected_for, _, _, _ ) = get_election_config();
    ( _, _, int randomness_time, _, _, _ ) = unpack_misc();

    throw_unless(err::insufficient_fee, incoming_value() >= fee::expire);
    throw_unless(err::not_resolving, draw_state == draw::resolving);
    throw_unless(err::invalid_parameters, slot < 3);
    throw_unless(err::slot_closed, slot_open?(slot));
    throw_unless(err::too_soon, now() >= randomness_time + validators_elected_for);

    log_slot(slot, attempt(slot), slot::expired, 0, 0, prize(slot), addr_none());
    roll_back(slot);
    close_slot(slot);
}

;;
;; payouts
;;

;; The amount is cleared before it is sent, and sent as a new recorded payout, so two claims pay once.
;; While the rate has fallen only `other` amounts are paid (failed withdrawals and returns, owed in hGRAM
;; already counted); prizes wait for the flag to clear.
() claim(slice src, slice s) impure inline {
    s~load_uint(64);
    s.end_parse();

    throw_unless(err::insufficient_fee, incoming_value() >= fee::claim);

    int key = slice_hash(src);
    ( slice v, int found? ) = claimable.udict_get?(256, key);
    throw_unless(err::nothing_to_claim, found?);
    v~load_msg_addr();
    int prize_amount = v~load_coins();
    int other_amount = v~load_coins();

    if falling? {
        throw_unless(err::rate_falling, other_amount > 0);
        if prize_amount {
            claimable~udict_set_builder(256, key, begin_cell()
                .store_slice(src)
                .store_coins(prize_amount)
                .store_coins(0));
        } else {
            claimable~udict_delete?(256, key);
        }
        set_aside -= other_amount;
        pay(src, other_amount, payout::other, 0);
        return ();
    }

    claimable~udict_delete?(256, key);
    int amount = prize_amount + other_amount;
    set_aside -= amount;
    ;; one transfer; should it fail, all of it comes back as a prize when it held one
    pay(src, amount, prize_amount ? payout::prize : payout::other, 0);
}

;; Never throws. Only the recipient's own hGRAM wallet confirms a payout. A gas_excess from the
;; Jackpot's own wallet proves nothing: Hipo sends one after a second-hop bounce, and anyone can make it
;; send one with any query_id.
() gas_excess(slice src, slice s) impure inline {
    int query_id = s~load_uint(64);

    ( slice record, int found? ) = payouts.udict_get?(64, query_id);
    ifnot found? {
        return ();
    }
    record~skip_bits(2);
    slice recipient = record~load_msg_addr();
    if is_wallet_of?(src, recipient) {
        payouts~udict_delete?(64, query_id);
    }
}

;; Never throws.
() on_bounce(slice src, slice s) impure inline {
    s~skip_bits(32); ;; 0xffffffff
    int op = s~load_uint(32);
    int query_id = s~load_uint(64);

    if (op == op::send_tokens) & equal_slice_bits(src, wallet) {
        ;; the first hop failed, so the tokens never left our wallet
        ( slice record, int found? ) = payouts~udict_delete_get?(64, query_id);
        if found? {
            restore_payout(record);
        }
        return ();
    }

    if (op == op::deposit_coins) & equal_slice_bits(src, treasury()) {
        ;; Hipo refused the deposit (halted, too small): the GRAM goes back to the player
        ( slice record, int found? ) = pending~udict_delete_get?(64, query_id);
        if found? {
            slice owner = record~load_msg_addr();
            builder refund = begin_cell()
                .store_uint(op::gas_excess, 32)
                .store_uint(query_id, 64);
            send_msg(false, owner.to_builder(), null(), refund, 0, send::remaining_value + send::ignore_errors);
        }
        return ();
    }

    if (op == op::provide_current_quote) & equal_slice_bits(src, treasury()) {
        ;; a draw goes back to idle; a booking or a withdrawal keeps its record, for requote
        if (draw_state == draw::quoting) & (draw_query_id() == query_id) {
            quotes~udict_delete?(64, query_id);
            draw_state = draw::idle;
            set_draw_query_id(0);
        }
        return ();
    }

    if op == op::range_setup {
        ;; Cannot happen with the setup's fixed value and a fresh address; if it does, the booking is
        ;; undone. The range never held the tickets, so they leave the tree and P; the tokens they were
        ;; worth leave T and wait in the wallet for the governor's return_tokens to the owner in the log.
        int b = query_id;
        if (b >= next_booking) | (~ is_range?(src, b)) {
            return ();
        }
        int c = s~load_coins();
        int w = tokens_for(c, quote_coins, quote_tokens);
        principal -= c;
        total_tokens -= w;
        count_live(b, - c);
        send_update(b, - c, in_window?() & (b < draw_e));
        builder log = begin_cell()
            .store_uint(b, 32)
            .store_coins(c)
            .store_coins(w);
        emit_log(log::setup_failed, log);
        return ();
    }

    ;; anything else is only GRAM coming back
}

;;
;; governance
;;

;; Runs in the NEW code, entered from the old code's upgrade_code through set_c3, in the same transaction.
;; It reads the stored layout (load_data throws on a version it does not know, and the upgrade reverts
;; with the old code and data), migrates it, and must keep the draw where it is: draw_id never goes down,
;; and the draw state is unchanged. A later version that changes the layout migrates here from the
;; version it reads. throw(0) ends the transaction successfully, so the old code never saves over it.
() migrate(int old_draw_id, int old_draw_state) impure method_id {
    load_data();
    throw_unless(err::draw_changed, (draw_id >= old_draw_id) & (draw_state == old_draw_state));
    save_data();
    throw(0);
}

() upgrade_code(slice src, slice s) impure inline {
    s~load_uint(64);
    cell new_code = s~load_ref();
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));

    set_code(new_code);
    set_c3(new_code.begin_parse().bless());
    migrate(draw_id, draw_state);
}

;; Follows a Hipo wallet migration: the parent, the wallet code and the Jackpot's own wallet change
;; together.
() set_hipo_wallet(slice src, slice s) impure inline {
    s~load_uint(64);
    slice new_parent = s~load_msg_addr();
    slice new_wallet = s~load_msg_addr();
    cell new_wallet_code = s~load_ref();
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));

    set_address_ref(2, begin_cell().store_slice(new_parent).store_ref(new_wallet_code).end_cell());
    wallet = new_wallet;
}

;; Books a deposit whose mint notification never came (Hipo sends it with ignore_errors), or that a bill
;; minted under another query_id, after the governor has checked the wallet off chain. Deleting the
;; pending entry voids a late notification. It books at most the entry's cap.
() resolve_pending(slice src, slice s) impure inline {
    s~load_uint(64);
    int target = s~load_uint(64);
    int tokens = s~load_coins();
    s.end_parse();

    ( int validators_elected_for, _, _, _ ) = get_election_config();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));
    throw_unless(err::insufficient_fee, incoming_value() >= fee::booking);
    throw_unless(err::invalid_parameters, tokens > 0);

    ( slice record, int found? ) = pending~udict_delete_get?(64, target);
    throw_unless(err::unknown_query, found?);
    slice owner = record~load_msg_addr();
    record~load_coins(); ;; coins
    int cap = record~load_coins();
    int created_at = record~load_uint(32);
    ;; with instant_mint off, a mint legitimately comes a round later
    throw_unless(err::too_soon, now() >= created_at + 2 * validators_elected_for);

    tokens_arrived(owner, min(tokens, cap));
}

;; Returns hGRAM that reached the wallet without a notification, or was held there. The tokens are
;; outside T, so they enter T and leave it as a recorded payout.
() return_tokens(slice src, slice s) impure inline {
    s~load_uint(64);
    slice owner = s~load_msg_addr();
    int amount = s~load_coins();
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));
    throw_unless(err::insufficient_fee, incoming_value() >= fee::handler + fee::payout);
    throw_unless(err::invalid_parameters, amount > 0);

    total_tokens += amount;
    pay(owner, amount, payout::other, 0);
}

;; Closes a payout whose second hop failed. The governor must first find, on chain, the bounced
;; receive_tokens at the recipient's wallet and our wallet's on_bounce after it: settling a payout that
;; arrived but whose confirmation was dropped would pay twice.
() settle_failed_payout(slice src, slice s) impure inline {
    s~load_uint(64);
    int target = s~load_uint(64);
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));

    ( slice record, int found? ) = payouts~udict_delete_get?(64, target);
    throw_unless(err::unknown_query, found?);
    restore_payout(record);
}

() set_burn_share(slice src, slice s) impure inline {
    s~load_uint(64);
    int new_b_share = s~load_uint(16);
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));
    throw_unless(err::invalid_parameters, new_b_share <= max_burn_share);

    ( _, int min_pot, int burn_batch, int min_deposit ) = unpack_params();
    pack_params(new_b_share, min_pot, burn_batch, min_deposit);
}

() set_min_pot(slice src, slice s) impure inline {
    s~load_uint(64);
    int new_min_pot = s~load_coins();
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));

    ( int b_share, _, int burn_batch, int min_deposit ) = unpack_params();
    pack_params(b_share, new_min_pot, burn_batch, min_deposit);
}

() set_burn_batch(slice src, slice s) impure inline {
    s~load_uint(64);
    int new_burn_batch = s~load_coins();
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));

    ( int b_share, int min_pot, _, int min_deposit ) = unpack_params();
    pack_params(b_share, min_pot, new_burn_batch, min_deposit);
}

() set_min_deposit(slice src, slice s) impure inline {
    s~load_uint(64);
    int new_min_deposit = s~load_coins();
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));
    ;; at least 1, so that no booking ever deploys an empty range
    throw_unless(err::invalid_parameters, new_min_deposit >= 1);

    ( int b_share, int min_pot, int burn_batch, _ ) = unpack_params();
    pack_params(b_share, min_pot, burn_batch, new_min_deposit);
}

() set_halter(slice src, slice s) impure inline {
    s~load_uint(64);
    slice new_halter = s~load_msg_addr();
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));

    ( slice burner, slice governor, _ ) = unpack_roles();
    set_address_ref(3, begin_cell().store_slice(burner).store_slice(governor).store_slice(new_halter).end_cell());
}

;; The halter can only stop; resuming is the governor's.
() set_halted(slice src, slice s) impure inline {
    s~load_uint(64);
    int new_halted? = s~load_int(1);
    s.end_parse();

    ( _, slice governor, slice halter ) = unpack_roles();
    int governor? = equal_slice_bits(src, governor);
    int halter? = equal_slice_bits(src, halter);
    throw_unless(err::access_denied, governor? | (halter? & new_halted?));

    halted? = new_halted?;
}

() clear_falling(slice src, slice s) impure inline {
    s~load_uint(64);
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));

    falling? = false;
}

;; The node float: each booking's node share, less the nodes it has opened so far. It follows from n
;; alone: bookings 0 .. n-1 have opened ceil(n / 64^ℓ) nodes at each level ℓ. Below 0 while the first
;; nodes, paid from the deploy float, are not yet earned back.
int node_float() inline {
    int float = next_booking * fee::node_share;
    int shift = tree::bits;
    repeat (tree::levels) {
        float -= ((next_booking + (1 << shift) - 1) >> shift) * fee::node_open;
        shift += tree::bits;
    }
    return float;
}

;; Everything above the storage float and the node float. GRAM some chain in flight still needs then
;; comes out of the storage float, which is sized for it.
() withdraw_surplus(slice src, slice s) impure inline {
    int query_id = s~load_uint(64);
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, governor()));

    raw_reserve(fee::jackpot_storage + max(node_float(), 0), reserve::at_most);
    builder excess = begin_cell()
        .store_uint(op::gas_excess, 32)
        .store_uint(query_id, 64);
    send_msg(false, governor().to_builder(), null(), excess, 0, send::unreserved_balance + send::ignore_errors);
}

;;
;; routing
;;

() route_internal_message(int flags, slice src, slice s) impure inline {
    if flags & 1 {
        return on_bounce(src, s);
    }

    if s.slice_bits() < 32 {
        return (); ;; plain GRAM: a top-up
    }

    int op = s~load_uint(32);

    if op == op::transfer_notification {
        return transfer_notification(src, s);
    }
    if op == op::take_current_quote {
        return take_current_quote(src, s);
    }
    if op == op::gas_excess {
        return gas_excess(src, s);
    }
    if op == op::hit {
        return hit(src, s);
    }
    if op == op::miss {
        return miss(src, s);
    }
    if op == op::lost {
        return lost(src, s);
    }
    if op == op::deposit {
        return deposit(src, s);
    }
    if op == op::withdrawn {
        return withdrawn(src, s);
    }
    if op == op::start_draw {
        return start_draw(src, s);
    }
    if op == op::submit_randomness {
        return submit_randomness(src, s);
    }
    if op == op::locate {
        return locate(src, s);
    }
    if op == op::requote {
        return requote(src, s);
    }
    if op == op::expire {
        return expire(src, s);
    }
    if op == op::claim {
        return claim(src, s);
    }
    if op == op::top_up {
        return ();
    }
    if op == op::upgrade_code {
        return upgrade_code(src, s);
    }
    if op == op::set_hipo_wallet {
        return set_hipo_wallet(src, s);
    }
    if op == op::resolve_pending {
        return resolve_pending(src, s);
    }
    if op == op::return_tokens {
        return return_tokens(src, s);
    }
    if op == op::settle_failed_payout {
        return settle_failed_payout(src, s);
    }
    if op == op::set_burn_share {
        return set_burn_share(src, s);
    }
    if op == op::set_min_pot {
        return set_min_pot(src, s);
    }
    if op == op::set_burn_batch {
        return set_burn_batch(src, s);
    }
    if op == op::set_min_deposit {
        return set_min_deposit(src, s);
    }
    if op == op::set_halter {
        return set_halter(src, s);
    }
    if op == op::set_halted {
        return set_halted(src, s);
    }
    if op == op::clear_falling {
        return clear_falling(src, s);
    }
    if op == op::withdraw_surplus {
        return withdraw_surplus(src, s);
    }

    throw(err::invalid_op);
}

;; The deploy data (version 0) is checked once, on the first message: the same bounds as the setters. The
;; Jackpot then asks the treasury for its first rate, which GRAM deposits need.
() deploy() impure inline {
    ( int b_share, _, _, int min_deposit ) = unpack_params();
    throw_unless(err::invalid_parameters, (b_share <= max_burn_share) & (min_deposit >= 1));
    request_quote(new_query_id(), begin_cell()
        .store_uint(now(), 32)
        .store_uint(quote::refresh, 2));
}

() recv_internal(cell in_msg_full, slice s) impure {
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    slice src = cs~load_msg_addr();

    int version = get_data().begin_parse().preload_uint(8);
    ;; a top-up, which every level-1 node sends back after an update, touches nothing
    if (version == storage_version) & (~ (flags & 1)) {
        if s.slice_bits() < 32 {
            return ();
        }
        if s.preload_uint(32) == op::top_up {
            return ();
        }
    }

    load_data();
    if version == 0 {
        deploy();
    }
    route_internal_message(flags, src, s);
    save_data();
}

;;
;; get methods
;;

int get_storage_version() method_id {
    return get_data().begin_parse().preload_uint(8);
}

var get_jackpot_state() method_id {
    load_data();
    ( int b_share, int min_pot, int burn_batch, int min_deposit ) = unpack_params();
    ( int last_round_since, int last_coins, int last_tokens ) = unpack_last_start();
    return
        ( total_tokens
        , in_flight
        , set_aside
        , principal
        , next_booking
        , k_next
        , l_lo
        , l_hi
        , carried
        , quote_coins
        , quote_tokens
        , halted?
        , falling?
        , b_share
        , min_pot
        , burn_batch
        , burn_owed
        , min_deposit
        , last_round_since
        , last_coins
        , last_tokens
        , node_float()
        );
}

var get_draw_state() method_id {
    load_data();
    ( int query_id, int drand_round, int randomness_time, int p0, int p1, int p2 ) = unpack_misc();
    return
        ( draw_state
        , draw_id
        , query_id
        , draw_e
        , draw_l
        , drand_round
        , seed
        , randomness_time
        , p0
        , p1
        , p2
        , slots & 7
        , attempt(0)
        , attempt(1)
        , attempt(2)
        );
}

;; The position the open slot `slot` tries next, or -1 when there is none.
int get_position(int slot) method_id {
    load_data();
    if (draw_state != draw::resolving) | (slot >= 3) {
        return -1;
    }
    ifnot slot_open?(slot) {
        return -1;
    }
    return position(slot, attempt(slot));
}

;; The surcharge a withdrawal of x from range b owes now, on top of the withdraw fee: 0 outside the draw
;; window or for a range the running draw cannot pick.
int get_surcharge(int b, int x) method_id {
    load_data();
    if in_window?() & (b < draw_e) {
        return surcharge(x);
    }
    return 0;
}

(int, int) get_quote() method_id {
    load_data();
    return ( quote_coins, quote_tokens );
}

slice get_range_address(int b) method_id {
    load_data();
    return create_address(chain::base, range_hash(b)).end_cell().begin_parse();
}

slice get_node_address(int level, int index) method_id {
    load_data();
    return create_address(chain::base, node_hash(level, index)).end_cell().begin_parse();
}

var get_addresses() method_id {
    load_data();
    ( slice parent, cell wallet_code ) = unpack_hipo();
    ( slice burner, slice governor, slice halter ) = unpack_roles();
    return ( treasury(), parent, wallet, burner, governor, halter, wallet_code, range_code(), node_code() );
}

var get_books() method_id {
    load_data();
    return ( pending, quotes, payouts, claimable );
}

;; ( prize, other ) claimable by `owner`
(int, int) get_claimable(slice owner) method_id {
    load_data();
    ( slice v, int found? ) = claimable.udict_get?(256, slice_hash(owner));
    ifnot found? {
        return ( 0, 0 );
    }
    v~load_msg_addr();
    return ( v~load_coins(), v~load_coins() );
}

var get_jackpot_fees() method_id {
    return
        ( fee::deposit
        , fee::hgram_deposit
        , fee::withdraw
        , fee::start_draw
        , fee::submit_randomness
        , fee::locate
        , fee::requote
        , fee::expire
        , fee::claim
        );
}
