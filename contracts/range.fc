;; A range: one booking, of `length` tickets (nano-GRAM of principal), of which the first `live` can still
;; win. One contract per booking keeps the Jackpot's own storage bounded however many players there are.
;;
;; The address follows from (jackpot, b) alone, b the booking index. The owner, the length and the address
;; of its level-1 node arrive in a one-time setup that only the Jackpot can send. The code is fixed: ranges
;; cannot be upgraded, and never delete themselves, because a withdrawn range must keep answering draws.

#include "imports/utils.fc";

global slice jackpot;
global int b;
global int set_up?;
global int node_hash;   ;; the address hash of node(1, floor(b / 64)), the only sender of check
global slice owner;
global int length;
global int live;

() load_data() impure inline {
    slice ds = get_data().begin_parse();
    jackpot = ds~load_msg_addr();
    b = ds~load_uint(32);
    set_up? = ds.slice_bits() > 0;
    if set_up? {
        node_hash = ds~load_uint(256);
        slice booking = ds~load_ref().begin_parse();
        owner = booking~load_msg_addr();
        length = booking~load_coins();
        live = booking~load_coins();
        booking.end_parse();
    } else {
        node_hash = 0;
        owner = null();
        length = 0;
        live = 0;
    }
    ds.end_parse();
}

() save_data() impure inline {
    builder data = begin_cell()
        .store_slice(jackpot)
        .store_uint(b, 32);
    if set_up? {
        ;; the booking in a ref of its own, so that the cell never overflows at any length
        cell booking = begin_cell()
            .store_slice(owner)
            .store_coins(length)
            .store_coins(live)
            .end_cell();
        data = data
            .store_uint(node_hash, 256)
            .store_ref(booking);
    }
    data.end_cell().set_data();
}

() range_setup(slice src, slice s) impure inline {
    s~load_uint(64);
    int new_length = s~load_coins();
    slice new_owner = s~load_msg_addr();
    int new_node_hash = s~load_uint(256);
    s.end_parse();

    throw_unless(err::access_denied, equal_slice_bits(src, jackpot));
    throw_if(err::already_set_up, set_up?);

    ;; what the setup carried above its gas stays here as the storage reserve
    set_up? = true;
    node_hash = new_node_hash;
    owner = new_owner;
    length = new_length;
    live = new_length;
}

;; x = 0 withdraws the whole live part. A partial withdrawal takes at least 1 GRAM of principal, so that
;; the hGRAM paid for it is never 0.
() withdraw(slice src, slice s) impure inline {
    int query_id = s~load_uint(64);
    int x = s~load_coins();
    s.end_parse();

    throw_unless(err::not_set_up, set_up?);
    throw_unless(err::access_denied, equal_slice_bits(src, owner));
    int sent = get_incoming_value().pair_first();
    throw_unless(err::insufficient_fee, sent >= fee::withdraw);

    ifnot x {
        x = live;
    }
    throw_unless(err::insufficient_funds, (x > 0) & (x <= live));
    throw_unless(err::invalid_parameters, (x == live) | (x >= min_partial_withdrawal));

    live -= x;

    ;; x first, so that a bounce carries it back. The Jackpot throws, and so bounces this, when the
    ;; withdrawal falls in a draw's window and what the owner sent lacks the surcharge.
    builder body = begin_cell()
        .store_uint(op::withdrawn, 32)
        .store_uint(query_id, 64)
        .store_coins(x)
        .store_uint(b, 32)
        .store_slice(owner)
        .store_coins(sent);
    send_msg(true, jackpot.to_builder(), null(), body, 0, send::remaining_value);
}

;; Asked by its level-1 node whether the ticket at `offset` is still live: it is if offset < live.
() check(slice src, slice s) impure inline {
    int query_id = s~load_uint(64);
    int draw = s~load_uint(32);
    int slot = s~load_uint(8);
    int j = s~load_uint(8);
    int k = s~load_uint(128);
    int offset = s~load_uint(128);
    s.end_parse();

    throw_unless(err::not_set_up, set_up?);
    throw_unless(err::access_denied, is_base_addr?(src, node_hash));

    int hit? = offset < live;
    builder body = begin_cell()
        .store_uint(hit? ? op::hit : op::miss, 32)
        .store_uint(query_id, 64)
        .store_uint(draw, 32)
        .store_uint(slot, 8)
        .store_uint(j, 8)
        .store_uint(k, 128)
        .store_uint(b, 32);
    if hit? {
        body = body.store_slice(owner);
    }
    send_msg(false, jackpot.to_builder(), null(), body, 0, send::remaining_value);
}

;; The Jackpot refused the withdrawal (in a draw's window without its surcharge): the tickets are live
;; again, and what the refusal sent back goes to the owner, less this handler's gas.
() on_bounce(slice s) impure inline {
    s~skip_bits(32); ;; 0xffffffff
    int op = s~load_uint(32);
    int query_id = s~load_uint(64);
    if op != op::withdrawn {
        return ();
    }
    live += s~load_coins();

    int value = get_incoming_value().pair_first() - fee::range_bounce;
    if value > 0 {
        builder excess = begin_cell()
            .store_uint(op::gas_excess, 32)
            .store_uint(query_id, 64);
        send_msg(false, owner.to_builder(), null(), excess, value, send::ignore_errors);
    }
}

() recv_internal(cell in_msg_full, slice s) impure {
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    slice src = cs~load_msg_addr();

    if flags & 1 {
        load_data();
        if set_up? & equal_slice_bits(src, jackpot) {
            on_bounce(s);
        }
        return save_data();
    }

    if s.slice_bits() < 32 {
        return (); ;; plain GRAM: anyone may top up the storage reserve
    }

    int op = s~load_uint(32);
    if op == op::top_up {
        return ();
    }

    load_data();
    if op == op::range_setup {
        range_setup(src, s);
        return save_data();
    }
    if op == op::withdraw {
        withdraw(src, s);
        return save_data();
    }
    if op == op::check {
        return check(src, s);
    }

    throw(err::invalid_op);
}

;;
;; get methods
;;

var get_range_data() method_id {
    load_data();
    return ( jackpot, b, set_up?, owner, length, live, node_hash );
}
